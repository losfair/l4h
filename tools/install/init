#!/bin/sh
# Distribution-independent initramfs for an existing, plain ext4/XFS root.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
fail() {
    echo "l4h: $*; rebooting in 20 seconds (a one-time trial returns to native Linux)" >&2
    sleep 20
    # reboot(2) restarts only dom0. Reset the host: the trial's one-time
    # selection (BootNext, or GRUB's next_entry) is consumed, so the machine
    # returns to native Linux.
    l4hctl host-reboot || echo 'l4h: automatic host reset failed; reset the machine manually' >&2
    while :; do sleep 60; done
}
mount -t proc proc /proc || fail 'cannot mount proc'
mount -t sysfs sysfs /sys || fail 'cannot mount sysfs'
mount -t devtmpfs devtmpfs /dev || fail 'cannot mount devtmpfs'
mkdir -p /newroot /run
mount -t tmpfs -o mode=0755 tmpfs /run || fail 'cannot mount run'
root='' rootfstype='' networks=''
# The kernel command line is a list of whitespace-separated words.
# shellcheck disable=SC2013
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=UUID=*) root=${arg#root=} ;;
        rootfstype=*) rootfstype=${arg#rootfstype=} ;;
        l4h.net=*) networks="$networks ${arg#l4h.net=}" ;;
    esac
done
case "$rootfstype" in ext4|xfs) ;; *) fail 'unsupported root filesystem' ;; esac
[ -n "$root" ] || fail 'missing root UUID'
# Disk enumeration changes under L4H. BusyBox mount resolves filesystem UUIDs.
tries=0
until mount -t "$rootfstype" -o ro "$root" /newroot; do
    tries=$((tries + 1))
    [ "$tries" -lt 30 ] || fail "cannot mount $root"
    sleep 1
done
[ -x /newroot/sbin/init ] || fail 'root has no /sbin/init'
# NIC firmware from the host's own linux-firmware (l4h carries none):
# drivers that ask for it restart with it.  Not fatal: they run without,
# as Linux's do.  The host lists none unless it confines NIC drivers.
for name in $(l4hctl firmware wanted 2>/dev/null); do
    loaded=''
    for dir in /newroot/usr/lib/firmware /newroot/lib/firmware; do
        file=$dir/$name
        if [ -f "$file" ]; then
            l4hctl firmware load "$name" "$file" >/dev/null && loaded=1
        elif [ -f "$file.xz" ]; then
            xzcat "$file.xz" > /run/l4h-firmware && l4hctl firmware load "$name" /run/l4h-firmware >/dev/null && loaded=1
        elif [ -f "$file.zst" ]; then
            chroot /newroot zstd -dcq -- "${file#/newroot}.zst" > /run/l4h-firmware &&
                l4hctl firmware load "$name" /run/l4h-firmware >/dev/null && loaded=1
        else
            continue
        fi
        break
    done
    rm -f /run/l4h-firmware
    [ -n "$loaded" ] || echo "l4h: NIC firmware $name not loaded; its driver runs without" >&2
done
# Expose only the running kernel's modules over the existing module tree.
# /lib may be a symlink to /usr/lib; the installer checks that /usr is on root.
mount -t erofs -o ro /dev/l4hkmod /newroot/lib/modules || fail 'cannot mount kernel modules'
# Match each dom0 vNIC by the physical uplink's MAC, not enumeration order.
# Move all of them to unused temporary names first, so eth0/eth1 swaps work.
[ -n "$networks" ] || fail 'missing uplink interface mappings'
name_in_use() {
    [ -e "/sys/class/net/$1" ] && return 0
    for candidate in $networks; do
        [ "${candidate#*,}" = "$1" ] && return 0
    done
    return 1
}
renames='' index=0 count=0
for mapping in $networks; do
    count=$((count + 1))
    [ "$count" -le 2 ] || fail 'too many uplink interface mappings'
    mac=${mapping%,*} ifname=${mapping#*,}
    case "$ifname" in
        ''|lo|*[!a-zA-Z0-9_-]*) fail 'invalid uplink interface name' ;;
    esac
    [ "${#ifname}" -le 15 ] || fail 'uplink interface name too long'
    printf '%s\n' "$mac" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || fail 'invalid uplink MAC'
    device=''
    for net in /sys/class/net/*; do
        [ "$(cat "$net/address")" = "$mac" ] || continue
        [ -z "$device" ] || fail "ambiguous uplink MAC $mac"
        device=${net##*/}
    done
    [ -n "$device" ] || fail "missing dom0 NIC for uplink MAC $mac"
    temporary=l4h-tmp$index
    while name_in_use "$temporary"; do
        index=$((index + 1))
        temporary=l4h-tmp$index
    done
    ip link set "$device" name "$temporary" || fail 'cannot stage interface rename'
    renames="$renames $temporary,$mapping"
done
# Preserve the names through systemd-udevd, without modifying native Linux.
mkdir -p /run/systemd/network || fail 'cannot create network configuration directory'
for rename in $renames; do
    temporary=${rename%%,*} mapping=${rename#*,}
    mac=${mapping%,*} ifname=${mapping#*,}
    ip link set "$temporary" name "$ifname" || fail "cannot preserve interface name $ifname"
    cat > "/run/systemd/network/00-l4h-$temporary.link" <<LINK || fail 'cannot preserve network configuration'
[Match]
MACAddress=$mac
[Link]
NamePolicy=
Name=$ifname
LINK
done
for fs in dev proc sys run; do
    mount --move "/$fs" "/newroot/$fs" || fail "cannot move $fs"
done
exec switch_root /newroot /sbin/init
