diff --git a/crates/sel4-kernel-loader/asm/aarch64/head.S b/crates/sel4-kernel-loader/asm/aarch64/head.S
index 6fe8f6d1..357c4396 100644
--- a/crates/sel4-kernel-loader/asm/aarch64/head.S
+++ b/crates/sel4-kernel-loader/asm/aarch64/head.S
@@ -61,6 +61,13 @@ BEGIN_LOCAL_FUNC(init_core_state)
 
     disable_mmu sctlr_el2, x8
 
+    /* EL2 without VHE (HCR_EL2.E2H clear), which the EL2 translation set
+     * up below and enter_kernel_el1 assume: firmware may leave E2H set.
+     * Nothing is trapped or routed to EL2 yet. */
+    mov     x8, #(1 << 31)
+    msr     hcr_el2, x8
+    isb
+
     bl      invalidate_icache
 
     /*
diff --git a/crates/sel4-kernel-loader/asm/aarch64/tail.S b/crates/sel4-kernel-loader/asm/aarch64/tail.S
index b56f077c..1797f1ae 100644
--- a/crates/sel4-kernel-loader/asm/aarch64/tail.S
+++ b/crates/sel4-kernel-loader/asm/aarch64/tail.S
@@ -46,3 +46,93 @@ BEGIN_FUNC(switch_translation_tables_el2)
     ret
 
 END_FUNC(switch_translation_tables_el2)
+
+/*
+ * Enter a kernel built for EL1 (no ARM_HYPERVISOR_SUPPORT) from EL2:
+ * x0-x5 kernel arguments, x6 kernel entry, x7 kernel boot level 0 table,
+ * which maps both the identity range and (in its upper half) the kernel
+ * window, so it serves as TTBR0_EL1 and TTBR1_EL1.  The caller has cleaned
+ * the data cache.
+ */
+BEGIN_FUNC(enter_kernel_el1)
+    ldr     x8, =MAIR(0x00, MT_DEVICE_nGnRnE) | \
+                 MAIR(0x04, MT_DEVICE_nGnRE) | \
+                 MAIR(0x0c, MT_DEVICE_GRE) | \
+                 MAIR(0x44, MT_NORMAL_NC) | \
+                 MAIR(0xff, MT_NORMAL) | \
+                 MAIR(0xaa, MT_NORMAL_WT)
+    msr     mair_el1, x8
+    /* 48-bit VA in both halves, 4 KiB granules, write-back inner shareable
+     * walks, IPS = the CPU's physical address range. */
+    ldr     x8, =(16 | (1 << 8) | (1 << 10) | (3 << 12) | (0 << 14) | \
+                  (16 << 16) | (1 << 24) | (1 << 26) | (3 << 28) | (2 << 30))
+    mrs     x9, id_aa64mmfr0_el1
+    and     x9, x9, #7
+    orr     x8, x8, x9, lsl #32
+    /* seL4 tags address spaces with 16-bit ASIDs: use them (TCR_EL1.AS)
+     * when the CPU has them (ID_AA64MMFR0_EL1.ASIDBits == 2), or the
+     * hardware ignores their upper 8 bits and address spaces share TLB
+     * entries.  seL4 refuses to boot without them. */
+    mrs     x9, id_aa64mmfr0_el1
+    ubfx    x9, x9, #4, #4
+    cmp     x9, #2
+    b.ne    9f
+    orr     x8, x8, #(1 << 36)
+9:
+    msr     tcr_el1, x8
+    msr     ttbr0_el1, x7
+    msr     ttbr1_el1, x7
+    /* EL1 is AArch64; no stage 2, no traps of timers, FP or system
+     * registers. */
+    mov     x8, #(1 << 31)
+    msr     hcr_el2, x8
+    mov     x8, #3
+    msr     cnthctl_el2, x8
+    msr     cntvoff_el2, xzr
+    mov     x8, #0x33ff
+    msr     cptr_el2, x8
+    msr     hstr_el2, xzr
+    /* VMID 0 on every core: while EL2 is enabled, EL1&0 TLB entries are
+     * tagged with VTTBR_EL2.VMID even without stage 2, and the kernel's
+     * broadcast TLB invalidations reach only the issuing core's VMID.
+     * VTTBR_EL2 resets to an UNKNOWN value. */
+    msr     vttbr_el2, xzr
+    /* No debug or PMU traps (MDCR_EL2 resets to UNKNOWN values), and every
+     * PMU counter for EL1: HPMN = PMCR_EL0.N, if there is a PMUv3. */
+    mov     x8, xzr
+    mrs     x9, id_aa64dfr0_el1
+    ubfx    x9, x9, #8, #4
+    cbz     x9, 6f
+    cmp     x9, #0xf
+    b.eq    6f
+    mrs     x8, pmcr_el0
+    ubfx    x8, x8, #11, #5
+6:
+    msr     mdcr_el2, x8
+    /* With a GICv3 CPU interface, let EL1 use its system registers
+     * (ICC_SRE_EL2.SRE and Enable), and leave the virtual interface off. */
+    mrs     x9, id_aa64pfr0_el1
+    ubfx    x9, x9, #24, #4
+    cbz     x9, 7f
+    mrs     x9, S3_4_C12_C9_5
+    orr     x9, x9, #0x1
+    orr     x9, x9, #0x8
+    msr     S3_4_C12_C9_5, x9
+    isb
+    mrs     x9, S3_4_C12_C9_5
+    tbz     x9, #0, 7f
+    msr     S3_4_C12_C11_0, xzr
+7:
+    /* SCTLR_EL1: RES1 bits, MMU, data and instruction caches. */
+    ldr     x8, =0x30d01805
+    msr     sctlr_el1, x8
+    isb
+    tlbi    vmalle1is
+    dsb     ish
+    isb
+    /* EL1h with interrupts masked. */
+    mov     x8, #0x3c5
+    msr     spsr_el2, x8
+    msr     elr_el2, x6
+    eret
+END_FUNC(enter_kernel_el1)
diff --git a/crates/sel4-kernel-loader/src/arch/arm/arch/aarch64/mod.rs b/crates/sel4-kernel-loader/src/arch/arm/arch/aarch64/mod.rs
index dd11fca6..67e1bb2a 100644
--- a/crates/sel4-kernel-loader/src/arch/arm/arch/aarch64/mod.rs
+++ b/crates/sel4-kernel-loader/src/arch/arm/arch/aarch64/mod.rs
@@ -18,6 +18,17 @@ pub(crate) mod exception_handler;
 
 unsafe extern "C" {
     fn switch_translation_tables_el2();
+    fn clean_and_invalideate_dcache();
+    fn enter_kernel_el1(
+        ui_p_reg_start: usize,
+        ui_p_reg_end: usize,
+        pv_offset: usize,
+        v_entry: usize,
+        dtb_addr_p: usize,
+        dtb_size: usize,
+        kernel_entry: usize,
+        level_0_table: usize,
+    ) -> !;
 }
 
 #[unsafe(no_mangle)]
@@ -63,6 +74,28 @@ impl Arch for ArchImpl {
             set_tpidr(core_id);
         }
 
+        // A kernel built for EL1: drop from EL2 into the EL1 translation
+        // regime (no hardware virtualization is used).
+        if !sel4_config::sel4_cfg_bool!(ARM_HYPERVISOR_SUPPORT) {
+            // enter_kernel_el1 writes EL1 registers from EL2: with
+            // HCR_EL2.E2H set (RES1 on CPUs without FEAT_E2H0) they would
+            // be redirected to EL2's own.
+            let hcr: usize;
+            unsafe { asm!("mrs {}, hcr_el2", out(reg) hcr) };
+            assert!(hcr & (1 << 34) == 0, "HCR_EL2.E2H cannot be cleared: VHE-only CPUs are not supported");
+            unsafe { clean_and_invalideate_dcache() };
+            unsafe { enter_kernel_el1(
+                payload_info.user_image.ui_p_reg_start.to_usize(),
+                payload_info.user_image.ui_p_reg_end.to_usize(),
+                payload_info.user_image.pv_offset.to_usize(),
+                payload_info.user_image.v_entry.to_usize(),
+                dtb_addr_p,
+                dtb_size,
+                payload_info.kernel_entry.to_usize(),
+                *crate::this_image::kernel_boot_level_0_table.get(),
+            ) };
+        }
+
         unsafe {
             switch_translation_tables_el2();
         }
