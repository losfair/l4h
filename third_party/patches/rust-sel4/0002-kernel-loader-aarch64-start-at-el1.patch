--- a/crates/sel4-kernel-loader/asm/aarch64/head.S
+++ b/crates/sel4-kernel-loader/asm/aarch64/head.S
@@ -59,6 +59,10 @@ BEGIN_LOCAL_FUNC(init_core_state)
 
     bl      clean_and_invalideate_dcache
 
+    mrs     x8, CurrentEL
+    cmp     x8, #4
+    b.eq    init_core_state_el1
+
     disable_mmu sctlr_el2, x8
 
     /* EL2 without VHE (HCR_EL2.E2H clear), which the EL2 translation set
@@ -111,6 +115,52 @@ BEGIN_LOCAL_FUNC(init_core_state)
     dsb     ish
     isb
 
+    ldp     x29, x30, [sp], #16
+    ret
+/* EL1 entry, including secondary CPUs started through PSCI at EL1. */
+init_core_state_el1:
+    mov     x8, #(3 << 20)
+    msr     cpacr_el1, x8
+    isb
+    disable_mmu sctlr_el1, x8
+    bl      invalidate_icache
+    ldr     x5, =MAIR(0x00, MT_DEVICE_nGnRnE) | \
+                 MAIR(0x04, MT_DEVICE_nGnRE) | \
+                 MAIR(0x0c, MT_DEVICE_GRE) | \
+                 MAIR(0x44, MT_NORMAL_NC) | \
+                 MAIR(0xff, MT_NORMAL) | \
+                 MAIR(0xaa, MT_NORMAL_WT)
+    msr     mair_el1, x5
+    ldr     x8, =(16 | (1 << 8) | (1 << 10) | (3 << 12) | \
+                  (16 << 16) | (1 << 24) | (1 << 26) | (3 << 28) | (2 << 30))
+    mrs     x9, id_aa64mmfr0_el1
+    and     x9, x9, #7
+    orr     x8, x8, x9, lsl #32
+    /* seL4 tags address spaces with 16-bit ASIDs: use them (TCR_EL1.AS)
+     * when the CPU has them (ID_AA64MMFR0_EL1.ASIDBits == 2), or the
+     * hardware ignores their upper 8 bits and address spaces share TLB
+     * entries.  seL4 refuses to boot without them. */
+    mrs     x9, id_aa64mmfr0_el1
+    ubfx    x9, x9, #4, #4
+    cmp     x9, #2
+    b.ne    9f
+    orr     x8, x8, #(1 << 36)
+9:
+    msr     tcr_el1, x8
+    ldr     x8, =loader_level_0_table
+    ldr     x8, [x8]
+    msr     ttbr0_el1, x8
+    msr     ttbr1_el1, x8
+    isb
+    tlbi    vmalle1is
+    dsb     ish
+    isb
+    enable_mmu sctlr_el1, x8
+    adrp    x8, arm_vector_table
+    msr     vbar_el1, x8
+    ic      ialluis
+    dsb     ish
+    isb
     ldp     x29, x30, [sp], #16
     ret
 END_FUNC(init_core_state)
