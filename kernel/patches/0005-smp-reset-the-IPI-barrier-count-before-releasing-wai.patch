From 6aa0af4bf3e1c880ef8fdb9a6a55f1ec12c57efd Mon Sep 17 00:00:00 2001
From: l4h <z@univalence.me>
Date: Sat, 17 Oct 2026 14:11:59 -0700
Subject: [PATCH] smp: reset the IPI barrier count before releasing waiters

ipi_wait() resets the arrival counter and bumps globalsense with plain
stores followed by a release fence.  Nothing orders the two stores with
respect to each other, and GCC emits the globalsense increment first.
Once globalsense changes, the initiator may start the next remote call,
whose participants increment the counter before the delayed reset of the
previous round lands; the reset discards their arrivals and every core
then spins in ipi_wait() forever.

Reset the counter first and publish the new globalsense with a release
store (and read it with acquire loads).
---
 src/smp/ipi.c | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/src/smp/ipi.c b/src/smp/ipi.c
index b79610e79..538f91323 100644
--- a/src/smp/ipi.c
+++ b/src/smp/ipi.c
@@ -83,18 +83,22 @@ void ipi_wait(void)
 {
     ipi_state_t *ipi = &big_kernel_lock.ipi;
     word_t cores = ipi->totalCoreBarrier;
-    word_t localsense = ipi->globalsense;
+    word_t localsense = __atomic_load_n(&ipi->globalsense, __ATOMIC_ACQUIRE);
     word_t *count = &ipi->count;
 
     if (__atomic_fetch_add(count, 1, __ATOMIC_ACQ_REL) == cores) {
-        *count = 0;
-        ipi->globalsense++;
-        __atomic_thread_fence(__ATOMIC_RELEASE);
+        /* The counter must be reset before the waiters are released:
+         * as soon as globalsense changes the initiator may start the next
+         * remote call, whose participants increment the counter again.
+         * With plain stores the compiler is free to (and does) emit the
+         * globalsense update first, after which this reset can wipe out
+         * arrivals of the next call and deadlock all cores in ipi_wait. */
+        __atomic_store_n(count, 0, __ATOMIC_RELAXED);
+        __atomic_store_n(&ipi->globalsense, localsense + 1, __ATOMIC_RELEASE);
     }
     /* Check globalsense instead of count to protect against a race where
      * a new IPI started before this core saw that the old one finished. */
-    while (localsense == ipi->globalsense) {
-        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    while (localsense == __atomic_load_n(&ipi->globalsense, __ATOMIC_ACQUIRE)) {
         arch_pause();
     }
 }
