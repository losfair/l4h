@@ -691,6 +692,23 @@ static BOOT_CODE bool_t try_boot_sys_mbi2(
         tag = (multiboot2_tag_t const *)((word_t)tag + ROUND_UP(tag->size, 3));
     }
 
+#ifdef CONFIG_PRINTING
+    /* After the memory map, which may come later: the framebuffer must not
+     * be memory that the kernel or user level is given, nor low memory,
+     * which the memory regions leave out and which holds the APs' boot
+     * code. */
+    if (cmdline_opt.fb_console && boot_state.fb_info.addr != 0) {
+        multiboot2_fb_t const *fb = &boot_state.fb_info;
+        if (fb->addr >= HIGHMEM_PADDR &&
+            fbcon_init(fb->addr, fb->pitch, fb->width, fb->height, fb->bpp, fb->type,
+                       boot_state.mem_p_regs.list, boot_state.mem_p_regs.count)) {
+            printf("Boot config: console copied to the framebuffer\n");
+        } else {
+            printf("Boot config: framebuffer not usable as a console\n");
+        }
+    }
+#endif
+
     printf("Detected %d boot module(s):\n", mod_count);
 
     if (mod_count < 1) {
