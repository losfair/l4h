 include/plat/pc99/plat/machine/io.h    |   4 +
 src/arch/x86/kernel/boot_sys.c         |  18 +++
 src/arch/x86/kernel/cmdline.c          |   6 +
 src/plat/pc99/machine/io.c             | 180 +++++++++++++++++++++++++
 5 files changed, 211 insertions(+)

