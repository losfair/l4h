+
+static struct {
+    uint32_t *base;
+    word_t pitch, cols, rows, top, row, col;
+} fbcon;
+
+/* Multiboot2 framebuffer type: direct RGB colour */
+#define FB_TYPE_RGB 1
+
+BOOT_CODE bool_t fbcon_init(uint64_t paddr, uint32_t pitch, uint32_t width, uint32_t height, uint8_t bpp,
+                            uint8_t type, p_region_t const *ram, word_t ram_count)
+{
+    /* The boot page tables and the kernel window both map the low 4 GiB at
+     * PPTR_BASE. */
+    if (type != FB_TYPE_RGB || bpp != 32 || width < 640 || height < 400 ||
+        pitch < (uint64_t)width * 4 || paddr >= 0x100000000ull ||
+        (uint64_t)pitch * height > 0x100000000ull - paddr) {
+        return false;
+    }
+    /* Drawing into RAM would corrupt the kernel, the root task, or memory
+     * later given to user level. */
+    uint64_t end = paddr + (uint64_t)pitch * height;
+    for (word_t i = 0; i < ram_count; i++) {
+        if (paddr < ram[i].end && ram[i].start < end) {
+            return false;
+        }
+    }
+    fbcon.base = (uint32_t *)(PPTR_BASE + (word_t)paddr);
+    fbcon.pitch = pitch;
+    fbcon.cols = width / 8;
+    fbcon.top = height / 2 / 16;
+    fbcon.rows = height / 16 - fbcon.top;
+    fbcon.row = 0;
+    fbcon.col = 0;
+    return true;
+}
+
+static void fbcon_glyph(word_t row, word_t col, unsigned char c)
+{
+    /* Prints from cores that do not hold the kernel lock (panics) can race
+     * on the cursor: never draw outside the console area. */
+    if (row >= fbcon.rows || col >= fbcon.cols) {
+        return;
+    }
+    const uint8_t *g = c >= 0x20 && c < 0x7f ? fbcon_font[c - 0x20] : fbcon_font[0];
+    for (word_t y = 0; y < 16; y++) {
+        volatile uint32_t *p = (volatile uint32_t *)((word_t)fbcon.base + ((fbcon.top + row) * 16 + y) * fbcon.pitch) + col * 8;
+        for (word_t x = 0; x < 8; x++) {
+            p[x] = (g[y / 2] >> x) & 1 ? 0x00d0d0d0 : 0x00000040;
+        }
+    }
+}
+
+static void fbcon_putchar(unsigned char c)
+{
+    if (!fbcon.base) {
+        return;
+    }
+    if (c == '\r') {
+        fbcon.col = 0;
+        return;
+    }
+    if (c == '\n' || fbcon.col >= fbcon.cols) {
+        fbcon.col = 0;
+        fbcon.row = (fbcon.row + 1) % fbcon.rows;
+        /* Clear the new line and mark the one after it as the edge. */
+        for (word_t i = 0; i < fbcon.cols; i++) {
+            fbcon_glyph(fbcon.row, i, ' ');
+            fbcon_glyph((fbcon.row + 1) % fbcon.rows, i, i % 2 ? '-' : ' ');
+        }
+        if (c == '\n') {
+            return;
+        }
+    }
+    fbcon_glyph(fbcon.row, fbcon.col++, c);
+}
+
 /* there is no UART driver at drivers/serial/... for the pc99 platform, but we
  * implement parts of the API here, so we can reuse the generic code.
  */
 void uart_drv_putchar(
     unsigned char c)
 {
+    fbcon_putchar(c);
     while (x86KSdebugPort && (in8(x86KSdebugPort + 5) & 0x20) == 0);
     out8(x86KSdebugPort, c);
 }
