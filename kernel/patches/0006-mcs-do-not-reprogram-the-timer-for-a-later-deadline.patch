From 890a60da97d63c9dd333a0488971aecd4b3629e8 Mon Sep 17 00:00:00 2001
From: l4h <z@univalence.me>
Date: Sat, 17 Oct 2026 17:13:04 -0700
Subject: [PATCH 6/7] mcs: do not reprogram the timer for a later deadline

setNextInterrupt() wrote the deadline on every scheduling-context
change.  Keep the armed deadline when it is still pending and not later
than the new one: the interrupt then comes early and only causes a
reprogram.  Context switches mostly move the next interrupt later, so
this removes most timer writes, which trap when seL4 is virtualised
(IA32_TSC_DEADLINE): ~16x faster trapped syscalls under nested KVM.
---
 include/model/statedata.h |  1 +
 src/kernel/thread.c       | 10 ++++++++++
 src/model/statedata.c     |  2 ++
 src/object/interrupt.c    |  1 +
 4 files changed, 14 insertions(+)

diff --git a/include/model/statedata.h b/include/model/statedata.h
index 7b53a8d4d..d3cd5fec7 100644
--- a/include/model/statedata.h
+++ b/include/model/statedata.h
@@ -70,6 +70,7 @@ NODE_STATE_DECLARE(tcb_t *, ksTimerRoot);
 NODE_STATE_DECLARE(ticks_t, ksConsumed);
 NODE_STATE_DECLARE(ticks_t, ksCurTime);
 NODE_STATE_DECLARE(bool_t, ksReprogram);
+NODE_STATE_DECLARE(ticks_t, ksArmedDeadline);
 NODE_STATE_DECLARE(sched_context_t, *ksCurSC);
 NODE_STATE_DECLARE(sched_context_t, *ksIdleSC);
 #endif
diff --git a/src/kernel/thread.c b/src/kernel/thread.c
index f4f3af0ec..06489d57d 100644
--- a/src/kernel/thread.c
+++ b/src/kernel/thread.c
@@ -636,7 +636,17 @@ void setNextInterrupt(void)
     if (timer_head != NULL) {
         deadline = MIN(deadline, timer_head->tcbTimerDeadline);
     }
+
+    /* Keep an earlier deadline that is still pending: the interrupt then
+       comes early, which only causes a reprogram.  Most context switches
+       move the next interrupt later (budgets barely consumed), and this
+       saves the timer write, which traps when the kernel is virtualised. */
+    ticks_t armed = NODE_STATE(ksArmedDeadline);
+    if (armed > NODE_STATE(ksCurTime) && armed <= deadline) {
+        return;
+    }
     setDeadline(deadline);
+    NODE_STATE(ksArmedDeadline) = deadline;
 }
 
 void chargeBudget(ticks_t consumed, bool_t canTimeoutFault)
diff --git a/src/model/statedata.c b/src/model/statedata.c
index 8ec232be0..4a8a1c775 100644
--- a/src/model/statedata.c
+++ b/src/model/statedata.c
@@ -55,6 +55,8 @@ UP_STATE_DEFINE(tcb_t *, ksCurFPUOwner);
 UP_STATE_DEFINE(ticks_t, ksConsumed);
 /* whether we need to reprogram the timer before exiting the kernel */
 UP_STATE_DEFINE(bool_t, ksReprogram);
+/* the deadline the timer is armed with, 0 if it has fired */
+UP_STATE_DEFINE(ticks_t, ksArmedDeadline);
 /* the current kernel time (recorded on kernel entry) */
 UP_STATE_DEFINE(ticks_t, ksCurTime);
 /* current scheduling context pointer */
diff --git a/src/object/interrupt.c b/src/object/interrupt.c
index a65d5f357..bacba6cb7 100644
--- a/src/object/interrupt.c
+++ b/src/object/interrupt.c
@@ -240,6 +240,7 @@ void handleInterrupt(irq_t irq)
     case IRQTimer:
 #ifdef CONFIG_KERNEL_MCS
         ackDeadlineIRQ();
+        NODE_STATE(ksArmedDeadline) = 0;
         NODE_STATE(ksReprogram) = true;
 #else
         timerTick();
