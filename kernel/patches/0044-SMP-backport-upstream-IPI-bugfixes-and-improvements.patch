diff --git a/tools/test/smp-bkl-genmc.c b/tools/test/smp-bkl-genmc.c
new file mode 100644
index 000000000..67027c71d
--- /dev/null
+++ b/tools/test/smp-bkl-genmc.c
@@ -0,0 +1,64 @@
+/*
+ * Copyright 2026 Indan Zupancic
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * seL4 big kernel lock test for GenMC, a Generic Model Checker
+ * for Concurrent Programs.
+ *
+ * This checks the big kernel lock only, without IPI.
+ * Test with:
+ *  genmc -- -O2 -Wall tools/test/smp-bkl-genmc.c
+ * Or, when using the genmc/genmc Docker image:
+ *  docker run --init --mount type=bind,source=/path/to/seL4,target=/root/seL4,readonly \
+ *  genmc/genmc genmc/RelWithDebInfo/bin/genmc -- -O2 -Wall seL4/tools/test/smp-bkl-genmc.c
+ */
+
+/* Check lock with three "cores", that is enough to test all states:
+ * Task "running", owning the lock and queued on the lock. */
+#define N 3
+#include "wrappers.h"
+
+typedef struct {
+    int call;
+} ipi_state_t;
+
+static inline void ipi_handle_call(bool_t irqPath) {}
+
+#include "../../include/smp/lock.h"
+#include "../../src/smp/lock.c"
+
+int a;
+
+void* thread(void* arg)
+{
+    CurrentCPUIndex = (ptrdiff_t)arg;
+    unsigned int x = CurrentCPUIndex + 1;
+
+    /* Test concurrent same thread lock-unlock-lock-unlock sequences: */
+    for (int i = 0; i < 2; ++i) {
+        clh_lock_acquire(true);
+        a = x;
+        /* If locking works as intended, then no race is possible: */
+        assert(a == x);
+        clh_lock_release();
+    }
+    return 0;
+}
+
+int main(void)
+{
+    pthread_t t[N];
+
+    clh_lock_init();
+
+    for (unsigned long i = 0; i < N; ++i) {
+        if (pthread_create(&t[i], NULL, thread, (void*)i) != 0) {
+            return 1;
+        }
+    }
+    for (int i = 0; i < N; ++i) {
+        pthread_join(t[i], NULL);
+    }
+    return 0;
+}
diff --git a/tools/test/smp-ipi-genmc.c b/tools/test/smp-ipi-genmc.c
new file mode 100644
index 000000000..e95240475
--- /dev/null
+++ b/tools/test/smp-ipi-genmc.c
@@ -0,0 +1,133 @@
+/*
+ * Copyright 2026 Indan Zupancic
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * seL4 IPI test for GenMC, a Generic Model Checker
+ * for Concurrent Programs.
+ *
+ * This checks the IPI code for correctness.
+ * Test with:
+ *  genmc -- -O2 -Wall tools/test/smp-ipi-genmc.c
+ * Or, when using the genmc/genmc Docker image:
+ *  docker run --mount type=bind,source=/path/to/seL4,target=/root/seL4,readonly genmc/genmc \
+ *  genmc/RelWithDebInfo/bin/genmc -check-liveness -- -O2 -Wall seL4/tools/test/smp-ipi-genmc.c
+ */
+
+/* Two IPI callers and two targets:*/
+#define N 4
+#include "wrappers.h"
+
+#include "../../include/smp/ipi.h"
+#include "../../include/smp/lock.h"
+#include "../../src/smp/lock.c"
+#include "../../src/smp/ipi.c"
+
+#if 0
+     Tell GenMC that core 2 sees the IPI
+    /* Send blocking remote call to core 2 */
+    doRemoteStall(target);
+    __VERIFIER_output("end IPI");
+#endif
+
+_Thread_local int num_ipis_received;
+int handled_ipi_call;
+int a, b, c, w;
+
+/* We can't emulate interrupts to wake tasks up easily, instead spin on clh_is_ipi_pending(). */
+void arch_ipi_send_target(irq_t irq, word_t cpu) {}
+
+void arch_handleRemoteCall(IpiRemoteCall_t call, word_t arg0, word_t arg1, word_t arg2)
+{
+    /* Only write global data if it is a one to one IPI: */
+    if (call == IpiRemoteCall_Stall) {
+        handled_ipi_call = call;
+        a = arg0;
+        b = arg1;
+        c = arg2;
+    }
+    num_ipis_received++;
+}
+
+void do_ipi(IpiRemoteCall_t call, unsigned int target_mask)
+{
+    int x = __VERIFIER_nondet_int();
+    int y = x + 1;
+    int z = x + 2;
+
+    /* Check we don't have a bug in the test code: */
+    assert(!clh_is_ipi_pending(CurrentCPUIndex));
+    clh_lock_acquire(true);
+    w = x;
+    assert(w == x);
+    ipi_remote_call(call, x, y, z, target_mask);
+
+    /* Check that remote "core" handled the IPI: */
+    if (call == IpiRemoteCall_Stall) {
+        assert(handled_ipi_call == IpiRemoteCall_Stall);
+        assert(a == x);
+        assert(b == y);
+        assert(c == z);
+    }
+    clh_lock_release();
+}
+
+void* caller(void* arg)
+{
+    CurrentCPUIndex = (ptrdiff_t)arg;
+
+    /* Test broadcasting IPIs to all targets: */
+    __VERIFIER_output("Send broadcast IPI");
+    do_ipi(IpiRemoteCall_Test, (1 << 2) | (1 << 3));
+    return 0;
+}
+
+void* caller2(void* arg)
+{
+    CurrentCPUIndex = (ptrdiff_t)arg;
+
+    /* Test individual IPIs to each target: */
+    __VERIFIER_output("Send IPI to 3");
+    do_ipi(IpiRemoteCall_Stall, 1 << 3);
+    __VERIFIER_output("Send IPI to 2");
+    do_ipi(IpiRemoteCall_Stall, 1 << 2);
+    return 0;
+}
+
+void* target(void* arg)
+{
+    unsigned int cpu = CurrentCPUIndex = (ptrdiff_t)arg;
+
+    /* We can handle multiple IPIs within one clh_lock_acquire(). */
+    while (num_ipis_received < 2) {
+        /* Wait for an IPI to be pending for this target: */
+        while (!clh_is_ipi_pending(cpu));
+        /* Now handle the IPI in clh_lock_acquire(): */
+        clh_lock_acquire(true);
+        clh_lock_release();
+    }
+    return 0;
+}
+
+int main(void)
+{
+    pthread_t t[N];
+
+    clh_lock_init();
+
+    if (pthread_create(&t[0], NULL, caller, 0) != 0) {
+        return 1;
+    }
+    if (pthread_create(&t[1], NULL, caller2, (void*)1) != 0) {
+        return 1;
+    }
+    for (unsigned long i = 2; i < N; ++i) {
+        if (pthread_create(&t[i], NULL, target, (void*)i) != 0) {
+            return 1;
+        }
+    }
+    for (int i = 0; i < N; ++i) {
+        pthread_join(t[i], NULL);
+    }
+    return 0;
+}
diff --git a/tools/test/wrappers.h b/tools/test/wrappers.h
new file mode 100644
index 000000000..5ec9b3c1a
--- /dev/null
+++ b/tools/test/wrappers.h
@@ -0,0 +1,85 @@
+/*
+ * Copyright 2026 Indan Zupancic
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Wrapper code to make seL4 SMP code compile with GenMC.
+ */
+#pragma once
+#include <assert.h>
+#include <stdlib.h>
+#include <pthread.h>
+#include <genmc.h>
+
+/* Dummy wrappers */
+#define L1_CACHE_LINE_SIZE
+#define EXCL_RES_GRANULE_SIZE 1
+#define ALIGN(n)
+#define compile_assert(...)
+#define arch_pause()
+#define BKL_not_padded
+#define BOOT_CODE
+#define SchedulerAction_ResumeCurrentThread 0
+#define SchedulerAction_ChooseNewThread 1
+#define SCHED_ENQUEUE_CURRENT_TCB
+#define fpuRelease(t)
+#define CORE_IRQ_TO_IRQT(tgt, irq) (irq)
+#define IRQT_TO_IDX(irq) (irq)
+#define IDX_TO_IRQT(idx) (idx)
+#define IRQT_TO_CORE(irqt) 0
+#define IRQT_TO_IRQ(irqt) (irqt)
+
+/* Copied from seL4 headers: */
+#define NO_INLINE    __attribute__((noinline))
+#define FORCE_INLINE __attribute__((always_inline))
+#define PASTE(a, b) a ## b
+#define _STRINGIFY(a) #a
+#define STRINGIFY(a) _STRINGIFY(a)
+#define UL_CONST(x) PASTE(x, ul)
+#define ULL_CONST(x) PASTE(x, llu)
+#define BIT(n) (UL_CONST(1) << (n))
+#define MASK(n) (BIT(n) - UL_CONST(1))
+#define popcountl(x) __builtin_popcountl(x)
+#define clzl(x) __builtin_clzl(x)
+#define cpuIndexToID(x) BIT(x)
+
+typedef unsigned long word_t;
+typedef unsigned long bool_t;
+typedef unsigned long irq_t;
+typedef unsigned long exception_t;
+
+typedef enum {
+    IpiRemoteCall_Stall, // Used to test a remote call to one target.
+    IpiRemoteCall_Test,  // Used to test broadcast IPIs.
+    IpiNumArchRemoteCall
+} IpiRemoteCall_t;
+
+/* Configuration */
+#define GENMC_TEST
+#define CONFIG_ENABLE_SMP_SUPPORT
+#define ENABLE_SMP_SUPPORT
+#define CONFIG_MAX_NUM_NODES N
+
+/* Wrappers */
+#define wordBits (sizeof(long) * 8ul)
+// TODO: How to deal with, or avoid NODE_STATE_ON_CORE(). Same as usual: Make it an array instead.
+#define NODE_STATE(x) x
+#define irq_remote_call_ipi 0
+#define irq_reschedule_ipi  1
+#define arch_ipi_send_mask generic_ipi_send_mask
+#define getCurrentCPUIndex() CurrentCPUIndex
+
+__thread int CurrentCPUIndex = -1;
+__thread int ksCurThread;
+__thread int ksSchedulerAction;
+int ksIdleThread = N;
+
+static inline void switchToIdleThread(void)
+{
+    ksCurThread = ksIdleThread;
+}
+
+static inline void rescheduleRequired(void)
+{
+    ksSchedulerAction = SchedulerAction_ChooseNewThread;
+}
