diff --git a/include/arch/x86/arch/object/svm.h b/include/arch/x86/arch/object/svm.h
new file mode 100644
index 000000000..ed668c3f1
--- /dev/null
+++ b/include/arch/x86/arch/object/svm.h
@@ -0,0 +1,162 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+/*
+ * AMD-V (SVM) behind the VCPU interface.  On an AMD CPU the VCPU object holds
+ * a VMCB where it holds a VMCS on Intel, and the same capabilities, VMEnter
+ * and EPT objects (which then hold nested page tables) serve guests.
+ */
+
+#pragma once
+
+#include <config.h>
+
+#ifdef CONFIG_VTX
+
+/* VMCB layout (AMD64 APM vol. 2, appendix B).  Offsets in bytes. */
+#define VMCB_INTERCEPT_CR       0x000   /* u32 reads, u32 writes at 0x002 */
+#define VMCB_INTERCEPT_DR       0x004
+#define VMCB_INTERCEPT_EXC      0x008
+#define VMCB_INTERCEPT_MISC1    0x00c
+#define VMCB_INTERCEPT_MISC2    0x010
+#define VMCB_INTERCEPT_MISC3    0x014
+#define VMCB_PAUSE_FILTER       0x038   /* threshold at 0x03c, count at 0x03e */
+#define VMCB_IOPM_BASE          0x040
+#define VMCB_MSRPM_BASE         0x048
+#define VMCB_TSC_OFFSET         0x050
+#define VMCB_ASID               0x058   /* u32, then u8 TLB_CONTROL */
+#define VMCB_INT_CTL            0x060   /* u32, then u32 vector */
+#define VMCB_INT_STATE          0x068
+#define VMCB_EXIT_CODE          0x070
+#define VMCB_EXIT_INFO1         0x078
+#define VMCB_EXIT_INFO2         0x080
+#define VMCB_EXIT_INT_INFO      0x088   /* u32, then u32 error code */
+#define VMCB_NESTED_CTL         0x090
+#define VMCB_AVIC_VAPIC_BAR     0x098
+#define VMCB_GHCB               0x0a0
+#define VMCB_EVENT_INJ          0x0a8   /* u32, then u32 error code */
+#define VMCB_NESTED_CR3         0x0b0
+#define VMCB_VIRT_EXT           0x0b8
+#define VMCB_CLEAN              0x0c0
+#define VMCB_NEXT_RIP           0x0c8
+#define VMCB_INSN_BYTES         0x0d0   /* u8 count, then 15 bytes */
+#define VMCB_AVIC_BACKING       0x0e0
+#define VMCB_AVIC_LOGICAL       0x0f0
+#define VMCB_AVIC_PHYSICAL      0x0f8
+#define VMCB_VMSA               0x108
+
+#define VMCB_SAVE               0x400
+#define VMCB_ES                 (VMCB_SAVE + 0x000) /* u16 sel, u16 attrib, u32 limit, u64 base */
+#define VMCB_CS                 (VMCB_SAVE + 0x010)
+#define VMCB_SS                 (VMCB_SAVE + 0x020)
+#define VMCB_DS                 (VMCB_SAVE + 0x030)
+#define VMCB_FS                 (VMCB_SAVE + 0x040)
+#define VMCB_GS                 (VMCB_SAVE + 0x050)
+#define VMCB_GDTR               (VMCB_SAVE + 0x060)
+#define VMCB_LDTR               (VMCB_SAVE + 0x070)
+#define VMCB_IDTR               (VMCB_SAVE + 0x080)
+#define VMCB_TR                 (VMCB_SAVE + 0x090)
+#define VMCB_CPL                (VMCB_SAVE + 0x0c8) /* the byte at 0x0cb */
+#define VMCB_EFER               (VMCB_SAVE + 0x0d0)
+#define VMCB_CR4                (VMCB_SAVE + 0x148)
+#define VMCB_CR3                (VMCB_SAVE + 0x150)
+#define VMCB_CR0                (VMCB_SAVE + 0x158)
+#define VMCB_DR7                (VMCB_SAVE + 0x160)
+#define VMCB_DR6                (VMCB_SAVE + 0x168)
+#define VMCB_RFLAGS             (VMCB_SAVE + 0x170)
+#define VMCB_RIP                (VMCB_SAVE + 0x178)
+#define VMCB_RSP                (VMCB_SAVE + 0x1d8)
+#define VMCB_RAX                (VMCB_SAVE + 0x1f8)
+#define VMCB_STAR               (VMCB_SAVE + 0x200)
+#define VMCB_LSTAR              (VMCB_SAVE + 0x208)
+#define VMCB_CSTAR              (VMCB_SAVE + 0x210)
+#define VMCB_SFMASK             (VMCB_SAVE + 0x218)
+#define VMCB_KERNEL_GS_BASE     (VMCB_SAVE + 0x220)
+#define VMCB_SYSENTER_CS        (VMCB_SAVE + 0x228)
+#define VMCB_SYSENTER_ESP       (VMCB_SAVE + 0x230)
+#define VMCB_SYSENTER_EIP       (VMCB_SAVE + 0x238)
+#define VMCB_CR2                (VMCB_SAVE + 0x240)
+#define VMCB_G_PAT              (VMCB_SAVE + 0x268)
+/* The end of what ReadVMCB reads: past the save area, through SPEC_CTRL. */
+#define VMCB_END                (VMCB_SAVE + 0x2e8)
+
+/* Exit codes. */
+#define SVM_EXIT_EXCP_BASE      0x040
+#define SVM_EXIT_INTR           0x060
+#define SVM_EXIT_NMI            0x061
+#define SVM_EXIT_SMI            0x062
+#define SVM_EXIT_INIT           0x063
+#define SVM_EXIT_SHUTDOWN       0x07f
+#define SVM_EXIT_NPF            0x400
+#define SVM_EXIT_INVALID        ((uint64_t)-1)
+
+/* At most this many words per ReadVMCB. */
+#define SVM_READ_MAX_WORDS      64
+
+/* The SVM part of a VCPU (vcpu_t's vmcs holds the VMCB). */
+struct svm_vcpu {
+    /* VMCB clean-bit groups changed since the last VMRUN. */
+    uint32_t dirty;
+    /* The ASID, valid while asid_gen is the generation of core asid_cpu. */
+    uint32_t asid;
+    word_t asid_gen;
+    word_t asid_cpu;
+    /* The core of its last VMRUN. */
+    word_t last_cpu;
+    /* NEXT_RIP - RIP of the last exit, or 0 when the CPU gave none. */
+    word_t instr_len;
+    /* The host save area restore_svm()'s exit path VMLOADs: here, and not
+     * in gp_registers, which WriteRegisters and WriteVMCB write. */
+    word_t host_area;
+};
+
+struct vcpu;
+struct tcb;
+
+/* Whether VCPUs use SVM; x86KSVTXEnabled is also set then. */
+extern bool_t x86KSSVMEnabled;
+
+bool_t svm_init(void);
+void svm_vcpu_init(struct vcpu *vcpu);
+exception_t svm_decodeVCPUInvocation(word_t invLabel, word_t length, cap_t cap,
+                                     bool_t call, word_t *buffer);
+void svm_update_state_sysvmenter(struct vcpu *vcpu, word_t *buffer);
+void svm_reply_to_user(struct tcb *tcb, struct vcpu *vcpu);
+exception_t svm_handle_exit(void);
+void svm_invalidate_local(void);
+void svm_claim_vcpu(struct vcpu *vcpu);
+void svm_make_current(struct vcpu *vcpu);
+void NORETURN restore_svm(struct tcb *cur_thread, struct vcpu *vcpu);
+
+/* A nested page table entry, from the EPT entry ept.c builds: the same
+ * address and software bits, user access (the CPU's nested walks are user
+ * accesses), and the EPT memory type as an index into the host's PAT on
+ * leaves (WB 0, WT 1, UC 3, WC 4: init_pat_msr()). */
+static inline uint64_t CONST nptFromEPT(uint64_t ept, bool_t leaf)
+{
+    uint64_t npt;
+    uint64_t type;
+
+    if (!(ept & BIT(0))) {
+        return 0;
+    }
+    /* Address bits 12-51, PS (bit 7), the software bits 9-11, R/W. */
+    npt = (ept & (0x000ffffffffff000ull | BIT(7) | 0xe00ull | BIT(1))) | BIT(0) | BIT(2);
+    if (!(ept & BIT(2))) {
+        npt |= BIT(63);
+    }
+    if (leaf) {
+        type = (ept >> 3) & 7;
+        if (type == 4) {        /* write-through */
+            npt |= BIT(3);
+        } else if (type == 1) { /* write-combining: the PAT bit */
+            npt |= (ept & BIT(7)) ? BIT(12) : BIT(7);
+        } else if (type != 6) { /* not write-back: uncached */
+            npt |= BIT(3) | BIT(4);
+        }
+    }
+    return npt;
+}
+
+#endif /* CONFIG_VTX */
diff --git a/include/arch/x86/arch/object/vcpu.h b/include/arch/x86/arch/object/vcpu.h
index 53c1eb1b3..fc7275a3d 100644
--- a/include/arch/x86/arch/object/vcpu.h
+++ b/include/arch/x86/arch/object/vcpu.h
@@ -8,6 +8,20 @@
 
 #include <config.h>
 #include <api/failures.h>
+#include <arch/object/svm.h>
+
+/*
+ * The CR4 bits a guest may set, on VT-x and AMD-V: those whose effects stay
+ * in guest mode, on state that VM entry and exit switch or that seL4 does
+ * (XCR0, the FS and GS bases).  VME, PVI, TSD, DE, PSE, PAE, MCE, PGE, PCE,
+ * OSFXSR, OSXMMEXCPT, UMIP, LA57, FSGSBASE, PCIDE, OSXSAVE, SMEP and SMAP.
+ * Every other bit stays clear in the guest, including any a later CPU
+ * defines: some enable state that nothing switches and that the next guest
+ * on the core would run with, such as PKRU (PKE), the Key Locker wrapping
+ * key (KL), PKRS (PKS) and the CET, UINTR and FRED registers.
+ */
+#define VCPU_GUEST_CR4_ALLOWED \
+    (MASK(13) | BIT(16) | BIT(17) | BIT(18) | BIT(20) | BIT(21))
 
 #define VCPU_VMCS_SIZE 4096
 #define VCPU_IOBITMAP_SIZE 8192
@@ -381,6 +395,9 @@ struct vcpu {
     /* Core this VCPU was last loaded on, or is currently loaded on */
     word_t last_cpu;
 #endif /* ENABLE_SMP_SUPPORT */
+
+    /* On AMD CPUs (x86KSSVMEnabled), where vmcs holds the VMCB. */
+    struct svm_vcpu svm;
 };
 typedef struct vcpu vcpu_t;
 
@@ -425,9 +442,34 @@ void VMCheckBoundNotification(tcb_t *tcb);
 #endif /* ENABLE_SMP_SUPPORT */
 
 void invept(ept_pml4e_t *ept_pml4);
+#define HOST_XCR0 ((uint64_t)config_ternary(CONFIG_XSAVE, CONFIG_XSAVE_FEATURE_SET, 1))
+
+#define XCR0_AVX512 (MASK(3) << 5)
+
+/* A value XSETBV accepts for the guest: XSETBV runs in kernel mode, where
+ * any other would fault.  x87 is on, AVX needs SSE, AVX-512's three
+ * components go together and need AVX, and MPX's two and AMX's two each go
+ * together, whatever KernelXSaveFeatureSet enables. */
+static inline bool_t CONST validGuestXCR0(uint64_t xcr0)
+{
+    return (xcr0 & ~HOST_XCR0) == 0 && (xcr0 & BIT(0)) &&
+           (!(xcr0 & BIT(2)) || (xcr0 & BIT(1))) &&
+           ((xcr0 & XCR0_AVX512) == 0 ||
+            ((xcr0 & XCR0_AVX512) == XCR0_AVX512 && (xcr0 & BIT(2)))) &&
+           !(xcr0 & BIT(3)) == !(xcr0 & BIT(4)) &&
+           !(xcr0 & BIT(17)) == !(xcr0 & BIT(18));
+}
+
 void vcpu_make_current(vcpu_t *vcpu);
 void vcpu_load_guest_xcr0(vcpu_t *vcpu);
 void vcpu_load_host_xcr0(vcpu_t *vcpu);
+
+/* An EPT root with nothing mapped, for a TCB without one. */
+extern char null_ept_space[];
+#ifdef ENABLE_SMP_SUPPORT
+/* Cores that have entered a VM.  Only they can hold EPT translations. */
+extern word_t x86KSVMXCores;
+#endif
 void invalidateLocalEPT(ept_pml4e_t *ept_pml4);
 
 /* Removes any IO port mappings that have been cached for the given VPID */
