diff --git a/src/arch/x86/object/svm.c b/src/arch/x86/object/svm.c
new file mode 100644
index 000000000..1855b93b3
--- /dev/null
+++ b/src/arch/x86/object/svm.c
@@ -0,0 +1,1007 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+/*
+ * AMD-V (SVM) behind the VCPU interface.
+ *
+ * On an AMD CPU a VCPU object holds a VMCB where it holds a VMCS on Intel.
+ * SetTCB, WriteRegisters, Read/WriteMSR, FlushTLB, VMEnter and the EPT
+ * objects keep their meaning; ReadVMCB and WriteVMCB take the place of
+ * ReadVMCS and WriteVMCS, and address the VMCB by byte offset.  Userspace
+ * may write only the fields listed in svm_field(), and seL4 keeps on the
+ * intercepts the host needs: a guest without them could run VMLOAD, VMSAVE,
+ * CLGI or SKINIT on host physical memory, change XCR0, or shut the core down.
+ *
+ * The EPT objects hold nested page tables: ept.c writes their entries
+ * through nptFromEPT().  TLB entries are tagged by ASIDs, which are per
+ * core: a VCPU takes the next one of its core, and any invalidation (an EPT
+ * unmap, FlushTLB) moves its core to a new generation, so that every VCPU
+ * takes a new ASID before it runs there again.
+ *
+ * A VM exit returns to the instruction after VMRUN, on the VCPU's register
+ * array as the stack (restore_svm()).  The host's FS, GS, TR, LDTR and the
+ * syscall MSRs come back with VMLOAD from a copy each core takes the first
+ * time it runs a VCPU: they are the same for every thread in the kernel, and
+ * the user's FS and GS bases are loaded again on the way out.
+ */
+
+#include <config.h>
+
+#if defined(CONFIG_VTX) && defined(CONFIG_ARCH_X86_64)
+
+#include <types.h>
+#include <machine/io.h>
+#include <api/failures.h>
+#include <api/syscall.h>
+#include <kernel/thread.h>
+#include <kernel/stack.h>
+#include <object/objecttype.h>
+#include <arch/machine/cpu_registers.h>
+#include <arch/model/statedata.h>
+#include <arch/object/vcpu.h>
+#include <arch/object/svm.h>
+#include <arch/kernel/ept.h>
+#include <arch/smp/ipi_inline.h>
+#include <util.h>
+#include <sel4/arch/vmenter.h>
+
+#define MSR_VM_CR               0xc0010114
+#define MSR_VM_HSAVE_PA         0xc0010117
+#define VM_CR_SVMDIS            BIT(4)
+#define EFER_SVME               BIT(12)
+
+/* VMCB clean bits: the groups of fields the CPU may keep from the last
+ * VMRUN of this VMCB on this core. */
+#define VMCB_CLEAN_I            BIT(0)  /* intercepts, TSC offset, pause filter */
+#define VMCB_CLEAN_IOPM         BIT(1)
+#define VMCB_CLEAN_ASID         BIT(2)
+#define VMCB_CLEAN_INTR         BIT(3)  /* int_ctl, int_vector */
+#define VMCB_CLEAN_NP           BIT(4)  /* nested_ctl, nCR3, gPAT */
+#define VMCB_CLEAN_CRX          BIT(5)  /* CR0, CR3, CR4, EFER */
+#define VMCB_CLEAN_DRX          BIT(6)
+#define VMCB_CLEAN_DT           BIT(7)  /* GDTR, IDTR */
+#define VMCB_CLEAN_SEG          BIT(8)  /* CS, DS, SS, ES, CPL */
+#define VMCB_CLEAN_CR2          BIT(9)
+#define VMCB_CLEAN_ALL          MASK(13)
+
+/* Intercepts in the misc1 vector (VMCB offset 0x00c). */
+#define SVM_I1_INTR             BIT(0)
+#define SVM_I1_NMI              BIT(1)
+#define SVM_I1_SMI              BIT(2)
+#define SVM_I1_INIT             BIT(3)
+#define SVM_I1_RDPMC            BIT(15)
+#define SVM_I1_INVD             BIT(22)
+#define SVM_I1_INVLPGA          BIT(26)
+#define SVM_I1_IOIO             BIT(27)
+#define SVM_I1_MSR              BIT(28)
+#define SVM_I1_SHUTDOWN         BIT(31)
+/* Intercepts in the misc2 vector (VMCB offset 0x010). */
+#define SVM_I2_VMRUN            BIT(0)
+#define SVM_I2_VMMCALL          BIT(1)
+#define SVM_I2_VMLOAD           BIT(2)
+#define SVM_I2_VMSAVE           BIT(3)
+#define SVM_I2_STGI             BIT(4)
+#define SVM_I2_CLGI             BIT(5)
+#define SVM_I2_SKINIT           BIT(6)
+#define SVM_I2_RDTSCP           BIT(7)
+#define SVM_I2_ICEBP            BIT(8)
+#define SVM_I2_WBINVD           BIT(9)
+#define SVM_I2_MONITOR          BIT(10)
+#define SVM_I2_MWAIT            BIT(11)
+#define SVM_I2_MWAIT_COND       BIT(12)
+#define SVM_I2_XSETBV           BIT(13)
+#define SVM_I2_RDPRU            BIT(14)
+
+/*
+ * The intercepts seL4 keeps on: host interrupts, NMIs, SMIs and INIT must
+ * leave the guest; a shutdown would reset the core; INVD would discard
+ * dirty cache lines of seL4 and other guests; the counters and debug
+ * registers are not switched; XCR0 takes only values WriteMSR checked; and
+ * nothing makes VMLOAD, VMSAVE, CLGI, STGI, SKINIT and INVLPGA safe in a
+ * guest.  #DB and #AC always exit, as a guest could otherwise loop on them
+ * without an exit, and #MC belongs to the host.
+ */
+#define SVM_I1_FORCED (SVM_I1_INTR | SVM_I1_NMI | SVM_I1_SMI | SVM_I1_INIT | SVM_I1_RDPMC | \
+                       SVM_I1_INVD | SVM_I1_INVLPGA | SVM_I1_IOIO | SVM_I1_MSR | SVM_I1_SHUTDOWN)
+/* VINTR, selective CR0, the descriptor table reads and writes, RDTSC,
+ * PUSHF, POPF, CPUID, RSM, IRET, INTn, PAUSE, HLT, INVLPG, task switches
+ * and FERR_FREEZE are userspace's. */
+#define SVM_I1_WRITABLE ((MASK(15) & ~MASK(4)) | (MASK(26) & ~MASK(16) & ~SVM_I1_INVD) | BIT(29) | BIT(30))
+#define SVM_I2_FORCED (SVM_I2_VMRUN | SVM_I2_VMLOAD | SVM_I2_VMSAVE | SVM_I2_STGI | SVM_I2_CLGI | \
+                       SVM_I2_SKINIT | SVM_I2_MONITOR | SVM_I2_MWAIT | SVM_I2_MWAIT_COND | \
+                       SVM_I2_XSETBV | SVM_I2_RDPRU)
+#define SVM_I2_WRITABLE (SVM_I2_VMMCALL | SVM_I2_RDTSCP | SVM_I2_ICEBP | SVM_I2_WBINVD)
+#define SVM_EXC_FORCED (BIT(1) | BIT(17) | BIT(18))
+/* CR4 writes always exit: SVM has no CR4 mask, and a guest must not set
+ * the bits outside VCPU_GUEST_CR4_ALLOWED. */
+#define SVM_CR_FORCED  BIT(16 + 4)
+
+#define SVM_INT_CTL_WRITABLE    (MASK(9) | (MASK(4) << 16) | BIT(20))
+/* EVENTINJ: vector, type, EV and V, and the error code. */
+#define SVM_EVENT_INJ_WRITABLE  0xffffffff80000fffull
+#define SVM_V_INTR_MASKING      BIT(24)
+#define SVM_NP_ENABLE           BIT(0)
+#define SVM_TLB_FLUSH_ALL       1
+
+/* The I/O and MSR permission maps, the same for every VCPU: all ports
+ * exit, and the MSRs that VMLOAD and VMSAVE switch do not. */
+static char svm_iopm[3 * BIT(seL4_PageBits)] ALIGN(BIT(seL4_PageBits));
+static char svm_msrpm[2 * BIT(seL4_PageBits)] ALIGN(BIT(seL4_PageBits));
+
+static uint32_t svm_nasid;
+static bool_t svm_has_clean_bits;
+
+static inline uint64_t *vmcb_word(vcpu_t *vcpu, word_t offset)
+{
+    return (uint64_t *)(vcpu->vmcs + offset);
+}
+
+static inline uint32_t *vmcb_u32(vcpu_t *vcpu, word_t offset)
+{
+    return (uint32_t *)(vcpu->vmcs + offset);
+}
+
+static inline paddr_t vmcb_paddr(vcpu_t *vcpu)
+{
+    return pptr_to_paddr(vcpu->vmcs);
+}
+
+static inline void svm_vmsave(paddr_t pa)
+{
+    asm volatile("vmsave %%rax" :: "a"(pa) : "memory");
+}
+
+static void svm_msrpm_pass(uint32_t msr)
+{
+    word_t base;
+
+    if (msr < 0x2000) {
+        base = 0;
+    } else if (msr >= 0xc0000000 && msr < 0xc0002000) {
+        base = 0x800;
+        msr -= 0xc0000000;
+    } else {
+        return;
+    }
+    /* Two bits per MSR: read, then write. */
+    svm_msrpm[base + msr / 4] &= ~(3 << ((msr % 4) * 2));
+}
+
+/* Set up SVM on the current core, or return false, leaving it off, when
+ * the core cannot provide what seL4 requires. */
+static BOOT_CODE bool_t svm_try_init(void)
+{
+    uint32_t features;
+    uint32_t nasid;
+
+    if (!(x86_cpuid_ecx(0x80000001, 0) & BIT(2))) {
+        printf("svm: not supported\n");
+        return false;
+    }
+    if (x86_rdmsr(MSR_VM_CR) & VM_CR_SVMDIS) {
+        printf("svm: disabled by the firmware\n");
+        return false;
+    }
+    features = x86_cpuid_edx(0x8000000a, 0);
+    nasid = x86_cpuid_ebx(0x8000000a, 0);
+    if (!(features & BIT(0))) {
+        printf("svm: no nested paging\n");
+        return false;
+    }
+    if (!(features & BIT(3))) {
+        printf("svm: no next-RIP saving\n");
+        return false;
+    }
+    if (nasid < 2) {
+        printf("svm: no ASIDs for guests\n");
+        return false;
+    }
+    if (CURRENT_CPU_INDEX() == 0) {
+        svm_nasid = nasid;
+        svm_has_clean_bits = !!(features & BIT(5));
+        memset(svm_iopm, ~0, sizeof(svm_iopm));
+        memset(svm_msrpm, ~0, sizeof(svm_msrpm));
+        svm_msrpm_pass(IA32_SYSENTER_CS_MSR);
+        svm_msrpm_pass(IA32_SYSENTER_ESP_MSR);
+        svm_msrpm_pass(IA32_SYSENTER_EIP_MSR);
+        svm_msrpm_pass(IA32_FS_BASE_MSR);
+        svm_msrpm_pass(IA32_GS_BASE_MSR);
+        svm_msrpm_pass(IA32_KERNEL_GS_BASE_MSR);
+        svm_msrpm_pass(IA32_STAR_MSR);
+        svm_msrpm_pass(IA32_LSTAR_MSR);
+        svm_msrpm_pass(IA32_CSTAR_MSR);
+        svm_msrpm_pass(IA32_FMASK_MSR);
+    } else if (nasid != svm_nasid || !!(features & BIT(5)) != svm_has_clean_bits) {
+        printf("svm: cores have inconsistent features\n");
+        return false;
+    }
+    x86_wrmsr(IA32_EFER_MSR, x86_rdmsr(IA32_EFER_MSR) | EFER_SVME);
+    /* The VMXON region, unused on AMD, is the host save area. */
+    x86_wrmsr(MSR_VM_HSAVE_PA, kpptr_to_paddr(&ARCH_NODE_STATE(x86KSVMXOnRegion)));
+    ARCH_NODE_STATE(x86KSSVMASIDGen) = 1;
+    ARCH_NODE_STATE(x86KSSVMNextASID) = 1;
+    ARCH_NODE_STATE(x86KSSVMHostSaved) = false;
+    /* Whatever ran before seL4 may have left translations tagged. */
+    ARCH_NODE_STATE(x86KSSVMFlushPending) = true;
+    return true;
+}
+
+BOOT_CODE bool_t svm_init(void)
+{
+    if (CURRENT_CPU_INDEX() != 0) {
+        return !x86KSVTXEnabled || svm_try_init();
+    }
+    if (!config_set(CONFIG_X86_64_VTX_64BIT_GUESTS)) {
+        /* restore_svm() switches r8-r15 too, which the VCPU holds only
+         * with 64-bit guests. */
+        printf("svm: needs KernelX86_64VTX64BitGuests\n");
+        printf("svm: unavailable; booting without it\n");
+        x86KSVTXEnabled = false;
+        return true;
+    }
+    if (config_set(CONFIG_KERNEL_SKIM_WINDOW)) {
+        /* As for VT-x (vtx_init()): SKIM builds run no VMs. */
+        printf("svm: off with the SKIM window\n");
+        x86KSVTXEnabled = false;
+        return true;
+    }
+    x86KSSVMEnabled = x86KSVTXEnabled = svm_try_init();
+    if (!x86KSVTXEnabled) {
+        printf("svm: unavailable; booting without it\n");
+    }
+    return true;
+}
+
+static void svm_seg(vcpu_t *vcpu, word_t offset, uint16_t sel, uint16_t attrib, uint32_t limit, uint64_t base)
+{
+    *vmcb_word(vcpu, offset) = sel | ((uint64_t)attrib << 16) | ((uint64_t)limit << 32);
+    *vmcb_word(vcpu, offset + 8) = base;
+}
+
+/* The guest state after RESET, as KVM's init_vmcb() sets it. */
+static void svm_reset_save_area(vcpu_t *vcpu)
+{
+    memzero(vcpu->vmcs + VMCB_SAVE, VMCB_END - VMCB_SAVE);
+    svm_seg(vcpu, VMCB_CS, 0xf000, 0x9b, 0xffff, 0xffff0000);
+    svm_seg(vcpu, VMCB_DS, 0, 0x93, 0xffff, 0);
+    svm_seg(vcpu, VMCB_ES, 0, 0x93, 0xffff, 0);
+    svm_seg(vcpu, VMCB_FS, 0, 0x93, 0xffff, 0);
+    svm_seg(vcpu, VMCB_GS, 0, 0x93, 0xffff, 0);
+    svm_seg(vcpu, VMCB_SS, 0, 0x93, 0xffff, 0);
+    svm_seg(vcpu, VMCB_GDTR, 0, 0, 0xffff, 0);
+    svm_seg(vcpu, VMCB_IDTR, 0, 0, 0xffff, 0);
+    svm_seg(vcpu, VMCB_LDTR, 0, 0x82, 0xffff, 0);
+    svm_seg(vcpu, VMCB_TR, 0, 0x8b, 0xffff, 0);
+    *vmcb_word(vcpu, VMCB_EFER) = EFER_SVME;
+    *vmcb_word(vcpu, VMCB_CR0) = 0x10;         /* ET */
+    *vmcb_word(vcpu, VMCB_DR6) = 0xffff0ff0;
+    *vmcb_word(vcpu, VMCB_DR7) = 0x400;
+    *vmcb_word(vcpu, VMCB_RFLAGS) = 2;
+    *vmcb_word(vcpu, VMCB_RIP) = 0xfff0;
+    *vmcb_word(vcpu, VMCB_G_PAT) = 0x0007040600070406ull;
+    vcpu->gp_registers[VCPU_EAX] = 0;
+    vcpu->svm.dirty = VMCB_CLEAN_ALL;
+}
+
+void svm_vcpu_init(vcpu_t *vcpu)
+{
+    vcpu->vcpuTCB = NULL;
+    vcpu->launched = false;
+    vcpu->fpu_active = false;
+    vcpu->exit_info_valid = false;
+    vcpu->fpuState = x86KSnullFpuState;
+    vcpu->vpid = VPID_INVALID;
+    vcpu->last_ept_root = 0;
+    vcpu->entry_intr = 0;
+    vcpu->xcr0 = HOST_XCR0;
+    vcpu->svm.last_cpu = CURRENT_CPU_INDEX();
+#ifdef ENABLE_SMP_SUPPORT
+    vcpu->last_cpu = CURRENT_CPU_INDEX();
+#endif
+
+    memzero(vcpu->vmcs, VCPU_VMCS_SIZE);
+    *vmcb_u32(vcpu, VMCB_INTERCEPT_CR) = SVM_CR_FORCED;
+    *vmcb_u32(vcpu, VMCB_INTERCEPT_DR) = ~(uint32_t)0;
+    *vmcb_u32(vcpu, VMCB_INTERCEPT_EXC) = SVM_EXC_FORCED;
+    *vmcb_u32(vcpu, VMCB_INTERCEPT_MISC1) = SVM_I1_FORCED;
+    *vmcb_u32(vcpu, VMCB_INTERCEPT_MISC2) = SVM_I2_FORCED;
+    *vmcb_word(vcpu, VMCB_IOPM_BASE) = kpptr_to_paddr(svm_iopm);
+    *vmcb_word(vcpu, VMCB_MSRPM_BASE) = kpptr_to_paddr(svm_msrpm);
+    *vmcb_u32(vcpu, VMCB_INT_CTL) = SVM_V_INTR_MASKING;
+    *vmcb_word(vcpu, VMCB_NESTED_CTL) = SVM_NP_ENABLE;
+    *vmcb_word(vcpu, VMCB_NESTED_CR3) = kpptr_to_paddr(null_ept_space);
+    vcpu->ppc = SVM_I1_FORCED;
+    vcpu->svm.asid = 0;
+    vcpu->svm.asid_gen = 0;
+    vcpu->svm.asid_cpu = 0;
+    vcpu->svm.instr_len = 0;
+    svm_reset_save_area(vcpu);
+}
+
+static inline bool_t CONST svm_canonical(uint64_t v)
+{
+    return (uint64_t)(((int64_t)v << 16) >> 16) == v;
+}
+
+static bool_t CONST svm_pat_valid(uint64_t pat)
+{
+    for (int i = 0; i < 8; i++) {
+        uint8_t type = pat >> (i * 8);
+        if (type != 0 && type != 1 && type != 4 && type != 5 && type != 6 && type != 7) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/*
+ * What userspace may write in the 8-byte VMCB word at `offset`: the bits in
+ * writable, with the bits in forced always on, dirtying the clean-bit groups
+ * in clean.  Every other word is the kernel's, or the CPU's.  Addresses the
+ * CPU would use (the permission maps, nCR3, AVIC, the VMSA) are never
+ * writable, and neither are VMCB settings that would make one used.
+ */
+typedef struct svm_field {
+    uint64_t writable;
+    uint64_t forced;
+    uint32_t clean;
+    bool_t canonical;
+} svm_field_t;
+
+static bool_t svm_field(word_t offset, svm_field_t *f)
+{
+    f->forced = 0;
+    f->clean = 0;
+    f->canonical = false;
+    f->writable = ~(uint64_t)0;
+    switch (offset) {
+    case VMCB_INTERCEPT_CR:      /* and the DR intercepts, all on */
+        f->writable = MASK(32);
+        f->forced = SVM_CR_FORCED | ((uint64_t)MASK(32) << 32);
+        f->clean = VMCB_CLEAN_I;
+        return true;
+    case VMCB_INTERCEPT_EXC:     /* and misc1 */
+        f->writable = MASK(32) | ((uint64_t)(SVM_I1_WRITABLE) << 32);
+        f->forced = SVM_EXC_FORCED | ((uint64_t)SVM_I1_FORCED << 32);
+        f->clean = VMCB_CLEAN_I;
+        return true;
+    case VMCB_INTERCEPT_MISC2:   /* and misc3, all off */
+        f->writable = SVM_I2_WRITABLE;
+        f->forced = SVM_I2_FORCED;
+        f->clean = VMCB_CLEAN_I;
+        return true;
+    case VMCB_PAUSE_FILTER:
+        f->writable = (uint64_t)MASK(32) << 32;
+        f->clean = VMCB_CLEAN_I;
+        return true;
+    case VMCB_TSC_OFFSET:
+        f->clean = VMCB_CLEAN_I;
+        return true;
+    case VMCB_INT_CTL:           /* and int_vector */
+        f->writable = SVM_INT_CTL_WRITABLE | ((uint64_t)MASK(8) << 32);
+        f->forced = SVM_V_INTR_MASKING;
+        f->clean = VMCB_CLEAN_INTR;
+        return true;
+    case VMCB_INT_STATE:
+        f->writable = BIT(0);
+        return true;
+    case VMCB_EVENT_INJ:         /* the CPU checks the event */
+        f->writable = SVM_EVENT_INJ_WRITABLE;
+        return true;
+    case VMCB_NEXT_RIP:          /* for soft interrupts and exceptions */
+        return true;
+    case VMCB_ES:
+    case VMCB_CS:
+    case VMCB_SS:
+    case VMCB_DS:
+    case VMCB_CPL:
+        if (offset == VMCB_CPL) {
+            f->writable = (uint64_t)MASK(8) << 24;
+        }
+        f->clean = VMCB_CLEAN_SEG;
+        return true;
+    case VMCB_ES + 8:
+    case VMCB_CS + 8:
+    case VMCB_SS + 8:
+    case VMCB_DS + 8:
+        f->clean = VMCB_CLEAN_SEG;
+        f->canonical = true;
+        return true;
+    case VMCB_GDTR:
+    case VMCB_IDTR:
+        f->clean = VMCB_CLEAN_DT;
+        return true;
+    case VMCB_GDTR + 8:
+    case VMCB_IDTR + 8:
+        f->clean = VMCB_CLEAN_DT;
+        f->canonical = true;
+        return true;
+    case VMCB_FS:
+    case VMCB_GS:
+    case VMCB_LDTR:
+    case VMCB_TR:
+    case VMCB_RFLAGS:
+    case VMCB_RIP:
+    case VMCB_RSP:
+    case VMCB_STAR:
+    case VMCB_SFMASK:
+    case VMCB_SYSENTER_CS:
+        return true;
+    case VMCB_FS + 8:
+    case VMCB_GS + 8:
+    case VMCB_LDTR + 8:
+    case VMCB_TR + 8:
+    case VMCB_LSTAR:
+    case VMCB_CSTAR:
+    case VMCB_KERNEL_GS_BASE:
+    case VMCB_SYSENTER_ESP:
+    case VMCB_SYSENTER_EIP:
+        /* VMLOAD loads these as they are. */
+        f->canonical = true;
+        return true;
+    case VMCB_EFER:
+        f->forced = EFER_SVME;
+        f->clean = VMCB_CLEAN_CRX;
+        return true;
+    case VMCB_CR4:
+        f->writable = VCPU_GUEST_CR4_ALLOWED;
+        f->clean = VMCB_CLEAN_CRX;
+        return true;
+    case VMCB_CR0:
+    case VMCB_CR3:
+        f->clean = VMCB_CLEAN_CRX;
+        return true;
+    case VMCB_DR6:
+    case VMCB_DR7:
+        f->clean = VMCB_CLEAN_DRX;
+        return true;
+    case VMCB_CR2:
+        f->clean = VMCB_CLEAN_CR2;
+        return true;
+    case VMCB_G_PAT:
+        f->clean = VMCB_CLEAN_NP;
+        return true;
+    default:
+        return false;
+    }
+}
+
+/* The words ReadVMCB does not show: host physical addresses. */
+static bool_t CONST svm_hidden(word_t offset)
+{
+    switch (offset) {
+    case VMCB_IOPM_BASE:
+    case VMCB_MSRPM_BASE:
+    case VMCB_AVIC_VAPIC_BAR:
+    case VMCB_GHCB:
+    case VMCB_NESTED_CR3:
+    case VMCB_AVIC_BACKING:
+    case VMCB_AVIC_LOGICAL:
+    case VMCB_AVIC_PHYSICAL:
+    case VMCB_VMSA:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static word_t svm_read_word(vcpu_t *vcpu, word_t offset)
+{
+    if (offset == VMCB_RAX) {
+        return vcpu->gp_registers[VCPU_EAX];
+    }
+    if (svm_hidden(offset)) {
+        return 0;
+    }
+    return *vmcb_word(vcpu, offset);
+}
+
+static exception_t decodeReadVMCB(cap_t cap, word_t length, bool_t call, word_t *buffer)
+{
+    vcpu_t *vcpu = VCPU_PTR(cap_vcpu_cap_get_capVCPUPtr(cap));
+    tcb_t *thread = NODE_STATE(ksCurThread);
+    word_t offset, count, i;
+
+    if (length < 2) {
+        userError("VCPU ReadVMCB: Not enough arguments.");
+        current_syscall_error.type = seL4_TruncatedMessage;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    offset = getSyscallArg(0, buffer);
+    count = getSyscallArg(1, buffer);
+    if ((offset & 7) || offset >= VMCB_END || count == 0 || count > SVM_READ_MAX_WORDS ||
+        count > (VMCB_END - offset) / 8) {
+        userError("VCPU ReadVMCB: Invalid range %lx+%lu.", (long)offset, (long)count);
+        current_syscall_error.type = seL4_InvalidArgument;
+        current_syscall_error.invalidArgumentNumber = 0;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    if (call) {
+        word_t *ipcBuffer = lookupIPCBuffer(true, thread);
+        unsigned int n = 0;
+        for (i = 0; i < count; i++) {
+            n = setMR(thread, ipcBuffer, i, svm_read_word(vcpu, offset + i * 8));
+        }
+        setRegister(thread, badgeRegister, 0);
+        setRegister(thread, msgInfoRegister, wordFromMessageInfo(seL4_MessageInfo_new(0, 0, 0, n)));
+    }
+    setThreadState(thread, ThreadState_Running);
+    return EXCEPTION_NONE;
+}
+
+static exception_t decodeWriteVMCB(cap_t cap, word_t length, bool_t call, word_t *buffer)
+{
+    vcpu_t *vcpu = VCPU_PTR(cap_vcpu_cap_get_capVCPUPtr(cap));
+    tcb_t *thread = NODE_STATE(ksCurThread);
+    svm_field_t f;
+    word_t offset;
+    uint64_t value;
+
+    if (length < 2) {
+        userError("VCPU WriteVMCB: Not enough arguments.");
+        current_syscall_error.type = seL4_TruncatedMessage;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    offset = getSyscallArg(0, buffer);
+    value = getSyscallArg(1, buffer);
+    if (offset == VMCB_RAX) {
+        vcpu->gp_registers[VCPU_EAX] = value;
+    } else {
+        if ((offset & 7) || !svm_field(offset, &f)) {
+            userError("VCPU WriteVMCB: Invalid offset %lx.", (long)offset);
+            current_syscall_error.type = seL4_IllegalOperation;
+            return EXCEPTION_SYSCALL_ERROR;
+        }
+        if (f.canonical && !svm_canonical(value)) {
+            userError("VCPU WriteVMCB: Noncanonical address %lx.", (long)value);
+            current_syscall_error.type = seL4_InvalidArgument;
+            current_syscall_error.invalidArgumentNumber = 1;
+            return EXCEPTION_SYSCALL_ERROR;
+        }
+        if (offset == VMCB_G_PAT && !svm_pat_valid(value)) {
+            userError("VCPU WriteVMCB: Invalid PAT %lx.", (long)value);
+            current_syscall_error.type = seL4_InvalidArgument;
+            current_syscall_error.invalidArgumentNumber = 1;
+            return EXCEPTION_SYSCALL_ERROR;
+        }
+        value = (*vmcb_word(vcpu, offset) & ~f.writable) | (value & f.writable) | f.forced;
+        *vmcb_word(vcpu, offset) = value;
+        vcpu->svm.dirty |= f.clean;
+        if (offset == VMCB_INTERCEPT_EXC) {
+            vcpu->ppc = value >> 32;
+        }
+    }
+    if (call) {
+        unsigned int n = setMR(thread, lookupIPCBuffer(true, thread), 0, value);
+        setRegister(thread, badgeRegister, 0);
+        setRegister(thread, msgInfoRegister, wordFromMessageInfo(seL4_MessageInfo_new(0, 0, 0, n)));
+    }
+    setThreadState(thread, ThreadState_Running);
+    return EXCEPTION_NONE;
+}
+
+#ifdef CONFIG_X86_64_VTX_64BIT_GUESTS
+/* The MSRs that Read/WriteMSR have on VT-x, here in the VMCB. */
+static word_t svm_msr_offset(word_t msr)
+{
+    switch (msr) {
+    case IA32_STAR_MSR:
+        return VMCB_STAR;
+    case IA32_LSTAR_MSR:
+        return VMCB_LSTAR;
+    case IA32_CSTAR_MSR:
+        return VMCB_CSTAR;
+    case IA32_FMASK_MSR:
+        return VMCB_SFMASK;
+    case IA32_KERNEL_GS_BASE_MSR:
+        return VMCB_KERNEL_GS_BASE;
+    case SEL4_VCPU_MSR_CR2:
+        return VMCB_CR2;
+    default:
+        return 0;
+    }
+}
+
+static exception_t decodeSVMMSR(cap_t cap, word_t length, bool_t write, word_t *buffer)
+{
+    vcpu_t *vcpu = VCPU_PTR(cap_vcpu_cap_get_capVCPUPtr(cap));
+    tcb_t *thread = NODE_STATE(ksCurThread);
+    word_t msr, offset;
+    svm_field_t f;
+    word_t value;
+
+    if (length < (write ? 2 : 1)) {
+        userError("VCPU Read/WriteMSR: Not enough arguments.");
+        current_syscall_error.type = seL4_IllegalOperation;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    msr = getSyscallArg(0, buffer);
+    value = write ? getSyscallArg(1, buffer) : 0;
+    /* XCR0 is not in the VMCB: restore_svm() loads it (patch 0039). */
+    offset = svm_msr_offset(msr);
+    if (!offset && msr != SEL4_VCPU_MSR_XCR0) {
+        userError("VCPU Read/WriteMSR: Invalid field %lx.", (long)msr);
+        current_syscall_error.type = seL4_IllegalOperation;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    if (write && !offset && !validGuestXCR0(value)) {
+        userError("VCPU WriteMSR: Invalid XCR0 %lx.", (long)value);
+        current_syscall_error.type = seL4_InvalidArgument;
+        current_syscall_error.invalidArgumentNumber = 1;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    if (write && offset) {
+        svm_field(offset, &f);
+        if (f.canonical && !svm_canonical(value)) {
+            userError("VCPU WriteMSR: Noncanonical address %lx.", (long)value);
+            current_syscall_error.type = seL4_InvalidArgument;
+            current_syscall_error.invalidArgumentNumber = 1;
+            return EXCEPTION_SYSCALL_ERROR;
+        }
+        *vmcb_word(vcpu, offset) = value;
+        vcpu->svm.dirty |= f.clean;
+    } else if (write) {
+        vcpu->xcr0 = value;
+    } else {
+        value = offset ? *vmcb_word(vcpu, offset) : vcpu->xcr0;
+    }
+    setMR(thread, buffer, 0, value);
+    if (!write) {
+        setRegister(thread, msgInfoRegister, wordFromMessageInfo(seL4_MessageInfo_new(0, 0, 0, 1)));
+    }
+    setThreadState(thread, ThreadState_Restart);
+    return EXCEPTION_NONE;
+}
+#endif /* CONFIG_X86_64_VTX_64BIT_GUESTS */
+
+/*
+ * A VCPU whose thread is in guest mode on another core leaves it there, as
+ * switchVCPU() makes it on VT-x, before an invocation reads or writes it:
+ * the CPU owns a VMCB during VMRUN, and the exit path writes the VCPU
+ * before it takes the kernel lock.  That core then waits for the lock.
+ * svm_make_current() records the VCPU there before that core releases the
+ * lock to enter guest mode, so none is missed.
+ */
+void svm_claim_vcpu(vcpu_t *vcpu)
+{
+#ifdef ENABLE_SMP_SUPPORT
+    if (vcpu->last_cpu != getCurrentCPUIndex() &&
+        ARCH_NODE_STATE_ON_CORE(x86KSCurrentVCPU, vcpu->last_cpu) == vcpu) {
+        doRemoteClearCurrentVCPU(vcpu->last_cpu);
+    }
+#endif
+}
+
+exception_t svm_decodeVCPUInvocation(word_t invLabel, word_t length, cap_t cap,
+                                     bool_t call, word_t *buffer)
+{
+    svm_claim_vcpu(VCPU_PTR(cap_vcpu_cap_get_capVCPUPtr(cap)));
+    switch (invLabel) {
+    case X86VCPUReadVMCB:
+        return decodeReadVMCB(cap, length, call, buffer);
+    case X86VCPUWriteVMCB:
+        return decodeWriteVMCB(cap, length, call, buffer);
+#ifdef CONFIG_X86_64_VTX_64BIT_GUESTS
+    case X86VCPUWriteMSR:
+        return decodeSVMMSR(cap, length, true, buffer);
+    case X86VCPUReadMSR:
+        return decodeSVMMSR(cap, length, false, buffer);
+#endif /* CONFIG_X86_64_VTX_64BIT_GUESTS */
+    default:
+        userError("VCPU: Illegal operation on an AMD CPU.");
+        current_syscall_error.type = seL4_IllegalOperation;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+}
+
+void svm_update_state_sysvmenter(vcpu_t *vcpu, word_t *buffer)
+{
+    uint32_t misc1;
+    uint32_t intr;
+
+    vcpu->exit_info_valid = false;
+    *vmcb_word(vcpu, VMCB_RIP) = getSyscallArg(0, buffer);
+    misc1 = (getSyscallArg(1, buffer) & (SVM_I1_WRITABLE)) | SVM_I1_FORCED;
+    if (misc1 != *vmcb_u32(vcpu, VMCB_INTERCEPT_MISC1)) {
+        *vmcb_u32(vcpu, VMCB_INTERCEPT_MISC1) = misc1;
+        vcpu->svm.dirty |= VMCB_CLEAN_I;
+    }
+    vcpu->ppc = misc1;
+    intr = getSyscallArg(2, buffer) & (uint32_t)SVM_EVENT_INJ_WRITABLE;
+    *vmcb_u32(vcpu, VMCB_EVENT_INJ) = intr;
+    vcpu->entry_intr = intr;
+}
+
+/* The VMEnter MRs (see vmenter.h): the VT-x layout, with SVM's fields. */
+static void svm_setMRs(tcb_t *tcb, vcpu_t *vcpu, word_t reason, word_t qualification)
+{
+    word_t *buffer = lookupIPCBuffer(true, tcb);
+    bool_t exited = vcpu->exit_info_valid;
+    word_t i;
+
+    setMR(tcb, buffer, SEL4_VMENTER_CALL_EIP_MR, *vmcb_word(vcpu, VMCB_RIP));
+    setMR(tcb, buffer, SEL4_VMENTER_CALL_CONTROL_PPC_MR, vcpu->ppc);
+    setMR(tcb, buffer, SEL4_VMENTER_CALL_INTERRUPT_INFO_MR, vcpu->entry_intr);
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_REASON_MR, reason);
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_QUALIFICATION_MR, qualification);
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_INSTRUCTION_LEN_MR, exited ? vcpu->svm.instr_len : 0);
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_GUEST_PHYSICAL_MR,
+          exited ? *vmcb_word(vcpu, VMCB_EXIT_INFO2) : 0);
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_RFLAGS_MR, *vmcb_word(vcpu, VMCB_RFLAGS));
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_GUEST_INT_MR, *vmcb_u32(vcpu, VMCB_INT_STATE));
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_CR3_MR, *vmcb_word(vcpu, VMCB_CR3));
+    for (i = 0; i < n_vcpu_gp_register; i++) {
+        setMR(tcb, buffer, SEL4_VMENTER_FAULT_EAX + i, vcpu->gp_registers[i]);
+    }
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_EXIT_INTR_INFO, 0);
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_EXIT_INTR_ERROR, 0);
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_IDT_VECTOR_INFO,
+          exited ? *vmcb_u32(vcpu, VMCB_EXIT_INT_INFO) : 0);
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_IDT_VECTOR_ERROR,
+          exited ? *vmcb_u32(vcpu, VMCB_EXIT_INT_INFO + 4) : 0);
+    setMR(tcb, buffer, SEL4_VMENTER_FAULT_CR2, *vmcb_word(vcpu, VMCB_CR2));
+}
+
+void svm_reply_to_user(tcb_t *tcb, vcpu_t *vcpu)
+{
+    svm_setMRs(tcb, vcpu, SVM_EXIT_INTR, 0);
+}
+
+/* With the kernel lock, after an exit: a notification, SetTCB or the VCPU's
+ * deletion on another core, while this one waited for the lock, may have
+ * ended the VMEnter (dissociateVcpuTcb()), and the guest then repeats what
+ * exited when it next runs. */
+static bool_t svm_vmenter_ended(void)
+{
+    return thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState) != ThreadState_RunningVM;
+}
+
+static void svm_fault(word_t reason, word_t qualification)
+{
+    tcb_t *thread = NODE_STATE(ksCurThread);
+
+    if (svm_vmenter_ended()) {
+        return;
+    }
+    setRegister(thread, msgInfoRegister, SEL4_VMENTER_RESULT_FAULT);
+    svm_setMRs(thread, thread->tcbArch.tcbVCPU, reason, qualification);
+    setThreadState(thread, ThreadState_Running);
+    activateThread();
+}
+
+exception_t svm_handle_exit(void)
+{
+    vcpu_t *vcpu = NODE_STATE(ksCurThread)->tcbArch.tcbVCPU;
+    uint64_t code = *vmcb_word(vcpu, VMCB_EXIT_CODE);
+    word_t next_rip = *vmcb_word(vcpu, VMCB_NEXT_RIP);
+
+    assert(vcpu == ARCH_NODE_STATE(x86KSCurrentVCPU));
+    ARCH_NODE_STATE(x86KSSVMNMIWindow) = false;
+    vcpu_load_host_xcr0(vcpu);
+    vcpu->gp_registers[VCPU_EAX] = *vmcb_word(vcpu, VMCB_RAX);
+    /* A VMRUN that failed its checks may not have loaded what changed, so
+     * it stays dirty for the next one, as the ASID flush does. */
+    if (code != SVM_EXIT_INVALID) {
+        vcpu->svm.dirty = 0;
+    }
+    vcpu->svm.instr_len = next_rip ? next_rip - *vmcb_word(vcpu, VMCB_RIP) : 0;
+    *vmcb_word(vcpu, VMCB_NEXT_RIP) = 0;
+    /* A VMRUN that failed its checks may not have flushed. */
+    if (code != SVM_EXIT_INVALID && *vmcb_u32(vcpu, VMCB_ASID + 4) == SVM_TLB_FLUSH_ALL) {
+        ARCH_NODE_STATE(x86KSSVMFlushPending) = false;
+    }
+    *vmcb_u32(vcpu, VMCB_ASID + 4) = 0;         /* TLB_CONTROL */
+    if (code != SVM_EXIT_INVALID) {
+        vcpu->launched = true;
+        vcpu->exit_info_valid = true;
+        /* The VMRUN took the event, if there was one; one it could not
+         * deliver is in EXIT_INT_INFO. */
+        *vmcb_word(vcpu, VMCB_EVENT_INJ) = 0;
+        vcpu->entry_intr &= ~BIT(31);
+    }
+
+    switch (code) {
+    case SVM_EXIT_INTR:
+        NODE_LOCK_IRQ;
+        receivePendingIRQ();
+#ifdef ENABLE_SMP_SUPPORT
+        VMCheckBoundNotification(NODE_STATE(ksCurThread));
+#endif
+        return EXCEPTION_NONE;
+    case SVM_EXIT_NMI:
+    case SVM_EXIT_SMI:
+    case SVM_EXIT_INIT:
+        /* The host took it at STGI (restore_svm()): just go on. */
+        NODE_LOCK_IRQ;
+#ifdef ENABLE_SMP_SUPPORT
+        VMCheckBoundNotification(NODE_STATE(ksCurThread));
+#endif
+        return EXCEPTION_NONE;
+    case SVM_EXIT_SHUTDOWN:
+        /* The guest state is undefined after a shutdown (APM 15.11). */
+        NODE_LOCK_SYS;
+        if (svm_vmenter_ended()) {
+            /* The VCPU may be gone: it is reset when it next shuts down. */
+            return EXCEPTION_NONE;
+        }
+        svm_reset_save_area(vcpu);
+        svm_fault(code, 0);
+        return EXCEPTION_NONE;
+    case SVM_EXIT_INVALID:
+        NODE_LOCK_SYS;
+        svm_fault(0xffffffff, 0);
+        return EXCEPTION_NONE;
+    default:
+        NODE_LOCK_SYS;
+        svm_fault(code, *vmcb_word(vcpu, VMCB_EXIT_INFO1));
+        return EXCEPTION_NONE;
+    }
+}
+
+/* Every VCPU takes a new ASID before it next runs on this core. */
+void svm_invalidate_local(void)
+{
+    ARCH_NODE_STATE(x86KSSVMASIDGen)++;
+}
+
+static void svm_assign_asid(vcpu_t *vcpu)
+{
+    word_t cpu = CURRENT_CPU_INDEX();
+
+    if (vcpu->svm.asid_cpu == cpu && vcpu->svm.asid_gen == ARCH_NODE_STATE(x86KSSVMASIDGen)) {
+        return;
+    }
+    if (ARCH_NODE_STATE(x86KSSVMNextASID) >= svm_nasid) {
+        /* Out of ASIDs: start again, with a flush of them all. */
+        ARCH_NODE_STATE(x86KSSVMASIDGen)++;
+        ARCH_NODE_STATE(x86KSSVMNextASID) = 1;
+        ARCH_NODE_STATE(x86KSSVMFlushPending) = true;
+    }
+    vcpu->svm.asid = ARCH_NODE_STATE(x86KSSVMNextASID)++;
+    vcpu->svm.asid_gen = ARCH_NODE_STATE(x86KSSVMASIDGen);
+    vcpu->svm.asid_cpu = cpu;
+    *vmcb_u32(vcpu, VMCB_ASID) = vcpu->svm.asid;
+    vcpu->svm.dirty |= VMCB_CLEAN_ASID;
+}
+
+static void svm_set_npt_root(cap_t root, vcpu_t *vcpu)
+{
+    paddr_t npt_root = kpptr_to_paddr(null_ept_space);
+
+    if (cap_get_capType(root) == cap_ept_pml4_cap && cap_ept_pml4_cap_get_capPML4IsMapped(root)) {
+        ept_pml4e_t *pml4 = (ept_pml4e_t *)cap_ept_pml4_cap_get_capPML4BasePtr(root);
+        findEPTForASID_ret_t find_ret = findEPTForASID(cap_ept_pml4_cap_get_capPML4MappedASID(root));
+        if (find_ret.status == EXCEPTION_NONE && find_ret.ept == pml4) {
+            npt_root = pptr_to_paddr(pml4);
+        }
+    }
+    if (npt_root != vcpu->last_ept_root) {
+        vcpu->last_ept_root = npt_root;
+        *vmcb_word(vcpu, VMCB_NESTED_CR3) = npt_root;
+        vcpu->svm.dirty |= VMCB_CLEAN_NP;
+        /* The ASID holds translations of the old root. */
+        vcpu->svm.asid_gen = 0;
+    }
+}
+
+/* vcpu_make_current() on AMD, with the kernel lock held. */
+void svm_make_current(vcpu_t *vcpu)
+{
+    word_t cpu = CURRENT_CPU_INDEX();
+
+    /* The CPU may have kept fields of this VMCB from its last VMRUN here,
+     * and only here. */
+    if (ARCH_NODE_STATE(x86KSCurrentVCPU) != vcpu || vcpu->svm.last_cpu != cpu) {
+        vcpu->svm.dirty = VMCB_CLEAN_ALL;
+        ARCH_NODE_STATE(x86KSCurrentVCPU) = vcpu;
+        vcpu->svm.last_cpu = cpu;
+#ifdef ENABLE_SMP_SUPPORT
+        vcpu->last_cpu = cpu;
+#endif
+    }
+}
+
+void NORETURN restore_svm(tcb_t *cur_thread, vcpu_t *vcpu)
+{
+    paddr_t host = kpptr_to_paddr(&ARCH_NODE_STATE(x86KSSVMHostArea));
+    paddr_t vmcb = vmcb_paddr(vcpu);
+
+    if (!ARCH_NODE_STATE(x86KSSVMHostSaved)) {
+        /* In the kernel: GS is the kernel's, the rest is the same for any
+         * thread, and the user's FS and GS bases are reloaded on exit. */
+        svm_vmsave(host);
+        ARCH_NODE_STATE(x86KSSVMHostSaved) = true;
+    }
+    /* vcpu_make_current() did, before the kernel lock was released. */
+    assert(ARCH_NODE_STATE(x86KSCurrentVCPU) == vcpu && vcpu->svm.last_cpu == CURRENT_CPU_INDEX());
+    svm_set_npt_root(TCB_PTR_CTE_PTR(cur_thread, tcbArchEPTRoot)->cap, vcpu);
+    svm_assign_asid(vcpu);
+    /* Until a VMRUN has done it, every entry here flushes. */
+    if (ARCH_NODE_STATE(x86KSSVMFlushPending)) {
+        *vmcb_u32(vcpu, VMCB_ASID + 4) = SVM_TLB_FLUSH_ALL;
+    }
+#ifdef CONFIG_HARDWARE_DEBUG_API
+    /* As restore_vmx(): no breakpoints in VMs. */
+    loadVMBreakpointState(cur_thread);
+#endif
+    vcpu_load_guest_xcr0(vcpu);
+    /* int_ctl is the guest's too (V_TPR, V_IRQ). */
+    *vmcb_u32(vcpu, VMCB_CLEAN) = svm_has_clean_bits ?
+                                  VMCB_CLEAN_ALL & ~(vcpu->svm.dirty | VMCB_CLEAN_INTR) : 0;
+#ifdef ENABLE_SMP_SUPPORT
+    /* As in restoreVMCS(): invept() then reaches this core. */
+    __atomic_fetch_or(&x86KSVMXCores, BIT(CURRENT_CPU_INDEX()), __ATOMIC_SEQ_CST);
+#endif
+    *vmcb_word(vcpu, VMCB_RAX) = vcpu->gp_registers[VCPU_EAX];
+    vcpu->svm.host_area = host;
+    /* From here to svm_handle_exit() a host NMI is held, then taken on the
+     * kernel stack, where it is ignored (handleKernelException()). */
+    ARCH_NODE_STATE(x86KSSVMNMIWindow) = true;
+
+    asm volatile(
+        /* No interrupt or NMI until the host state is back.  With
+         * V_INTR_MASKING, the host IF at VMRUN decides whether a host
+         * interrupt ends guest mode, so IF is set here, with GIF clear: an
+         * STI just before VMRUN would leave its shadow in the guest's
+         * INT_STATE if an exit came while delivering EVENTINJ (as upstream
+         * KVM found, be45bc4eff33). */
+        "clgi\n"
+        "sti\n"
+        "movq %[regs], %%rsp\n"
+        "popq %%rbx\n"
+        "popq %%rcx\n"
+        "popq %%rdx\n"
+        "popq %%rsi\n"
+        "popq %%rdi\n"
+        "popq %%rbp\n"
+        "popq %%r8\n"
+        "popq %%r9\n"
+        "popq %%r10\n"
+        "popq %%r11\n"
+        "popq %%r12\n"
+        "popq %%r13\n"
+        "popq %%r14\n"
+        "popq %%r15\n"
+        "vmload %%rax\n"
+        "vmrun %%rax\n"
+        "cli\n"
+        "pushq %%r15\n"
+        "pushq %%r14\n"
+        "pushq %%r13\n"
+        "pushq %%r12\n"
+        "pushq %%r11\n"
+        "pushq %%r10\n"
+        "pushq %%r9\n"
+        "pushq %%r8\n"
+        "pushq %%rbp\n"
+        "pushq %%rdi\n"
+        "pushq %%rsi\n"
+        "pushq %%rdx\n"
+        "pushq %%rcx\n"
+        "pushq %%rbx\n"
+        "vmsave %%rax\n"
+        "movq %c[host_area](%%rsp), %%rax\n"
+        "vmload %%rax\n"
+        /* GS is the kernel's again: to the stack, and only then STGI, as
+         * an NMI held since the exit comes now. */
+#ifdef ENABLE_SMP_SUPPORT
+        "movq %%gs:%c[stack_offset], %%rsp\n"
+#else
+        "leaq kernel_stack_alloc + %c[stack_size], %%rsp\n"
+#endif
+        "stgi\n"
+        "call c_handle_vmexit\n"
+        :
+        : "a"(vmcb), [regs]"r"(&vcpu->gp_registers[VCPU_EAX + 1]),
+        [stack_size]"i"(BIT(CONFIG_KERNEL_STACK_BITS)),
+        [host_area]"i"(OFFSETOF(vcpu_t, svm.host_area) - OFFSETOF(vcpu_t, gp_registers[VCPU_EAX + 1]))
+#ifdef ENABLE_SMP_SUPPORT
+        , [stack_offset]"i"(OFFSETOF(nodeInfo_t, stackTop))
+#endif
+        : "memory", "cc"
+    );
+    UNREACHABLE();
+}
