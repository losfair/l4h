From c07b441203ac26422fa0c8beb60c285de894a198 Mon Sep 17 00:00:00 2001
From: l4h <z@univalence.me>
Date: Sun, 18 Oct 2026 00:54:31 -0700
Subject: [PATCH] x86: request the configured linear graphics mode in the
 multiboot2 header

KernelMultibootGFXMode only affected the multiboot1 header, so a
multiboot2 boot loader (GRUB on UEFI) never set up or reported a
framebuffer, although boot_sys.c reads the multiboot2 framebuffer tag
and passes it to the root task. Add an optional framebuffer request tag
with the configured width, height and depth.
---
 src/arch/x86/multiboot.S | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/arch/x86/multiboot.S b/src/arch/x86/multiboot.S
index 714a91aea..bad7295ae 100644
--- a/src/arch/x86/multiboot.S
+++ b/src/arch/x86/multiboot.S
@@ -66,6 +66,16 @@
     .long   0x0
     .long   (__mbi2_end - __mbi2_start)
     .long  -(0xe85250d6 + (__mbi2_end - __mbi2_start))
+#ifdef CONFIG_MULTIBOOT_GRAPHICS_MODE_LINEAR
+    /* framebuffer tag - type, flags (optional), size, width, height, depth */
+    .word   0x5
+    .word   0x1
+    .long   20
+    .long   CONFIG_MULTIBOOT_GRAPHICS_MODE_WIDTH
+    .long   CONFIG_MULTIBOOT_GRAPHICS_MODE_HEIGHT
+    .long   CONFIG_MULTIBOOT_GRAPHICS_MODE_DEPTH
+    .align  8
+#endif
     /* end tag - type, flags, size */
     .word   0x0
     .word   0x0
