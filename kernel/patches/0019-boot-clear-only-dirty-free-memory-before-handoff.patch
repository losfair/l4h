From 982a69b925c2d45429c2f0df3be2eea098b8fdb9 Mon Sep 17 00:00:00 2001
From: l4h <l4h@localhost>
Date: Wed, 28 Oct 2026 06:50:14 -0700
Subject: [PATCH] boot: clear only dirty free memory before handing out
 untypeds

Scan ordinary free RAM once while constructing boot untypeds, before any
user code can create cache aliases. Clear each page only if it contains
a nonzero word, preserving the hypervisor's shared zero pages. Publish
these caps with a zero free index so their first use needs no reset.

Keep device memory untouched, and leave recycled kernel boot memory at
the usual full free index: it still contains executing code and live
boot data, so it must be cleared by its first runtime retype.

Runtime untyped resets retain seL4's unconditional clearing. There is no
runtime flag or syscall that can enable the boot-only scan. Reusing RAM
after revocation, including RAM returned through free page reporting,
therefore writes zeros normally. The optimization preserves savings for
first use of boot RAM, not repeated reuse.

On ARM, wait until every secondary CPU has switched from the loader
translation tables to the kernel tables before clearing free RAM. The
loader tables themselves live in that RAM. Finish constructing untypeds
and bootinfo under the BKL, before the initial thread can run.
---
 src/arch/arm/kernel/boot.c | 37 ++++++++++++-------------
 src/kernel/boot.c          | 56 ++++++++++++++++++++++++++++++++------
 2 files changed, 65 insertions(+), 28 deletions(-)

diff --git a/src/arch/arm/kernel/boot.c b/src/arch/arm/kernel/boot.c
index 467a7bd98..f770dcb48 100644
--- a/src/arch/arm/kernel/boot.c
+++ b/src/arch/arm/kernel/boot.c
@@ -631,24 +631,10 @@ static BOOT_CODE bool_t try_init_kernel(
 
     init_core_state(initial);
 
-    /* create all of the untypeds. Both devices and kernel window memory */
-    if (!create_untypeds(root_cnode_cap)) {
-        printf("ERROR: could not create untypteds for kernel image boot memory\n");
-        return false;
-    }
-
     /* no shared-frame caps (ARM has no multikernel support) */
     ndks_boot.bi_frame->sharedFrames = S_REG_EMPTY;
 
-    /* finalise the bootinfo frame */
-    bi_finalise();
-
-    /* Flushing the L1 cache and invalidating the TLB is good enough here to
-     * make sure everything written by the kernel is visible to userland. There
-     * are no uncached userland frames at this stage that require enforcing
-     * flushing to RAM. Any retyping operation will clean the memory down to RAM
-     * anyway.
-     */
+    /* Publish the initialized kernel state before starting secondary CPUs. */
     cleanInvalidateL1Caches();
     invalidateLocalTLB();
     if (config_set(CONFIG_ARM_HYPERVISOR_SUPPORT)) {
@@ -661,13 +647,24 @@ static BOOT_CODE bool_t try_init_kernel(
     SMP_COND_STATEMENT(clh_lock_init());
     SMP_COND_STATEMENT(release_secondary_cpus());
 
-    /* All cores are up now, so there can be concurrency. The kernel booting is
-     * supposed to be finished before the secondary cores are released, all the
-     * primary has to do now is schedule the initial thread. Currently there is
-     * nothing that touches any global data structures, nevertheless we grab the
-     * BKL here to play safe. It is released when the kernel is left. */
+    /* All cores now use the kernel's translation tables. Before this point,
+     * secondary cores still need the loader's tables, which reside in free
+     * RAM. Creating untypeds clears that RAM, so it must wait until now.
+     * Hold the BKL while finishing boot; the initial thread only runs after
+     * this function returns. The lock is released when the kernel is left. */
     NODE_LOCK_SYS;
 
+    /* create all of the untypeds. Both devices and kernel window memory */
+    if (!create_untypeds(root_cnode_cap)) {
+        printf("ERROR: could not create untypteds for kernel image boot memory\n");
+        return false;
+    }
+
+    /* Finalise bootinfo and publish it, together with the cleared RAM,
+     * before the initial thread can access either. */
+    bi_finalise();
+    cleanInvalidateL1Caches();
+
     printf("Booting all finished, dropped to user space\n");
 
     /* kernel successfully initialized */
diff --git a/src/kernel/boot.c b/src/kernel/boot.c
index 412e1b1db..7e1982959 100644
--- a/src/kernel/boot.c
+++ b/src/kernel/boot.c
@@ -650,6 +650,31 @@ BOOT_CODE static bool_t pptr_in_kernel_window(pptr_t pptr)
     return pptr >= PPTR_BASE && pptr < PPTR_TOP;
 }
 
+/* Initialise unused RAM before user code can create aliases of it. Reading
+ * first preserves a hypervisor's shared zero pages; only dirty pages need
+ * backing memory. All CPUs must have stopped using the loader's memory.
+ * This must never be used to reset memory after handoff. */
+BOOT_CODE static void clear_boot_memory(pptr_t pptr, word_t bits)
+{
+    word_t step_bits = MIN(bits, (word_t)seL4_PageBits);
+    word_t step = BIT(step_bits);
+
+    for (word_t off = 0; off < BIT(bits); off += step) {
+        word_t *p = WORD_PTR(pptr + off);
+#ifdef CONFIG_ARCH_ARM
+        /* Account for cache state inherited from the boot environment. */
+        cleanInvalidateCacheRange_RAM((word_t)p, (word_t)p + step - 1,
+                                      addrFromPPtr(p));
+#endif
+        for (word_t i = 0; i < step / sizeof(word_t); i++) {
+            if (p[i] != 0) {
+                clearMemory(p, step_bits);
+                break;
+            }
+        }
+    }
+}
+
 /**
  * Create an untyped cap, store it in a cnode and mark it in boot info.
  *
@@ -658,6 +683,7 @@ BOOT_CODE static bool_t pptr_in_kernel_window(pptr_t pptr)
  *
  * @param root_cnode_cap cap to the cnode to store the untyped cap in
  * @param device_memory true if the cap to create is a device untyped
+ * @param clear_memory true only for unused RAM that can be cleared now
  * @param pptr the kernel-virtual address of the untyped
  * @param size_bits the size of the untyped in bits
  * @param first_untyped_slot next available slot in the boot info structure
@@ -666,6 +692,7 @@ BOOT_CODE static bool_t pptr_in_kernel_window(pptr_t pptr)
 BOOT_CODE static bool_t provide_untyped_cap(
     cap_t      root_cnode_cap,
     bool_t     device_memory,
+    bool_t     clear_memory,
     pptr_t     pptr,
     word_t     size_bits,
     seL4_SlotPos first_untyped_slot
@@ -673,6 +700,7 @@ BOOT_CODE static bool_t provide_untyped_cap(
 {
     bool_t ret;
     cap_t ut_cap;
+    assert(!clear_memory || !device_memory);
 
     /* Since we are in boot code, we can do extensive error checking and
        return failure if anything unexpected happens. */
@@ -713,7 +741,14 @@ BOOT_CODE static bool_t provide_untyped_cap(
             .isDevice = device_memory,
             .padding  = {0}
         };
-        ut_cap = cap_untyped_cap_new(MAX_FREE_INDEX(size_bits),
+        word_t free_index = MAX_FREE_INDEX(size_bits);
+        if (clear_memory) {
+            clear_boot_memory(pptr, size_bits);
+            /* First use can start immediately; later resets retain the
+             * normal watermark and unconditional clearing semantics. */
+            free_index = 0;
+        }
+        ut_cap = cap_untyped_cap_new(free_index,
                                      device_memory, size_bits, pptr);
         ret = provide_cap(root_cnode_cap, ut_cap);
     } else {
@@ -734,6 +769,7 @@ BOOT_CODE static bool_t provide_untyped_cap(
  *
  * @param root_cnode_cap Cap to the CNode to store the untypeds in.
  * @param device_memory  Whether the region is device memory.
+ * @param clear_memory  Clear unused RAM now, never devices or live boot memory.
  * @param reg Region of kernel-virtual memory. May wrap around.
  * @param first_untyped_slot First available untyped boot info slot.
  * @return true on success, false on failure.
@@ -741,6 +777,7 @@ BOOT_CODE static bool_t provide_untyped_cap(
 BOOT_CODE static bool_t create_untypeds_for_region(
     cap_t      root_cnode_cap,
     bool_t     device_memory,
+    bool_t     clear_memory,
     region_t   reg,
     seL4_SlotPos first_untyped_slot
 )
@@ -775,7 +812,8 @@ BOOT_CODE static bool_t create_untypeds_for_region(
          * be used anyway.
          */
         if (size_bits >= seL4_MinUntypedBits) {
-            if (!provide_untyped_cap(root_cnode_cap, device_memory, reg.start, size_bits, first_untyped_slot)) {
+            if (!provide_untyped_cap(root_cnode_cap, device_memory, clear_memory,
+                                     reg.start, size_bits, first_untyped_slot)) {
                 return false;
             }
         }
@@ -794,7 +832,7 @@ BOOT_CODE bool_t create_untypeds(cap_t root_cnode_cap)
             region_t reg = paddr_to_pptr_reg((p_region_t) {
                 start, ndks_boot.reserved[i].start
             });
-            if (!create_untypeds_for_region(root_cnode_cap, true, reg, first_untyped_slot)) {
+            if (!create_untypeds_for_region(root_cnode_cap, true, false, reg, first_untyped_slot)) {
                 printf("ERROR: creation of untypeds for device region #%u at"
                        " [%"SEL4_PRIx_word"..%"SEL4_PRIx_word") failed\n",
                        (unsigned int)i, reg.start, reg.end);
@@ -812,7 +850,7 @@ BOOT_CODE bool_t create_untypeds(cap_t root_cnode_cap)
             start, (paddr_t) CONFIG_PADDR_USER_DEVICE_TOP
         });
 
-        if (!create_untypeds_for_region(root_cnode_cap, true, reg, first_untyped_slot)) {
+        if (!create_untypeds_for_region(root_cnode_cap, true, false, reg, first_untyped_slot)) {
             printf("ERROR: creation of untypeds for top device region"
                    " [%"SEL4_PRIx_word"..%"SEL4_PRIx_word") failed\n",
                    reg.start, reg.end);
@@ -822,21 +860,23 @@ BOOT_CODE bool_t create_untypeds(cap_t root_cnode_cap)
 
     /* There is a part of the kernel (code/data) that is only needed for the
      * boot process. We can create UT objects for these frames, so the memory
-     * can be reused.
+     * can be reused. It is still executing, so defer its clearing until
+     * the first retype instead of clearing it during boot.
      */
     region_t boot_mem_reuse_reg = paddr_to_pptr_reg(get_p_reg_kernel_img_boot());
-    if (!create_untypeds_for_region(root_cnode_cap, false, boot_mem_reuse_reg, first_untyped_slot)) {
+    if (!create_untypeds_for_region(root_cnode_cap, false, false, boot_mem_reuse_reg, first_untyped_slot)) {
         printf("ERROR: creation of untypeds for recycled boot memory"
                " [%"SEL4_PRIx_word"..%"SEL4_PRIx_word"] failed\n",
                boot_mem_reuse_reg.start, boot_mem_reuse_reg.end);
         return false;
     }
 
-    /* convert remaining freemem into UT objects and provide the caps */
+    /* Clear ordinary free RAM once, before user code runs, and hand it
+     * out with a zero free index so first use does not clear it again. */
     for (word_t i = 0; i < ARRAY_SIZE(ndks_boot.freemem); i++) {
         region_t reg = ndks_boot.freemem[i];
         ndks_boot.freemem[i] = REG_EMPTY;
-        if (!create_untypeds_for_region(root_cnode_cap, false, reg, first_untyped_slot)) {
+        if (!create_untypeds_for_region(root_cnode_cap, false, true, reg, first_untyped_slot)) {
             printf("ERROR: creation of untypeds for free memory region #%u at"
                    " [%"SEL4_PRIx_word"..%"SEL4_PRIx_word") failed\n",
                    (unsigned int)i, reg.start, reg.end);
-- 
