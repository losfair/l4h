+        BIT(10) |   //MWAIT exiting
+        BIT(11) |   //RDPMC exiting: the counters are not switched
+        BIT(23) |   //MOV-DR exiting: neither are the debug registers
         BIT(25) |   //Use I/O bitmaps
         BIT(28) |   //Use MSR bitmaps
