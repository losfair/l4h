+#endif
 
     /* Currently assigned VPID */
     vpid_t vpid;
@@ -364,6 +394,7 @@ void vcpu_init(vcpu_t *vcpu);
 
 /* Cleans up the VCPU object such that its memory can be freed */
 void vcpu_finalise(vcpu_t *vcpu);
+void vcpu_tcb_delete(tcb_t *tcb);
 
 exception_t decodeX86VCPUInvocation(
     word_t invLabel,
@@ -394,6 +425,22 @@ void VMCheckBoundNotification(tcb_t *tcb);
 #endif /* ENABLE_SMP_SUPPORT */
 
 void invept(ept_pml4e_t *ept_pml4);
+bool_t eptInveptAllSupported(void);
+/* The CPU can page with 5 levels (CPUID.7.0:ECX.LA57). */
+extern bool_t x86KSVCPULA57;
+
+/* An address in an MSR as the CPU checks it: canonical in 57 bits when it
+ * can page with 5 levels, as a guest may then (CR4.LA57). */
+static inline bool_t vcpu_canonical(uint64_t v)
+{
+    int bits = x86KSVCPULA57 ? 57 : 48;
+    return (uint64_t)(((int64_t)v << (64 - bits)) >> (64 - bits)) == v;
+}
+
+void vcpu_make_current(vcpu_t *vcpu);
+void vcpu_load_guest_xcr0(vcpu_t *vcpu);
+void vcpu_load_host_xcr0(vcpu_t *vcpu);
+void invalidateLocalEPT(ept_pml4e_t *ept_pml4);
 
 /* Removes any IO port mappings that have been cached for the given VPID */
 void clearVPIDIOPortMappings(vpid_t vpid, uint16_t first, uint16_t last);
