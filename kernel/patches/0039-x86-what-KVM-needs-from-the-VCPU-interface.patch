diff --git a/include/arch/x86/arch/machine/debug.h b/include/arch/x86/arch/machine/debug.h
index 1d01b65f0..15eb556bd 100644
--- a/include/arch/x86/arch/machine/debug.h
+++ b/include/arch/x86/arch/machine/debug.h
@@ -83,6 +83,16 @@ static void loadAllDisabledBreakpointState(tcb_t *t)
     writeDr7Reg(disable_value);
 }
 
+/* Before a VM entry: a guest DR7 (WriteVMCS) could enable breakpoints on
+ * the addresses another thread left in DR0-3, which nothing switches. */
+static inline void loadVMBreakpointState(tcb_t *t)
+{
+    loadAllDisabledBreakpointState(t);
+    for (int i = 0; i < X86_DEBUG_BP_N_REGS; i++) {
+        writeDrReg(i, 0);
+    }
+}
+
