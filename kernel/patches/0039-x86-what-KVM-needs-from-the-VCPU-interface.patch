diff --git a/src/arch/x86/object/vcpu.c b/src/arch/x86/object/vcpu.c
index 92dd1df..0f3b99b 100644
--- a/src/arch/x86/object/vcpu.c
+++ b/src/arch/x86/object/vcpu.c
@@ -49,6 +49,23 @@ static msr_bitmaps_t msr_bitmap_region ALIGN(BIT(seL4_PageBits));
 
 static char null_ept_space[BIT(seL4_PageBits)] ALIGN(BIT(seL4_PageBits));
 
+/*
+ * The VM-execution, exit and entry controls that userspace may turn on.  Any
+ * guest can hold a VCPU, and a control left out here would use a VMCS address
+ * field that nothing sets: zero, host physical page 0 (TPR shadow, virtual
+ * APIC, posted interrupts, the PML log, VMCS shadowing, #VE).
+ */
+#define PIN_CONTROLS_ALLOWED (BIT(0) | BIT(3) | BIT(5))
+#define PRIMARY_CONTROLS_ALLOWED \
+    (BIT(2) | BIT(3) | BIT(7) | BIT(9) | BIT(10) | BIT(11) | BIT(12) | BIT(15) | \
+     BIT(16) | BIT(19) | BIT(20) | BIT(22) | BIT(23) | BIT(24) | BIT(25) | BIT(27) | \
+     BIT(28) | BIT(29) | BIT(30) | BIT(31))
+#define SECONDARY_CONTROLS_ALLOWED \
+    (BIT(1) | BIT(2) | BIT(3) | BIT(5) | BIT(6) | BIT(7) | BIT(11) | BIT(12) | BIT(16))
+#define EXIT_CONTROLS_ALLOWED \
+    (BIT(2) | BIT(9) | BIT(12) | BIT(15) | BIT(18) | BIT(19) | BIT(20) | BIT(21))
+#define ENTRY_CONTROLS_ALLOWED (BIT(2) | BIT(9) | BIT(13) | BIT(14) | BIT(15))
+
 /* Cached value of the hardware defined vmcs revision */
 static uint32_t vmcs_revision;
 
@@ -78,6 +95,9 @@ static bool_t vmx_feature_vpid;
 static bool_t vmx_feature_load_perf_global_ctrl;
 static bool_t vmx_feature_ack_on_exit;
 
+/* Cores that have entered a VM.  Only they can hold EPT translations. */
+static word_t x86KSVMXCores;
+
 static vcpu_t *x86KSVPIDTable[VPID_LAST + 1];
 static vpid_t x86KSNextVPID = VPID_FIRST;
 
@@ -244,8 +264,12 @@ static bool_t BOOT_CODE init_vtx_fixed_values(bool_t useTrueMsrs)
         BIT(3) |    //NMI exiting
         BIT(5);     //virtual NMIs
     uint32_t primary_control_mask =
+        BIT(10) |   //MWAIT exiting
+        BIT(11) |   //RDPMC exiting: the counters are not switched
+        BIT(23) |   //MOV-DR exiting: neither are the debug registers
         BIT(25) |   //Use I/O bitmaps
         BIT(28) |   //Use MSR bitmaps
+        BIT(29) |   //MONITOR exiting
         BIT(31);    //Activate secondary controls
     uint32_t secondary_control_mask =
         BIT(1);     //Enable EPT
@@ -440,11 +464,18 @@ static inline uint32_t applyFixedBits(uint32_t original, uint32_t high, uint32_t
     return original;
 }
 
+static inline uint32_t applyPrimaryControls(uint32_t value)
+{
+    return applyFixedBits(value, primary_control_high,
+                          primary_control_low & (primary_control_high | PRIMARY_CONTROLS_ALLOWED));
+}
+
 void vcpu_init(vcpu_t *vcpu)
 {
     vcpu->vcpuTCB = NULL;
     vcpu->launched = false;
     vcpu->fpu_active = false;
+    vcpu->exit_info_valid = false;
     vcpu->fpuState = x86KSnullFpuState;
 
     memcpy(vcpu->vmcs, &vmcs_revision, 4);
@@ -519,6 +550,30 @@ void vcpu_init(vcpu_t *vcpu)
     vmwrite(VMX_GUEST_VMCS_LINK_POINTER, ~(word_t)0);
     vmwrite(VMX_GUEST_VMCS_LINK_POINTER_HIGH, ~(word_t)0);
 
+#ifdef CONFIG_X86_64_VTX_64BIT_GUESTS
+    {
+        static const uint32_t msrs[n_vcpu_guest_syscall_register] = {
+            [VCPU_STAR] = IA32_STAR_MSR, [VCPU_CSTAR] = IA32_CSTAR_MSR,
+            [VCPU_LSTAR] = IA32_LSTAR_MSR, [VCPU_SYSCALL_MASK] = IA32_FMASK_MSR,
+        };
+        for (int i = 0; i < n_vcpu_guest_syscall_register; i++) {
+            vcpu->msr_guest[i] = (vmx_msr_entry_t) {
+                .index = msrs[i], .value = vcpu->syscall_registers[i]
+            };
+            vcpu->msr_host[i] = (vmx_msr_entry_t) {
+                .index = msrs[i], .value = x86_rdmsr(msrs[i])
+            };
+        }
+        vmwrite(VMX_CONTROL_ENTRY_MSR_LOAD_ADDRESS, pptr_to_paddr(vcpu->msr_guest));
+        vmwrite(VMX_CONTROL_ENTRY_MSR_LOAD_COUNT, n_vcpu_guest_syscall_register);
+        vmwrite(VMX_CONTROL_EXIT_MSR_LOAD_ADDRESS, pptr_to_paddr(vcpu->msr_host));
+        vmwrite(VMX_CONTROL_EXIT_MSR_LOAD_COUNT, n_vcpu_guest_syscall_register);
+    }
+#endif
+    vcpu->rip_known = false;
+    vcpu->ppc = primary_control_high & primary_control_low;
+    vcpu->entry_intr = 0;
+
     memset(vcpu->io, ~(word_t)0, VCPU_IOBITMAP_SIZE);
     vmwrite(VMX_CONTROL_IOA_ADDRESS, pptr_to_paddr(vcpu->io));
     vmwrite(VMX_CONTROL_IOB_ADDRESS, pptr_to_paddr((char *)vcpu->io + (VCPU_IOBITMAP_SIZE / 2)));
@@ -601,15 +656,25 @@ static exception_t invokeWriteMSR(vcpu_t *vcpu, word_t *buffer, word_t field, wo
     switch (field) {
     case IA32_LSTAR_MSR:
         vcpu->syscall_registers[VCPU_LSTAR] = value;
+        vcpu->msr_guest[VCPU_LSTAR].value = value;
         break;
     case IA32_STAR_MSR:
         vcpu->syscall_registers[VCPU_STAR] = value;
+        vcpu->msr_guest[VCPU_STAR].value = value;
         break;
     case IA32_CSTAR_MSR:
         vcpu->syscall_registers[VCPU_CSTAR] = value;
+        vcpu->msr_guest[VCPU_CSTAR].value = value;
         break;
     case IA32_FMASK_MSR:
         vcpu->syscall_registers[VCPU_SYSCALL_MASK] = value;
+        vcpu->msr_guest[VCPU_SYSCALL_MASK].value = value;
+        break;
+    case IA32_KERNEL_GS_BASE_MSR:
+        vcpu->guest_msr_registers[VCPU_SHADOW_GS] = value;
+        break;
+    case SEL4_VCPU_MSR_CR2:
+        vcpu->cr2 = value;
         break;
     }
     setMR(thread, buffer, 0, value);
@@ -635,6 +700,8 @@ static exception_t decodeVCPUWriteMSR(cap_t cap, word_t length, word_t *buffer)
     case IA32_STAR_MSR:
     case IA32_CSTAR_MSR:
     case IA32_FMASK_MSR:
+    case IA32_KERNEL_GS_BASE_MSR:
+    case SEL4_VCPU_MSR_CR2:
         break;
     default:
         userError("VCPU WriteMSR: Invalid field %lx.", (long)field);
@@ -664,6 +731,9 @@ static exception_t invokeReadMSR(vcpu_t *vcpu, word_t field, word_t *buffer)
     case IA32_FMASK_MSR:
         value = vcpu->syscall_registers[VCPU_SYSCALL_MASK];
         break;
+    case IA32_KERNEL_GS_BASE_MSR:
+        value = vcpu->guest_msr_registers[VCPU_SHADOW_GS];
+        break;
     case IA32_VMX_MISC_MSR:
         value = x86_rdmsr(field);
         break;
@@ -689,6 +759,7 @@ static exception_t decodeVCPUReadMSR(cap_t cap, word_t length, word_t *buffer)
     case IA32_STAR_MSR:
     case IA32_CSTAR_MSR:
     case IA32_FMASK_MSR:
+    case IA32_KERNEL_GS_BASE_MSR:
     case IA32_VMX_MISC_MSR:
         break;
     default:
@@ -804,6 +875,16 @@ static exception_t invokeWriteVMCS(vcpu_t *vcpu, bool_t call, word_t *buffer, wo
     case VMX_CONTROL_CR0_READ_SHADOW:
         vcpu->cr0_shadow = vcpu->cached_cr0_shadow = value;
         break;
+    case VMX_GUEST_RIP:
+        vcpu->rip = value;
+        vcpu->rip_known = true;
+        break;
+    case VMX_CONTROL_PRIMARY_PROCESSOR_CONTROLS:
+        vcpu->ppc = value;
+        break;
+    case VMX_CONTROL_ENTRY_INTERRUPTION_INFO:
+        vcpu->entry_intr = value;
+        break;
     }
     vmwrite(field, value);
 
@@ -895,21 +976,24 @@ static exception_t decodeWriteVMCS(cap_t cap, word_t length, bool_t call, word_t
     case VMX_CONTROL_EXCEPTION_BITMAP:
     case VMX_CONTROL_ENTRY_INTERRUPTION_INFO:
     case VMX_CONTROL_ENTRY_EXCEPTION_ERROR_CODE:
+    case VMX_CONTROL_ENTRY_INSTRUCTION_LENGTH:
+    case VMX_CONTROL_TSC_OFFSET:
         break;
