--- a/src/kernel/thread.c
+++ b/src/kernel/thread.c
@@ -626,7 +626,17 @@ void setNextInterrupt(void)
        we are further subtracting getTimerPrecision(), so we may be setting a
        deadline in the past. If that is the case, we assume the IRQ will be
        raised immediately after we leave the kernel. */
-    setDeadline(next_interrupt - getTimerPrecision());
+    ticks_t deadline = next_interrupt - getTimerPrecision();
+
+    /* Deadline timers fire at their deadline, never before it (see
+       fireTimers()): the precision subtracted above is for budgets and
+       releases only. A timer that is already due sets a deadline in the
+       past, and the IRQ is raised at once. */
+    tcb_t *timer_head = NODE_STATE(ksTimerQueue);
+    if (timer_head != NULL) {
+        deadline = MIN(deadline, timer_head->tcbTimerDeadline);
+    }
+    setDeadline(deadline);
 }
 
 void chargeBudget(ticks_t consumed, bool_t canTimeoutFault)
@@ -743,8 +753,289 @@ static void tcbReleaseDequeue(void)
     possibleSwitchTo(awakened);
 }
 
+/* Armed deadline timers form a red-black tree per core, ordered by
+ * deadline, so that arming and disarming a timer take O(log n) time however
+ * many timers user level arms. ksTimerQueue caches the tree's first node. */
+
+static inline bool_t timerIsRed(tcb_t *t)
+{
+    return t != NULL && t->tcbTimerRed;
+}
+
+static void timerReplaceChild(tcb_t **root, tcb_t *parent, tcb_t *old, tcb_t *new)
+{
+    if (parent == NULL) {
+        *root = new;
+    } else if (parent->tcbTimerLeft == old) {
+        parent->tcbTimerLeft = new;
+    } else {
+        parent->tcbTimerRight = new;
+    }
+}
+
+static void timerRotateLeft(tcb_t **root, tcb_t *x)
+{
+    tcb_t *y = x->tcbTimerRight;
+    x->tcbTimerRight = y->tcbTimerLeft;
+    if (y->tcbTimerLeft) {
+        y->tcbTimerLeft->tcbTimerParent = x;
+    }
+    y->tcbTimerParent = x->tcbTimerParent;
+    timerReplaceChild(root, x->tcbTimerParent, x, y);
+    y->tcbTimerLeft = x;
+    x->tcbTimerParent = y;
+}
+
+static void timerRotateRight(tcb_t **root, tcb_t *x)
+{
+    tcb_t *y = x->tcbTimerLeft;
+    x->tcbTimerLeft = y->tcbTimerRight;
+    if (y->tcbTimerRight) {
+        y->tcbTimerRight->tcbTimerParent = x;
+    }
+    y->tcbTimerParent = x->tcbTimerParent;
+    timerReplaceChild(root, x->tcbTimerParent, x, y);
+    y->tcbTimerRight = x;
+    x->tcbTimerParent = y;
+}
+
+static void timerInsertFixup(tcb_t **root, tcb_t *z)
+{
+    tcb_t *p;
+    while ((p = z->tcbTimerParent) != NULL && p->tcbTimerRed) {
+        /* p is red, so it is not the root and g exists */
+        tcb_t *g = p->tcbTimerParent;
+        if (p == g->tcbTimerLeft) {
+            tcb_t *u = g->tcbTimerRight;
+            if (timerIsRed(u)) {
+                p->tcbTimerRed = false;
+                u->tcbTimerRed = false;
+                g->tcbTimerRed = true;
+                z = g;
+                continue;
+            }
+            if (z == p->tcbTimerRight) {
+                timerRotateLeft(root, p);
+                z = p;
+                p = z->tcbTimerParent;
+            }
+            p->tcbTimerRed = false;
+            g->tcbTimerRed = true;
+            timerRotateRight(root, g);
+        } else {
+            tcb_t *u = g->tcbTimerLeft;
+            if (timerIsRed(u)) {
+                p->tcbTimerRed = false;
+                u->tcbTimerRed = false;
+                g->tcbTimerRed = true;
+                z = g;
+                continue;
+            }
+            if (z == p->tcbTimerLeft) {
+                timerRotateRight(root, p);
+                z = p;
+                p = z->tcbTimerParent;
+            }
+            p->tcbTimerRed = false;
+            g->tcbTimerRed = true;
+            timerRotateLeft(root, g);
+        }
+    }
+    (*root)->tcbTimerRed = false;
+}
+
+/* x (possibly NULL) is one black node short on every path; parent is its
+ * parent. */
+static void timerRemoveFixup(tcb_t **root, tcb_t *x, tcb_t *parent)
+{
+    while (x != *root && !timerIsRed(x)) {
+        /* x's sibling w exists: its side has at least one black node */
+        if (x == parent->tcbTimerLeft) {
+            tcb_t *w = parent->tcbTimerRight;
+            if (w->tcbTimerRed) {
+                w->tcbTimerRed = false;
+                parent->tcbTimerRed = true;
+                timerRotateLeft(root, parent);
+                w = parent->tcbTimerRight;
+            }
+            if (!timerIsRed(w->tcbTimerLeft) && !timerIsRed(w->tcbTimerRight)) {
+                w->tcbTimerRed = true;
+                x = parent;
+                parent = x->tcbTimerParent;
+            } else {
+                if (!timerIsRed(w->tcbTimerRight)) {
+                    w->tcbTimerLeft->tcbTimerRed = false;
+                    w->tcbTimerRed = true;
+                    timerRotateRight(root, w);
+                    w = parent->tcbTimerRight;
+                }
+                w->tcbTimerRed = parent->tcbTimerRed;
+                parent->tcbTimerRed = false;
+                w->tcbTimerRight->tcbTimerRed = false;
+                timerRotateLeft(root, parent);
+                x = *root;
+            }
+        } else {
+            tcb_t *w = parent->tcbTimerLeft;
+            if (w->tcbTimerRed) {
+                w->tcbTimerRed = false;
+                parent->tcbTimerRed = true;
+                timerRotateRight(root, parent);
+                w = parent->tcbTimerLeft;
+            }
+            if (!timerIsRed(w->tcbTimerLeft) && !timerIsRed(w->tcbTimerRight)) {
+                w->tcbTimerRed = true;
+                x = parent;
+                parent = x->tcbTimerParent;
+            } else {
+                if (!timerIsRed(w->tcbTimerLeft)) {
+                    w->tcbTimerRight->tcbTimerRed = false;
+                    w->tcbTimerRed = true;
+                    timerRotateLeft(root, w);
+                    w = parent->tcbTimerLeft;
+                }
+                w->tcbTimerRed = parent->tcbTimerRed;
+                parent->tcbTimerRed = false;
+                w->tcbTimerLeft->tcbTimerRed = false;
+                timerRotateRight(root, parent);
+                x = *root;
+            }
+        }
+    }
+    if (x) {
+        x->tcbTimerRed = false;
+    }
+}
+
+void timerQueueRemove(tcb_t *tcb)
+{
+    if (tcb->tcbTimerDeadline == 0) {
+        return;
+    }
+    tcb_t **root = &NODE_STATE_ON_CORE(ksTimerRoot, tcb->tcbTimerCore);
+
+    if (NODE_STATE_ON_CORE(ksTimerQueue, tcb->tcbTimerCore) == tcb) {
+        /* The first node has no left child: its successor is the first
+         * node of its right subtree, or else its parent. */
+        tcb_t *next = tcb->tcbTimerRight;
+        if (next) {
+            while (next->tcbTimerLeft) {
+                next = next->tcbTimerLeft;
+            }
+        } else {
+            next = tcb->tcbTimerParent;
+        }
+        NODE_STATE_ON_CORE(ksTimerQueue, tcb->tcbTimerCore) = next;
+    }
+
+    tcb_t *x;
+    tcb_t *xParent;
+    bool_t removedRed = tcb->tcbTimerRed;
+    if (tcb->tcbTimerLeft == NULL || tcb->tcbTimerRight == NULL) {
+        x = tcb->tcbTimerLeft ? tcb->tcbTimerLeft : tcb->tcbTimerRight;
+        xParent = tcb->tcbTimerParent;
+        timerReplaceChild(root, xParent, tcb, x);
+        if (x) {
+            x->tcbTimerParent = xParent;
+        }
+    } else {
+        /* Put the successor y in tcb's place. */
+        tcb_t *y = tcb->tcbTimerRight;
+        while (y->tcbTimerLeft) {
+            y = y->tcbTimerLeft;
+        }
+        removedRed = y->tcbTimerRed;
+        x = y->tcbTimerRight;
+        if (y->tcbTimerParent == tcb) {
+            xParent = y;
+        } else {
+            xParent = y->tcbTimerParent;
+            xParent->tcbTimerLeft = x;
+            if (x) {
+                x->tcbTimerParent = xParent;
+            }
+            y->tcbTimerRight = tcb->tcbTimerRight;
+            y->tcbTimerRight->tcbTimerParent = y;
+        }
+        timerReplaceChild(root, tcb->tcbTimerParent, tcb, y);
+        y->tcbTimerParent = tcb->tcbTimerParent;
+        y->tcbTimerLeft = tcb->tcbTimerLeft;
+        y->tcbTimerLeft->tcbTimerParent = y;
+        y->tcbTimerRed = tcb->tcbTimerRed;
+    }
+    if (!removedRed) {
+        timerRemoveFixup(root, x, xParent);
+    }
+
+    tcb->tcbTimerParent = NULL;
+    tcb->tcbTimerLeft = NULL;
+    tcb->tcbTimerRight = NULL;
+    tcb->tcbTimerRed = false;
+    tcb->tcbTimerDeadline = 0;
+}
+
+void timerQueueInsert(tcb_t *tcb, ticks_t deadline, word_t badge)
+{
+    timerQueueRemove(tcb);
+    if (deadline == 0) {
+        return;
+    }
+
+    tcb_t **root = &NODE_STATE(ksTimerRoot);
+    tcb_t **link = root;
+    tcb_t *parent = NULL;
+    bool_t first = true;
+    while (*link != NULL) {
+        parent = *link;
+        if (deadline < parent->tcbTimerDeadline) {
+            link = &parent->tcbTimerLeft;
+        } else {
+            link = &parent->tcbTimerRight;
+            first = false;
+        }
+    }
+
+    tcb->tcbTimerDeadline = deadline;
+    tcb->tcbTimerBadge = badge;
+    tcb->tcbTimerCore = CURRENT_CPU_INDEX();
+    tcb->tcbTimerParent = parent;
+    tcb->tcbTimerLeft = NULL;
+    tcb->tcbTimerRight = NULL;
+    tcb->tcbTimerRed = true;
+    *link = tcb;
+    timerInsertFixup(root, tcb);
+
+    if (first) {
+        NODE_STATE(ksTimerQueue) = tcb;
+        NODE_STATE(ksReprogram) = true;
+    }
+}
+
+/* At most this many timers fire per kernel entry, which bounds the time
+ * the kernel spends here however many timers are due. The rest stay due:
+ * setNextInterrupt() then programs the timer to fire again at once. */
+#define TIMER_FIRE_BATCH 32
+
+static void fireTimers(void)
+{
+    for (word_t i = 0; i < TIMER_FIRE_BATCH; i++) {
+        tcb_t *tcb = NODE_STATE(ksTimerQueue);
+        if (tcb == NULL ||
+            tcb->tcbTimerDeadline > NODE_STATE(ksCurTime)) {
+            return;
+        }
+        word_t badge = tcb->tcbTimerBadge;
+        timerQueueRemove(tcb);
+        if (tcb->tcbBoundNotification) {
+            sendSignal(tcb->tcbBoundNotification, badge);
+        }
+        NODE_STATE(ksReprogram) = true;
+    }
+}
+
 void awaken(void)
 {
+    fireTimers();
     while (unlikely(release_q_non_empty_and_ready())) {
         tcbReleaseDequeue();
     }
