diff --git a/libsel4/sel4_arch_include/x86_64/sel4/sel4_arch/kexec.h b/libsel4/sel4_arch_include/x86_64/sel4/sel4_arch/kexec.h
new file mode 100644
index 000000000..035fd9563
--- /dev/null
+++ b/libsel4/sel4_arch_include/x86_64/sel4/sel4_arch/kexec.h
@@ -0,0 +1,90 @@
+/*
+ * Copyright 2026, l4h contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+/* Offsets shared with the relocatable assembly below. All addresses are physical. */
+#define SEL4_X86_KEXEC_VERSION 1
+#define SEL4_X86_KEXEC_STACK 32
+#define SEL4_X86_KEXEC_SEGMENTS 40
+#define SEL4_X86_KEXEC_SEGMENT_COUNT 48
+#define SEL4_X86_KEXEC_ENTRY 56
+#define SEL4_X86_KEXEC_MBI 64
+#define SEL4_X86_KEXEC_PARKED 72
+
+#ifndef __ASSEMBLER__
+#include <sel4/macros.h>
+
+typedef struct {
+    seL4_Word src;
+    seL4_Word dst;
+    seL4_Word len;
+} seL4_X86_KexecSegment_t;
+#define SEL4_X86_KEXEC_ZERO (~(seL4_Word)0)
+
+/*
+ * One page, owned by the caller. The caller must stop other users of these
+ * buffers, quiesce devices/DMA and disable IOMMUs before invoking Kexec.
+ *
+ * Control, trampoline, parking, stack, page tables, segment list and MBI must
+ * be in RAM below 4 GiB, outside ALL destinations. Every copy source must also
+ * miss ALL destinations (including other segments' destinations). A run with
+ * src == SEL4_X86_KEXEC_ZERO zero-fills its destination instead. The kernel
+ * trusts the IRQControl holder to supply valid RAM and code; it checks scalar
+ * arguments, not the image/plan.
+ *
+ * pml4 is a private four-level identity map covering every source, destination
+ * and control allocation. Use supervisor, writable mappings and executable
+ * trampoline/parking pages. PML4 slot 511 is reserved: the kernel fills it
+ * with its own mapping for the CR3 transition. No code may use that mapping
+ * after entering the trampoline/parking page. Page tables must survive until
+ * the new kernel starts the APs with INIT-SIPI-SIPI.
+ *
+ * Copy [seL4_X86_KexecTrampoline, seL4_X86_KexecTrampolineEnd) to trampoline,
+ * and [seL4_X86_KexecPark, seL4_X86_KexecParkEnd) to parking. Each fits in one
+ * page and needs no relocations. Alternatively supply code with the same ABI:
+ * long mode, interrupts disabled, PCID/PGE off, RDI = control physical address,
+ * RSI = logical CPU index. Parking code must acknowledge in parked only AFTER
+ * leaving all old kernel code, stack and page tables. It must never return.
+ *
+ * The supplied trampoline uses one stack page, copies or zero-fills the runs
+ * in order, and enters entry in 32-bit protected mode with paging off and the
+ * multiboot2 EAX/EBX values. The caller must match the new kernel's APIC mode
+ * to this one.
+ * Kexec neither resets devices nor measures the image. It never returns on
+ * success; errors occur before any core is stopped.
+ */
+typedef struct {
+    seL4_Word version;
+    seL4_Word pml4;
+    seL4_Word trampoline;
+    seL4_Word parking;
+    seL4_Word stack;            /* Page base, not stack top. */
+    seL4_Word segments;
+    seL4_Word segment_count;
+    seL4_Word entry;
+    seL4_Word multiboot_info;
+    seL4_Word parked;           /* Kernel clears; APs atomically set their bits. */
+} seL4_X86_KexecControl_t;
+
+SEL4_COMPILE_ASSERT(kexec_control_size, sizeof(seL4_X86_KexecControl_t) == 80);
+SEL4_COMPILE_ASSERT(kexec_segment_size, sizeof(seL4_X86_KexecSegment_t) == 24);
+#define SEL4_KEXEC_OFFSET(field, offset) \
+    SEL4_COMPILE_ASSERT(kexec_offset_##field, __builtin_offsetof(seL4_X86_KexecControl_t, field) == offset)
+SEL4_KEXEC_OFFSET(stack, SEL4_X86_KEXEC_STACK);
+SEL4_KEXEC_OFFSET(segments, SEL4_X86_KEXEC_SEGMENTS);
+SEL4_KEXEC_OFFSET(segment_count, SEL4_X86_KEXEC_SEGMENT_COUNT);
+SEL4_KEXEC_OFFSET(entry, SEL4_X86_KEXEC_ENTRY);
+SEL4_KEXEC_OFFSET(multiboot_info, SEL4_X86_KEXEC_MBI);
+SEL4_KEXEC_OFFSET(parked, SEL4_X86_KEXEC_PARKED);
+#undef SEL4_KEXEC_OFFSET
+
+extern const unsigned char seL4_X86_KexecTrampoline[], seL4_X86_KexecTrampolineEnd[];
+extern const unsigned char seL4_X86_KexecPark[], seL4_X86_KexecParkEnd[];
+
+/* The generated invocation takes an IRQControl capability and one physical address. */
+#define seL4_X86_Kexec seL4_IRQControl_Kexec
+#endif
diff --git a/libsel4/src/arch/x86_64/kexec.S b/libsel4/src/arch/x86_64/kexec.S
new file mode 100644
index 000000000..a8487a65d
--- /dev/null
+++ b/libsel4/src/arch/x86_64/kexec.S
@@ -0,0 +1,111 @@
+/*
+ * Copyright 2026, l4h contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <sel4/sel4_arch/kexec.h>
+
+/* These blobs are copied by root into separate, writable control pages.
+ * All internal references are relative; there are no link-time relocations. */
+.section .rodata.kexec,"a",@progbits
+.balign 16
+.code64
+.global seL4_X86_KexecTrampoline, seL4_X86_KexecTrampolineEnd
+seL4_X86_KexecTrampoline:
+    cli
+    cld
+    movq %rdi, %rbp
+    movq SEL4_X86_KEXEC_STACK(%rbp), %rsp
+    addq $4096, %rsp
+    movq SEL4_X86_KEXEC_SEGMENTS(%rbp), %r12
+    movq SEL4_X86_KEXEC_SEGMENT_COUNT(%rbp), %r13
+1:
+    testq %r13, %r13
+    jz 2f
+    movq 0(%r12), %rsi
+    movq 8(%r12), %rdi
+    movq 16(%r12), %rcx
+    cmpq $-1, %rsi
+    je 3f
+    rep movsb
+    jmp 4f
+3:
+    xorl %eax, %eax
+    rep stosb
+4:
+    addq $24, %r12
+    decq %r13
+    jmp 1b
+2:
+    /* Serialize instruction fetch after copying the new kernel. */
+    xorl %eax, %eax
+    cpuid
+    movl SEL4_X86_KEXEC_MBI(%rbp), %ebx
+    movl SEL4_X86_KEXEC_ENTRY(%rbp), %edi
+
+    leaq .Lkexec_gdt(%rip), %rax
+    movq %rax, .Lkexec_gdtr+2(%rip)
+    lgdt .Lkexec_gdtr(%rip)
+    movl $0x10, %eax
+    movw %ax, %ds
+    movw %ax, %es
+    movw %ax, %ss
+    movw %ax, %fs
+    movw %ax, %gs
+    leaq .Lkexec_32(%rip), %rax
+    pushq $0x08
+    pushq %rax
+    lretq
+
+.code32
+.Lkexec_32:
+    /* PCIDE was cleared before entering this blob: clearing PG while PCIDE
+     * is set would #GP. Leave IA-32e before clearing EFER.LME and CR4.PAE. */
+    movl %cr0, %eax
+    andl $0x7fffffff, %eax
+    movl %eax, %cr0
+    movl $0xc0000080, %ecx
+    rdmsr
+    andl $~(1 << 8), %eax
+    wrmsr
+    movl %cr4, %eax
+    /* GRUB leaves SMEP/SMAP clear: seL4's boot pages are user mappings.
+     * Leave PSE set for its 2 MiB pages, but leave PAE and PCIDE clear. */
+    andl $~((1 << 5) | (1 << 17) | (1 << 20) | (1 << 21)), %eax
+    orl $(1 << 4), %eax
+    movl %eax, %cr4
+    /* Multiboot2 specifies flat segments, PE=1, PG=0, IF=0 and VM=0.
+     * Other GPRs are unspecified; clear flags (including DF) explicitly. */
+    pushl $2
+    popfl
+    movl $0x36d76289, %eax
+    jmp *%edi
+
+.balign 8
+.Lkexec_gdt:
+    .quad 0
+    .quad 0x00cf9a000000ffff  /* 32-bit code, base 0, limit 4 GiB. */
+    .quad 0x00cf92000000ffff  /* 32-bit data, base 0, limit 4 GiB. */
+.Lkexec_gdtr:
+    .word 23
+    .quad 0
+seL4_X86_KexecTrampolineEnd:
+/* An oversized blob makes .org fail, even with relaxed branches. */
+.org seL4_X86_KexecTrampoline + 4096
+
+.balign 16
+.code64
+.global seL4_X86_KexecPark, seL4_X86_KexecParkEnd
+seL4_X86_KexecPark:
+    cli
+    /* No stack accesses, calls, or references to old kernel memory, including
+     * its IPI barrier. SMI/RSM resumes here under the new identity map. */
+    lock btsq %rsi, SEL4_X86_KEXEC_PARKED(%rdi)
+1:
+    hlt
+    jmp 1b
+seL4_X86_KexecParkEnd:
+.org seL4_X86_KexecPark + 4096
+
+.section .note.GNU-stack,"",@progbits
diff --git a/src/arch/x86/64/kernel/kexec.c b/src/arch/x86/64/kernel/kexec.c
new file mode 100644
index 000000000..c262b3528
--- /dev/null
+++ b/src/arch/x86/64/kernel/kexec.c
@@ -0,0 +1,108 @@
+/*
+ * Copyright 2026, l4h contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include <machine.h>
+#include <api/syscall.h>
+#include <arch/kernel/apic.h>
+#include <mode/kernel/kexec.h>
+#include <mode/machine.h>
+#include <plat/machine/ioapic.h>
+#include <plat/machine/pic.h>
+#include <sel4/sel4_arch/kexec.h>
+#include <smp/lock.h>
+
+static bool_t kexec_low_page(paddr_t paddr)
+{
+    return paddr != 0 && paddr < BIT(32) && IS_ALIGNED(paddr, seL4_PageBits);
+}
+
+static void kexec_mask_lapic(void)
+{
+    /* Keep the APIC enabled in its existing mode for the next kernel. */
+    apic_write_reg(APIC_LVT_TIMER, apic_read_reg(APIC_LVT_TIMER) | BIT(16));
+    apic_write_reg(APIC_LVT_LINT0, apic_read_reg(APIC_LVT_LINT0) | BIT(16));
+    apic_write_reg(APIC_LVT_LINT1, apic_read_reg(APIC_LVT_LINT1) | BIT(16));
+    /* EOIs retire the highest in-service vector. Drain every ISR bank. */
+    word_t stride = config_set(CONFIG_X2APIC) ? 1 : 16;
+    for (int bank = 7; bank >= 0; bank--) {
+        while (apic_read_reg(APIC_ISR_BASE + bank * stride)) {
+            apic_ack_active_interrupt();
+        }
+    }
+}
+
+void NORETURN x86KexecPark(paddr_t control)
+{
+    seL4_X86_KexecControl_t *c = paddr_to_pptr(control);
+    kexec_mask_lapic();
+    x86KexecEnter(control, c->parking, c->pml4, CURRENT_CPU_INDEX());
+}
+
+exception_t decodeX86Kexec(word_t length, word_t *buffer)
+{
+    /* Check the core before touching caller-supplied physical memory. */
+    if (CURRENT_CPU_INDEX() != 0) {
+        current_syscall_error.type = seL4_IllegalOperation;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    if (length < 1) {
+        current_syscall_error.type = seL4_TruncatedMessage;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    paddr_t control = getSyscallArg(0, buffer);
+    current_syscall_error.invalidArgumentNumber = 0;
+    current_syscall_error.type = seL4_InvalidArgument;
+    if (!kexec_low_page(control)) {
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    seL4_X86_KexecControl_t *c = paddr_to_pptr(control);
+    if (c->version != SEL4_X86_KEXEC_VERSION ||
+        !kexec_low_page(c->pml4) || !kexec_low_page(c->trampoline) ||
+        !kexec_low_page(c->parking) || !kexec_low_page(c->stack) ||
+        c->entry == 0 || c->entry >= BIT(32) ||
+        c->multiboot_info == 0 || c->multiboot_info >= BIT(32) ||
+        !IS_ALIGNED(c->multiboot_info, 3) ||
+        c->segments == 0 || c->segments >= BIT(32) || !IS_ALIGNED(c->segments, 3) ||
+        c->segment_count > (BIT(32) - c->segments) / sizeof(seL4_X86_KexecSegment_t)) {
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    paddr_t pages[] = { control, c->pml4, c->trampoline, c->parking, c->stack };
+    for (unsigned int i = 0; i < ARRAY_SIZE(pages); i++) {
+        for (unsigned int j = 0; j < i; j++) {
+            if (pages[i] == pages[j]) {
+                return EXCEPTION_SYSCALL_ERROR;
+            }
+        }
+    }
+
+    /* No failure/return from here. Root owns the page tables and all memory
+     * they describe. Keep our high mapping just until each CPU jumps low. */
+    pml4e_t *pml4 = paddr_to_pptr(c->pml4);
+    pml4[GET_PML4_INDEX(PPTR_BASE)] = x64KSKernelPML4[GET_PML4_INDEX(PPTR_BASE)];
+    __atomic_store_n(&c->parked, 0, __ATOMIC_RELEASE);
+#ifdef ENABLE_SMP_SUPPORT
+    word_t mask = MASK(ksNumCPUs - 1) << 1;
+    if (mask) {
+        /* Use the remote-call IPI so CPUs waiting on the big lock service it.
+         * The normal IPI barrier is in memory about to be overwritten, and
+         * cannot acknowledge that a CPU has LEFT the kernel. Parked APs never
+         * return to handleRemoteCall; the parking page supplies the ack. */
+        big_kernel_lock.ipi.remoteCall = IpiRemoteCall_Kexec;
+        big_kernel_lock.ipi.args[0] = control;
+        big_kernel_lock.ipi.args[1] = 0;
+        big_kernel_lock.ipi.args[2] = 0;
+        __atomic_thread_fence(__ATOMIC_RELEASE);
+        ipi_send_mask(irq_remote_call_ipi, mask, true);
+        while (__atomic_load_n(&c->parked, __ATOMIC_ACQUIRE) != mask) {
+            arch_pause();
+        }
+    }
+#endif
+    kexec_mask_lapic();
+    ioapic_mask_all();
+    pic_disable();
+    x86KexecEnter(control, c->trampoline, c->pml4, 0);
+}
