+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include <machine/assembler.h>
+
+.text
+.code64
+BEGIN_FUNC(x86KexecEnter)
+    /* RDI = control, RSI = entry, RDX = PML4, RCX = CPU index.
+     * The supplied PML4 now also maps the kernel for this short transition.
+     * Do not touch the old stack or return after switching CR3. */
+    cli
+    movq %rsi, %r8
+    movq %rcx, %rsi
+    movq %cr4, %rax
+    andq $~(1 << 7), %rax
+    orq $(1 << 4), %rax
+    movq %rax, %cr4           /* Flush global translations; leave PGE off and PSE on. */
+    movq %rdx, %cr3           /* Switch to the identity map with PCID zero. */
+    andq $~(1 << 17), %rax
+    movq %rax, %cr4           /* Flush all PCIDs and permit later PG=0. */
+    jmp *%r8
+END_FUNC(x86KexecEnter)
+
+.section .note.GNU-stack,"",@progbits
