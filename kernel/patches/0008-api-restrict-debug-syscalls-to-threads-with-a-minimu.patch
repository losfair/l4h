From 6e53f0404721149d3bd3857a1e4281bd08965a0c Mon Sep 17 00:00:00 2001
From: l4h <z@univalence.me>
Date: Sat, 17 Oct 2026 22:58:58 -0700
Subject: [PATCH] api: restrict debug syscalls to threads with a minimum MCP

Debug and benchmark system calls need no capability, and several of them
(SysDebugHalt, error paths of SysDebugNameThread and SysDebugSendIPI) halt
the whole system with the kernel lock held. A system that runs untrusted
code with debug facilities enabled therefore lets that code stop the
machine with one instruction.

Add KernelDebugSyscallMinMCP: threads whose maximum controlled priority is
below it get an unknown-syscall fault for these system calls, as for any
undefined one. The default, 0, keeps the current behaviour. Since a thread
cannot raise its MCP beyond the MCP of the TCB authorising the change,
untrusted code confined to a lower MCP band cannot regain access.

The same threshold applies to the kernel's messages about failed
invocations (userError) and about threads that fault without a fault
handler. Each is a synchronous serial write with the kernel lock held, so
untrusted code could otherwise stall every core by failing invocations in
a loop, in any build with printing.

With KernelInvocationReportErrorIPC, userError formats into a buffer
shared by all invocations, which the error reply copies to the caller:
the reply now carries an empty message to threads below the threshold,
and every invocation starts with the buffer empty, so an error never
reports a message left by an earlier invocation (possibly of a more
privileged thread).
---
 config.cmake              | 11 +++++++++++
 include/api/syscall.h     |  1 +
 include/api/types.h       | 29 +++++++++++++++++++++--------
 src/api/syscall.c         | 11 +++++++++++
 src/kernel/faulthandler.c |  4 ++++
 src/object/endpoint.c     | 11 +++++++++--
 6 files changed, 57 insertions(+), 10 deletions(-)

diff --git a/config.cmake b/config.cmake
index 8338d84c3..f52b1021d 100644
--- a/config.cmake
+++ b/config.cmake
@@ -150,6 +150,17 @@ config_string(
   DEFAULT 12
   UNQUOTE)
 
+config_string(
+  KernelDebugSyscallMinMCP DEBUG_SYSCALL_MIN_MCP
+  "Debug and benchmark system calls (seL4_DebugPutChar, seL4_DebugHalt, ...) are \
+    available only to threads whose maximum controlled priority is at least this \
+    value; other threads get an unknown-syscall fault, as for any undefined system \
+    call. Debug system calls need no capability, and some halt the whole system, so \
+    a system running untrusted code at user level with debug facilities enabled \
+    should give that code a lower MCP than this value. 0 allows every thread."
+  DEFAULT 0
+  UNQUOTE)
+
 config_string(KernelTimerTickMS TIMER_TICK_MS "Timer tick period in milliseconds" DEFAULT 2 UNQUOTE
               DEPENDS "NOT KernelIsMCS" UNDEF_DISABLED)
 config_string(KernelTimeSlice TIME_SLICE "Number of timer ticks until a thread is preempted."
diff --git a/include/api/syscall.h b/include/api/syscall.h
index ab818621b..990574769 100644
--- a/include/api/syscall.h
+++ b/include/api/syscall.h
@@ -33,6 +33,7 @@ exception_t handleSyscall(syscall_t syscall);
 
 /* True if every syscall from the thread must be delivered as a fault. */
 #define threadTrapsSyscalls(_t) (!!((_t)->tcbFlags & seL4_TCBFlag_trapSyscalls))
+
 exception_t handleInterruptEntry(void);
 exception_t handleUnknownSyscall(word_t w);
 exception_t handleUserLevelFault(word_t w_a, word_t w_b);
diff --git a/include/api/types.h b/include/api/types.h
index aee35fafa..bdf2f324f 100644
--- a/include/api/types.h
+++ b/include/api/types.h
@@ -100,6 +100,14 @@ static inline word_t CONST wordFromMessageInfo(seL4_MessageInfo_t mi)
     return mi.words[0];
 }
 
+/* True if the thread may use debug and benchmark system calls, and have the
+ * kernel print messages about its errors and faults. */
+#if CONFIG_DEBUG_SYSCALL_MIN_MCP > 0
+#define threadMayDebug(_t) ((_t)->tcbMCP >= CONFIG_DEBUG_SYSCALL_MIN_MCP)
+#else
+#define threadMayDebug(_t) true
+#endif
+
 #ifdef CONFIG_PRINTING
 #ifdef CONFIG_COLOUR_PRINTING
 #define ANSI_RESET "\033[0m"
@@ -132,17 +140,22 @@ extern struct debug_syscall_error current_debug_error;
 
 /*
  * Print to serial a message helping userspace programmers to determine why the
- * kernel is not performing their requested operation.
+ * kernel is not performing their requested operation.  Only for threads that
+ * may use debug system calls: a print stalls the core, with the kernel lock
+ * held, for as long as the serial port takes to send it.
  */
 #define userError(M, ...) \
     do {                                                                       \
-        out_error(ANSI_BOLD "<<" ANSI_GREEN "seL4(CPU %" SEL4_PRIu_word ")"    \
-                ANSI_BOLD " [%s/%d T%p \"%s\" @%lx]: " M ">>" ANSI_RESET "\n", \
-                CURRENT_CPU_INDEX(),                                           \
-                __func__, __LINE__, NODE_STATE(ksCurThread),                   \
-                THREAD_NAME,                                                   \
-                (word_t)getRestartPC(NODE_STATE(ksCurThread)),                 \
-                ## __VA_ARGS__);                                               \
+        if (threadMayDebug(NODE_STATE(ksCurThread))) {                         \
+            out_error(ANSI_BOLD "<<" ANSI_GREEN "seL4(CPU %" SEL4_PRIu_word ")"\
+                    ANSI_BOLD " [%s/%d T%p \"%s\" @%lx]: " M ">>" ANSI_RESET \
+                    "\n",                                                      \
+                    CURRENT_CPU_INDEX(),                                       \
+                    __func__, __LINE__, NODE_STATE(ksCurThread),               \
+                    THREAD_NAME,                                               \
+                    (word_t)getRestartPC(NODE_STATE(ksCurThread)),             \
+                    ## __VA_ARGS__);                                           \
+        }                                                                      \
     } while (0)
 #else /* !CONFIG_PRINTING */
 #define userError(...)
diff --git a/src/api/syscall.c b/src/api/syscall.c
index 82014adaf..19f2c9653 100644
--- a/src/api/syscall.c
+++ b/src/api/syscall.c
@@ -113,6 +113,10 @@ exception_t handleUnknownSyscall(word_t w)
         return EXCEPTION_NONE;
     }
 
+    if (unlikely(!threadMayDebug(NODE_STATE(ksCurThread)))) {
+        goto unknown_syscall;
+    }
+
 #ifdef CONFIG_PRINTING
     if (w == SysDebugPutChar) {
         kernel_putchar(getRegister(NODE_STATE(ksCurThread), capRegister));
@@ -261,6 +265,7 @@ exception_t handleUnknownSyscall(word_t w)
     } /* end switch(w) */
 #endif /* CONFIG_ENABLE_BENCHMARKS */
 
+unknown_syscall:
     MCS_DO_IF_BUDGET({
 #ifdef CONFIG_SET_TLS_BASE_SELF
         if (w == SysSetTLSBase)
@@ -328,6 +333,12 @@ static exception_t handleInvocation(bool_t isCall, bool_t isBlocking)
 
     thread = NODE_STATE(ksCurThread);
 
+#ifdef CONFIG_KERNEL_INVOCATION_REPORT_ERROR_IPC
+    /* An error without a userError message reports none, not the message
+     * of an earlier invocation. */
+    ((char *)current_debug_error.errorMessage)[0] = '\0';
+#endif
+
     info = messageInfoFromWord(getRegister(thread, msgInfoRegister));
 #ifndef CONFIG_KERNEL_MCS
     cptr_t cptr = getRegister(thread, capRegister);
diff --git a/src/kernel/faulthandler.c b/src/kernel/faulthandler.c
index 99df97ea2..2aaaf51a6 100644
--- a/src/kernel/faulthandler.c
+++ b/src/kernel/faulthandler.c
@@ -150,6 +150,9 @@ void handleDoubleFault(tcb_t *tptr, seL4_Fault_t ex1)
 #endif
 {
 #ifdef CONFIG_PRINTING
+    if (!threadMayDebug(tptr)) {
+        goto no_print;
+    }
 #ifdef CONFIG_KERNEL_MCS
     printf("Found thread has no fault handler while trying to handle:\n");
     print_fault(current_fault);
@@ -167,6 +170,7 @@ void handleDoubleFault(tcb_t *tptr, seL4_Fault_t ex1)
     printf("at address %p\n", (void *)getRestartPC(tptr));
     printf("With stack:\n");
     Arch_userStackTrace(tptr);
+no_print:
 #endif
 
     setThreadState(tptr, ThreadState_Inactive);
diff --git a/src/object/endpoint.c b/src/object/endpoint.c
index 6e34398eb..55fb27899 100644
--- a/src/object/endpoint.c
+++ b/src/object/endpoint.c
@@ -307,8 +307,15 @@ void replyFromKernel_error(tcb_t *thread)
 
 #ifdef CONFIG_KERNEL_INVOCATION_REPORT_ERROR_IPC
     char *debugBuffer = (char *)(ipcBuffer + DEBUG_MESSAGE_START + 1);
-    word_t add = strlcpy(debugBuffer, (char *)current_debug_error.errorMessage,
-                         DEBUG_MESSAGE_MAXLEN * sizeof(word_t));
+    word_t add = 0;
+    /* userError does not write messages for threads that may not debug,
+     * so the buffer holds another invocation's message: send none. */
+    if (threadMayDebug(thread)) {
+        add = strlcpy(debugBuffer, (char *)current_debug_error.errorMessage,
+                      DEBUG_MESSAGE_MAXLEN * sizeof(word_t));
+    } else {
+        debugBuffer[0] = '\0';
+    }
 
     len += (add / sizeof(word_t)) + 1;
 #endif
-- 
