From 3ecf11f1c528d16afee9f4cfe39c46961aa3d344 Mon Sep 17 00:00:00 2001
From: l4h <z@univalence.me>
Date: Mon, 9 Nov 2026 01:22:12 +0100
Subject: [PATCH] x86: guests set only the CR4 bits on an allowlist

CR4 enables features whose state some VM entries and exits do not
switch, and seL4 does not switch either.  PKE is one: PKRU is outside the
XSAVE features seL4 enables, and the host runs with CR4.PKE clear, so a
guest that set CR4.PKE could WRPKRU a value that the next guest on the
core with CR4.PKE set would read and run with.  KL is another: LOADIWKEY
sets the core's Key Locker wrapping key, and seL4 does not allow the
control that makes it exit.  Each new CPU may add more.

So, as with the VM-execution controls, guests get only the CR4 bits on a
list, VCPU_GUEST_CR4_ALLOWED: those whose effects stay in guest mode, on
state VM entry and exit or seL4 switch (VME, PVI, TSD, DE, PSE, PAE, MCE,
PGE, PCE, OSFXSR, OSXMMEXCPT, UMIP, LA57, FSGSBASE, PCIDE, OSXSAVE, SMEP,
SMAP).  Every other bit stays clear, including ones later CPUs define.

On VT-x the bits outside the list are always in the CR4 guest/host mask,
so a guest changing one exits, and GUEST_CR4 takes only listed bits and
the fixed ones (VMXE).  On AMD-V, which has no CR4 mask, CR4 writes
always exit and WriteVMCB keeps the bits outside the list clear.
Reading back VMX_CONTROL_CR4_MASK or the CR intercepts shows these bits
set.
---
 include/arch/x86/arch/object/vcpu.h | 13 +++++++++++++
 src/arch/x86/object/svm.c           | 11 +++++++++--
 src/arch/x86/object/vcpu.c          |  8 ++++++--
 3 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/include/arch/x86/arch/object/vcpu.h b/include/arch/x86/arch/object/vcpu.h
index 14435ea90..44da90d64 100644
--- a/include/arch/x86/arch/object/vcpu.h
+++ b/include/arch/x86/arch/object/vcpu.h
@@ -10,6 +10,19 @@
 #include <api/failures.h>
 #include <arch/object/svm.h>
 
+/*
+ * The CR4 bits a guest may set, on VT-x and AMD-V: those whose effects stay
+ * in guest mode, on state that VM entry and exit switch or that seL4 does
+ * (XCR0, the FS and GS bases).  VME, PVI, TSD, DE, PSE, PAE, MCE, PGE, PCE,
+ * OSFXSR, OSXMMEXCPT, UMIP, LA57, FSGSBASE, PCIDE, OSXSAVE, SMEP and SMAP.
+ * Every other bit stays clear in the guest, including any a later CPU
+ * defines: some enable state that nothing switches and that the next guest
+ * on the core would run with, such as PKRU (PKE), the Key Locker wrapping
+ * key (KL), PKRS (PKS) and the CET, UINTR and FRED registers.
+ */
+#define VCPU_GUEST_CR4_ALLOWED \
+    (MASK(13) | BIT(16) | BIT(17) | BIT(18) | BIT(20) | BIT(21))
+
 #define VCPU_VMCS_SIZE 4096
 #define VCPU_IOBITMAP_SIZE 8192
 
diff --git a/src/arch/x86/object/svm.c b/src/arch/x86/object/svm.c
index 94022e197..f21a703d1 100644
--- a/src/arch/x86/object/svm.c
+++ b/src/arch/x86/object/svm.c
@@ -112,6 +112,9 @@
                        SVM_I2_XSETBV | SVM_I2_RDPRU)
 #define SVM_I2_WRITABLE (SVM_I2_VMMCALL | SVM_I2_RDTSCP | SVM_I2_ICEBP | SVM_I2_WBINVD)
 #define SVM_EXC_FORCED (BIT(1) | BIT(17) | BIT(18))
+/* CR4 writes always exit: SVM has no CR4 mask, and a guest must not set
+ * the bits outside VCPU_GUEST_CR4_ALLOWED. */
+#define SVM_CR_FORCED  BIT(16 + 4)
 
 #define SVM_INT_CTL_WRITABLE    (MASK(9) | (MASK(4) << 16) | BIT(20))
 #define SVM_V_INTR_MASKING      BIT(24)
@@ -284,6 +287,7 @@ void svm_vcpu_init(vcpu_t *vcpu)
     vcpu->svm.last_cpu = CURRENT_CPU_INDEX();
 
     memzero(vcpu->vmcs, VCPU_VMCS_SIZE);
+    *vmcb_u32(vcpu, VMCB_INTERCEPT_CR) = SVM_CR_FORCED;
     *vmcb_u32(vcpu, VMCB_INTERCEPT_DR) = ~(uint32_t)0;
     *vmcb_u32(vcpu, VMCB_INTERCEPT_EXC) = SVM_EXC_FORCED;
     *vmcb_u32(vcpu, VMCB_INTERCEPT_MISC1) = SVM_I1_FORCED;
@@ -340,7 +344,7 @@ static bool_t svm_field(word_t offset, svm_field_t *f)
     switch (offset) {
     case VMCB_INTERCEPT_CR:      /* and the DR intercepts, all on */
         f->writable = MASK(32);
-        f->forced = (uint64_t)MASK(32) << 32;
+        f->forced = SVM_CR_FORCED | ((uint64_t)MASK(32) << 32);
         f->clean = VMCB_CLEAN_I;
         return true;
     case VMCB_INTERCEPT_EXC:     /* and misc1 */
@@ -426,9 +430,12 @@ static bool_t svm_field(word_t offset, svm_field_t *f)
         f->forced = EFER_SVME;
         f->clean = VMCB_CLEAN_CRX;
         return true;
+    case VMCB_CR4:
+        f->writable = VCPU_GUEST_CR4_ALLOWED;
+        f->clean = VMCB_CLEAN_CRX;
+        return true;
     case VMCB_CR0:
     case VMCB_CR3:
-    case VMCB_CR4:
         f->clean = VMCB_CLEAN_CRX;
         return true;
     case VMCB_DR6:
diff --git a/src/arch/x86/object/vcpu.c b/src/arch/x86/object/vcpu.c
index b7ce7c23d..d4da9e197 100644
--- a/src/arch/x86/object/vcpu.c
+++ b/src/arch/x86/object/vcpu.c
@@ -582,6 +582,8 @@ void vcpu_init(vcpu_t *vcpu)
     vmwrite(VMX_CONTROL_CR0_MASK, vcpu->cr0_mask);
     vmwrite(VMX_CONTROL_CR0_READ_SHADOW, vcpu->cr0_shadow);
     vmwrite(VMX_GUEST_CR4, cr4_high & cr4_low);
+    /* A guest changing a CR4 bit it may not set exits. */
+    vmwrite(VMX_CONTROL_CR4_MASK, ~(word_t)VCPU_GUEST_CR4_ALLOWED);
 
     vmwrite(VMX_GUEST_VMCS_LINK_POINTER, ~(word_t)0);
     vmwrite(VMX_GUEST_VMCS_LINK_POINTER_HIGH, ~(word_t)0);
@@ -1037,7 +1039,6 @@ static exception_t decodeWriteVMCS(cap_t cap, word_t length, bool_t call, word_t
     case VMX_GUEST_PENDING_DEBUG_EXCEPTIONS:
     case VMX_GUEST_SYSENTER_ESP:
     case VMX_GUEST_SYSENTER_EIP:
-    case VMX_CONTROL_CR4_MASK:
     case VMX_CONTROL_CR0_READ_SHADOW:
     case VMX_CONTROL_CR4_READ_SHADOW:
     case VMX_GUEST_CR3:
@@ -1051,6 +1052,9 @@ static exception_t decodeWriteVMCS(cap_t cap, word_t length, bool_t call, word_t
         /* CD, NW and reserved bits are always kernel-owned, see vcpu_init() */
         value |= VMX_CR0_KERNEL_OWNED_BITS;
         break;
+    case VMX_CONTROL_CR4_MASK:
+        value |= ~(word_t)VCPU_GUEST_CR4_ALLOWED;
+        break;
     case VMX_CONTROL_PIN_EXECUTION_CONTROLS:
         value = applyFixedBits(value, pin_control_high, pin_control_low & (pin_control_high | PIN_CONTROLS_ALLOWED));
         break;
@@ -1071,7 +1075,7 @@ static exception_t decodeWriteVMCS(cap_t cap, word_t length, bool_t call, word_t
         value = applyFixedBits(value, cr0_high, cr0_low);
         break;
     case VMX_GUEST_CR4:
-        value = applyFixedBits(value, cr4_high, cr4_low);
+        value = applyFixedBits(value, cr4_high, cr4_low & (cr4_high | VCPU_GUEST_CR4_ALLOWED));
         break;
     default:
         userError("VCPU WriteVMCS: Invalid field %lx.", (long)field);
-- 
