From d0dd62ecb7b158eeed4a87f64c41b8084c558cbd Mon Sep 17 00:00:00 2001
From: l4h <z@univalence.me>
Date: Thu, 12 Nov 2026 19:02:39 +0100
Subject: [PATCH] l4h: adapt local extensions to upstream SMP/IPI changes

Keep the squashed upstream PR #1849 patch (0000) unchanged. Adapt the
l4h extensions to the new lock ownership and remote-stall retry protocol
in this separate follow-up patch:

- Preserve patch 0012's native stale-timer fast return with explicit
  lock ownership. VM returns use the locked path and retain VCPU,
  notification and pending-exit preparation from patch 0039.
- Use switchLocalFpuOwner() for patch 0002's current-thread FPU reload;
  upstream removed the switchFpuOwner() wrapper.
- Stall both affected TCBs before VCPU rebinding and the bound TCB before
  final VCPU deletion. Return EXCEPTION_PREEMPTED without changing either
  binding when a stall refuses. TCB deletion uses upstream's retry path.
  Remove the now redundant inner dissociation stall.
---
 include/arch/x86/arch/kernel/traps.h |  4 +++
 src/arch/x86/32/c_traps.c            | 39 ++++++++++++++++------------
 src/arch/x86/64/c_traps.c            | 37 ++++++++++++++------------
 src/arch/x86/c_traps.c               | 13 ++++++----
 src/arch/x86/object/objecttype.c     | 11 +++++++-
 src/arch/x86/object/vcpu.c           | 18 ++++++++-----
 src/object/tcb.c                     |  2 +-
 7 files changed, 77 insertions(+), 47 deletions(-)

diff --git a/include/arch/x86/arch/kernel/traps.h b/include/arch/x86/arch/kernel/traps.h
index 4b0ee0996..e3ca6cab0 100644
--- a/include/arch/x86/arch/kernel/traps.h
+++ b/include/arch/x86/arch/kernel/traps.h
@@ -34,6 +34,10 @@ VISIBLE NORETURN;
 void restore_user_context(void)
 VISIBLE NORETURN;
 
+/* Stale-timer return for a native thread that never took the lock. */
+void restore_user_context_no_lock(void)
+VISIBLE NORETURN;
+
 void c_nested_interrupt(int irq)
 VISIBLE;
 
diff --git a/src/arch/x86/32/c_traps.c b/src/arch/x86/32/c_traps.c
index 234cbc4c5..56caf8a78 100644
--- a/src/arch/x86/32/c_traps.c
+++ b/src/arch/x86/32/c_traps.c
@@ -102,26 +102,28 @@ static void NORETURN restore_vmx(tcb_t *cur_thread, vcpu_t *vcpu)
 #endif
 
 void NORETURN VISIBLE restore_user_context(void);
-void NORETURN VISIBLE restore_user_context(void)
+static void NORETURN restore_user_context_internal(bool_t lock_held);
+
+void VISIBLE NORETURN restore_user_context(void)
 {
-    c_exit_hook();
+    restore_user_context_internal(true);
+}
+
+void VISIBLE NORETURN restore_user_context_no_lock(void)
+{
+    restore_user_context_internal(false);
+}
 
+static void NORETURN restore_user_context_internal(bool_t lock_held)
+{
+    /* Only the stale-timer fast return may arrive without the lock. It
+     * cannot return to a VM, which needs locked VCPU preparation. */
 #ifdef CONFIG_VTX
-    /* While the lock is held, so that an invocation on another core finds
-     * the VCPU here and takes it out of guest mode before touching it.
-     * The remote-call IPI and the MCS stale-timer drop get here without
-     * it, and the IPI may have been one taking the VCPU away: take the
-     * lock, which can also change the thread (a stall).  A notification
-     * another core signalled may not have been checked yet, if the thread
-     * was switched out and back in since its IPI: it ends the VMEnter.
-     * And a thread that a stall IPI took off its core, while it waited for
-     * the lock with an exit for userspace, has that exit to report still,
-     * instead of entering guest mode again. */
-    if (thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState) == ThreadState_RunningVM) {
+    assert(lock_held || thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState)
+           != ThreadState_RunningVM);
+    if (lock_held && thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState)
+        == ThreadState_RunningVM) {
 #ifdef ENABLE_SMP_SUPPORT
-        if (!clh_is_self_in_queue()) {
-            NODE_LOCK_SYS;
-        }
         VMCheckBoundNotification(NODE_STATE(ksCurThread));
 #endif
         if (thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState) == ThreadState_RunningVM) {
@@ -134,7 +136,10 @@ void NORETURN VISIBLE restore_user_context(void)
     }
 #endif
 
-    NODE_UNLOCK;
+    c_exit_hook();
+    if (lock_held) {
+        NODE_UNLOCK;
+    }
 
     /* we've now 'exited' the kernel. If we have a pending interrupt
      * we should 'enter' it again */
diff --git a/src/arch/x86/64/c_traps.c b/src/arch/x86/64/c_traps.c
index 5bdcbcf47..905ce5a2e 100644
--- a/src/arch/x86/64/c_traps.c
+++ b/src/arch/x86/64/c_traps.c
@@ -208,26 +208,28 @@ static void NORETURN restore_vmx(tcb_t *cur_thread, vcpu_t *vcpu)
 }
 #endif
 
+static void NORETURN restore_user_context_internal(bool_t lock_held);
+
 void VISIBLE NORETURN restore_user_context(void)
 {
-    c_exit_hook();
+    restore_user_context_internal(true);
+}
+
+void VISIBLE NORETURN restore_user_context_no_lock(void)
+{
+    restore_user_context_internal(false);
+}
 
+static void NORETURN restore_user_context_internal(bool_t lock_held)
+{
+    /* Only the stale-timer fast return may arrive without the lock. It
+     * cannot return to a VM, which needs locked VCPU preparation. */
 #ifdef CONFIG_VTX
-    /* While the lock is held, so that an invocation on another core finds
-     * the VCPU here and takes it out of guest mode before touching it.
-     * The remote-call IPI and the MCS stale-timer drop get here without
-     * it, and the IPI may have been one taking the VCPU away: take the
-     * lock, which can also change the thread (a stall).  A notification
-     * another core signalled may not have been checked yet, if the thread
-     * was switched out and back in since its IPI: it ends the VMEnter.
-     * And a thread that a stall IPI took off its core, while it waited for
-     * the lock with an exit for userspace, has that exit to report still,
-     * instead of entering guest mode again. */
-    if (thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState) == ThreadState_RunningVM) {
+    assert(lock_held || thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState)
+           != ThreadState_RunningVM);
+    if (lock_held && thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState)
+        == ThreadState_RunningVM) {
 #ifdef ENABLE_SMP_SUPPORT
-        if (!clh_is_self_in_queue()) {
-            NODE_LOCK_SYS;
-        }
         VMCheckBoundNotification(NODE_STATE(ksCurThread));
 #endif
         if (thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState) == ThreadState_RunningVM) {
@@ -240,7 +242,10 @@ void VISIBLE NORETURN restore_user_context(void)
     }
 #endif
 
-    NODE_UNLOCK;
+    c_exit_hook();
+    if (lock_held) {
+        NODE_UNLOCK;
+    }
 
     /* we've now 'exited' the kernel. If we have a pending interrupt
      * we should 'enter' it again */
diff --git a/src/arch/x86/c_traps.c b/src/arch/x86/c_traps.c
index 9c24fd11f..19556268c 100644
--- a/src/arch/x86/c_traps.c
+++ b/src/arch/x86/c_traps.c
@@ -62,13 +62,16 @@ void VISIBLE NORETURN c_handle_interrupt(int irq, int syscall)
     }
 
 #ifdef CONFIG_KERNEL_MCS
-    /* Drop a stale timer interrupt without taking the kernel lock: the
-     * timer will raise the interrupt again at the deadline it is armed
-     * with. */
-    if (irq == int_timer && timerIRQIsStale()) {
+    /* Native threads can drop a stale tick without taking the lock. A
+     * VM return needs locked VCPU preparation, so use the normal path. */
+    if (irq == int_timer && timerIRQIsStale()
+#ifdef CONFIG_VTX
+        && thread_state_ptr_get_tsType(&NODE_STATE(ksCurThread)->tcbState) != ThreadState_RunningVM
+#endif
+       ) {
         c_entry_hook();
         apic_ack_active_interrupt();
-        restore_user_context();
+        restore_user_context_no_lock();
         UNREACHABLE();
     }
 #endif
diff --git a/src/arch/x86/object/objecttype.c b/src/arch/x86/object/objecttype.c
index 03c510315..550b112f7 100644
--- a/src/arch/x86/object/objecttype.c
+++ b/src/arch/x86/object/objecttype.c
@@ -9,6 +9,7 @@
 #include <api/failures.h>
 #include <kernel/vspace.h>
 #include <object/structures.h>
+#include <object/tcb.h>
 #include <arch/machine.h>
 #include <arch/model/statedata.h>
 #include <machine/fpu.h>
@@ -246,7 +247,15 @@ finaliseCap_ret_t Arch_finaliseCap(cap_t cap, bool_t final)
 #ifdef CONFIG_VTX
     case cap_vcpu_cap:
         if (final) {
-            vcpu_finalise(VCPU_PTR(cap_vcpu_cap_get_capVCPUPtr(cap)));
+            vcpu_t *vcpu = VCPU_PTR(cap_vcpu_cap_get_capVCPUPtr(cap));
+#ifdef ENABLE_SMP_SUPPORT
+            if (vcpu->vcpuTCB && !remoteTCBStall(vcpu->vcpuTCB)) {
+                fc_ret.remainder = cap_null_cap_new();
+                fc_ret.cleanupInfo = Zombie_new(0, 0, 0);
+                return fc_ret;
+            }
+#endif
+            vcpu_finalise(vcpu);
         }
         break;
     case cap_ept_pml4_cap:
diff --git a/src/arch/x86/object/vcpu.c b/src/arch/x86/object/vcpu.c
index 3ef170f7b..89f71318b 100644
--- a/src/arch/x86/object/vcpu.c
+++ b/src/arch/x86/object/vcpu.c
@@ -698,13 +698,10 @@ static void dissociateVcpuTcb(tcb_t *tcb, vcpu_t *vcpu)
      * which is also when that core has finished recording an exit. */
     if (thread_state_ptr_get_tsType(&tcb->tcbState) == ThreadState_RunningVM) {
 #ifdef ENABLE_SMP_SUPPORT
-        /* And off its core, as for an invocation of the thread itself.  It
-         * may be waiting there for the kernel lock, after an exit: a stall
-         * IPI in that wait takes a running thread for one in a system call
-         * and makes it start the call again (ipiStallCoreCallback()), so
-         * this thread would run its VMEnter again, in place of the result
-         * it is given here. */
-        remoteTCBStall(tcb);
+        /* The decoding/finalisation path must stall both affected TCBs
+         * before changing either binding, and retry if a stall fails. */
+        assert(tcb->tcbAffinity == getCurrentCPUIndex() ||
+               NODE_STATE_ON_CORE(ksCurThread, tcb->tcbAffinity) != tcb);
 #endif
         if (x86KSSVMEnabled) {
             svm_claim_vcpu(vcpu);
@@ -1390,6 +1387,13 @@ static exception_t decodeReadVMCS(cap_t cap, word_t length, bool_t call, word_t
 
 static exception_t invokeSetTCB(vcpu_t *vcpu, tcb_t *tcb)
 {
+#ifdef ENABLE_SMP_SUPPORT
+    /* Both the old and new binding must be safe before either changes. */
+    if (!remoteTCBStall(tcb) || (vcpu->vcpuTCB && !remoteTCBStall(vcpu->vcpuTCB))) {
+        setThreadState(NODE_STATE(ksCurThread), ThreadState_Restart);
+        return EXCEPTION_PREEMPTED;
+    }
+#endif
     associateVcpuTcb(tcb, vcpu);
 
     setThreadState(NODE_STATE(ksCurThread), ThreadState_Restart);
diff --git a/src/object/tcb.c b/src/object/tcb.c
index 8a2e31197..43483a6dc 100644
--- a/src/object/tcb.c
+++ b/src/object/tcb.c
@@ -933,7 +933,7 @@ static exception_t decodeFPUTransfer(cap_t cap, word_t length, word_t *buffer, b
      * A target running on another core has already been stalled off it by
      * remoteTCBStall() and reloads its FPU when it is switched to again. */
     if (owned && thread == NODE_STATE(ksCurThread)) {
-        switchFpuOwner(thread, CURRENT_CPU_INDEX());
+        switchLocalFpuOwner(thread);
     }
     return EXCEPTION_NONE;
 }
-- 
