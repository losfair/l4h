+/* Derive aliases, not new objects: no retype, zeroing, or ownership
+ * transfer. The Untyped remains the ancestor of every alias. Like a
+ * frame copy, each alias is non-revocable: deriving a narrower region
+ * must not give its holder authority to revoke a sibling alias.
+ * The destination window is checked as Untyped_Retype checks it, so one
+ * call fills a CNode with all 512 aliases of a large frame. */
+static exception_t decodePageDeriveSubframe(word_t length, cte_t *src, cap_t cap, word_t *buffer)
+{
+    if (length < 6 || current_extra_caps.excaprefs[0] == NULL) {
+        current_syscall_error.type = seL4_TruncatedMessage;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    if (cap_frame_cap_get_capFSize(cap) != ARMLargePage || cap_frame_cap_get_capFIsDevice(cap)) {
+        current_syscall_error.type = seL4_IllegalOperation;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    word_t nodeIndex = getSyscallArg(0, buffer);
+    word_t nodeDepth = getSyscallArg(1, buffer);
+    word_t nodeOffset = getSyscallArg(2, buffer);
+    word_t offset = getSyscallArg(3, buffer);
+    word_t count = getSyscallArg(4, buffer);
+    if (offset >= BIT(21) || !IS_ALIGNED(offset, 12)) {
+        current_syscall_error.type = seL4_InvalidArgument;
+        current_syscall_error.invalidArgumentNumber = 3;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    if (count < 1 || count > (BIT(21) - offset) >> 12) {
+        current_syscall_error.type = seL4_RangeError;
+        current_syscall_error.rangeErrorMin = 1;
+        current_syscall_error.rangeErrorMax = (BIT(21) - offset) >> 12;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    cap_t nodeCap = current_extra_caps.excaprefs[0]->cap;
+    if (nodeDepth != 0) {
+        lookupSlot_ret_t lu = lookupTargetSlot(nodeCap, nodeIndex, nodeDepth);
+        if (lu.status != EXCEPTION_NONE) {
+            return lu.status;
+        }
+        nodeCap = lu.slot->cap;
+    }
+    if (cap_get_capType(nodeCap) != cap_cnode_cap) {
+        current_syscall_error.type = seL4_FailedLookup;
+        current_syscall_error.failedLookupWasSource = 0;
+        current_lookup_fault = lookup_fault_missing_capability_new(nodeDepth);
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    word_t nodeSize = BIT(cap_cnode_cap_get_capCNodeRadix(nodeCap));
+    if (nodeOffset > nodeSize - 1) {
+        current_syscall_error.type = seL4_RangeError;
+        current_syscall_error.rangeErrorMin = 0;
+        current_syscall_error.rangeErrorMax = nodeSize - 1;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    if (count > nodeSize - nodeOffset) {
+        current_syscall_error.type = seL4_RangeError;
+        current_syscall_error.rangeErrorMin = 1;
+        current_syscall_error.rangeErrorMax = nodeSize - nodeOffset;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    cte_t *dest = CTE_PTR(cap_cnode_cap_get_capCNodePtr(nodeCap)) + nodeOffset;
+    for (word_t i = 0; i < count; i++) {
+        exception_t status = ensureEmptySlot(dest + i);
+        if (status != EXCEPTION_NONE) {
+            return status;
+        }
+    }
+    word_t base = cap_frame_cap_get_capFBasePtr(cap) + offset;
+    cap = cap_frame_cap_set_capFSize(cap, ARMSmallPage);
+    cap = cap_frame_cap_set_capFVMRights(cap, maskVMRights(cap_frame_cap_get_capFVMRights(cap),
+                                                        rightsFromWord(getSyscallArg(5, buffer))));
+    cap = cap_frame_cap_set_capFMappedASID(cap, asidInvalid);
+    cap = cap_frame_cap_set_capFMappedAddress(cap, 0);
+    setThreadState(NODE_STATE(ksCurThread), ThreadState_Restart);
+    /* At most 512 inserts, like a Retype within the fan-out limit. */
+    for (word_t i = 0; i < count; i++) {
+        cteInsert(cap_frame_cap_set_capFBasePtr(cap, base + (i << 12)), src, dest + i);
+    }
+    return EXCEPTION_NONE;
+}
