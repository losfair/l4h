@@ -712,11 +712,12 @@ static pte_t makeUserPagePTE(paddr_t paddr, vm_rights_t vm_rights, vm_attributes
 
 #ifndef CONFIG_ARM_HYPERVISOR_SUPPORT
 /* Without hardware AF updates, repair access-flag faults in seL4, without
- * fault IPC to the VSpace owner.  Only native EL0 4 KiB mappings qualify.
+ * fault IPC to the VSpace owner.  Only native EL0 4 KiB and 2 MiB mappings qualify.
  * An AF already set by another core is also a successfully handled fault. */
 static bool_t handleAccessFlagFault(tcb_t *thread, vptr_t addr, word_t fault)
 {
-    if ((fault & MASK(6)) != 0xb || addr > USER_TOP) {
+    word_t fsc = fault & MASK(6);
+    if ((fsc != 0xb && fsc != 0xa) || addr > USER_TOP) {
         return false;
     }
     cap_t root = TCB_PTR_CTE_PTR(thread, tcbVTable)->cap;
@@ -729,9 +730,9 @@ static bool_t handleAccessFlagFault(tcb_t *thread, vptr_t addr, word_t fault)
         return false;
     }
     lookupPTSlot_ret_t lu_ret = lookupPTSlot(find_ret.vspace_root, addr);
-    if (lu_ret.ptBitsLeft != seL4_PageBits ||
+    if (lu_ret.ptBitsLeft != (fsc == 0xa ? 21 : 12) ||
         !pte_is_page_type(*lu_ret.ptSlot) ||
-        !(pte_pte_4k_page_get_AP(*lu_ret.ptSlot) & 1)) {
+        !(lu_ret.ptSlot->words[0] & BIT(6))) {
         return false;
     }
     __atomic_fetch_or(&lu_ret.ptSlot->words[0], BIT(10), __ATOMIC_RELAXED);
@@ -1552,7 +1553,8 @@ static inline bool_t CONST checkVPAlignment(vm_page_size_t sz, word_t w)
 static exception_t decodePageTestAndClearAccessed(cap_t cap, bool_t call)
 {
     asid_t asid = cap_frame_cap_get_capFMappedASID(cap);
-    if (cap_frame_cap_get_capFSize(cap) != ARMSmallPage || asid == asidInvalid) {
+    if ((cap_frame_cap_get_capFSize(cap) != ARMSmallPage &&
+         cap_frame_cap_get_capFSize(cap) != ARMLargePage) || asid == asidInvalid) {
         current_syscall_error.type = seL4_IllegalOperation;
         return EXCEPTION_SYSCALL_ERROR;
     }
@@ -1563,7 +1565,8 @@ static exception_t decodePageTestAndClearAccessed(cap_t cap, bool_t call)
     }
     lookupPTSlot_ret_t lu_ret = lookupPTSlot(find_ret.vspace_root,
                                            cap_frame_cap_get_capFMappedAddress(cap));
-    if (lu_ret.ptBitsLeft != seL4_PageBits || !pte_is_page_type(*lu_ret.ptSlot) ||
+    if (lu_ret.ptBitsLeft != pageBitsForSize(cap_frame_cap_get_capFSize(cap)) ||
+        !pte_is_page_type(*lu_ret.ptSlot) ||
         pte_get_page_base_address(*lu_ret.ptSlot) !=
         pptr_to_paddr((void *)cap_frame_cap_get_capFBasePtr(cap))) {
         goto stale;
@@ -1593,10 +1596,52 @@ stale:
 }
 #endif
 
+/* Derive an alias, not a new object: no retype, zeroing, or ownership
+ * transfer. The Untyped remains the ancestor of every alias. Like a
+ * frame copy, the alias is non-revocable: deriving a narrower region
+ * must not give its holder authority to revoke a sibling alias. */
+static exception_t decodePageDeriveSubframe(word_t length, cte_t *src, cap_t cap, word_t *buffer)
+{
+    if (length < 4 || current_extra_caps.excaprefs[0] == NULL) {
+        current_syscall_error.type = seL4_TruncatedMessage;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    if (cap_frame_cap_get_capFSize(cap) != ARMLargePage || cap_frame_cap_get_capFIsDevice(cap)) {
+        current_syscall_error.type = seL4_IllegalOperation;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    word_t offset = getSyscallArg(2, buffer);
+    if (offset >= BIT(21) || !IS_ALIGNED(offset, 12)) {
+        current_syscall_error.type = seL4_InvalidArgument;
+        current_syscall_error.invalidArgumentNumber = 2;
+        return EXCEPTION_SYSCALL_ERROR;
+    }
+    lookupSlot_ret_t lu = lookupTargetSlot(current_extra_caps.excaprefs[0]->cap,
+                                           getSyscallArg(0, buffer), getSyscallArg(1, buffer));
+    if (lu.status != EXCEPTION_NONE) {
+        return lu.status;
+    }
+    exception_t status = ensureEmptySlot(lu.slot);
+    if (status != EXCEPTION_NONE) {
+        return status;
+    }
+    cap = cap_frame_cap_set_capFBasePtr(cap, cap_frame_cap_get_capFBasePtr(cap) + offset);
+    cap = cap_frame_cap_set_capFSize(cap, ARMSmallPage);
+    cap = cap_frame_cap_set_capFVMRights(cap, maskVMRights(cap_frame_cap_get_capFVMRights(cap),
+                                                        rightsFromWord(getSyscallArg(3, buffer))));
+    cap = cap_frame_cap_set_capFMappedASID(cap, asidInvalid);
+    cap = cap_frame_cap_set_capFMappedAddress(cap, 0);
+    setThreadState(NODE_STATE(ksCurThread), ThreadState_Restart);
+    cteInsert(cap, src, lu.slot);
+    return EXCEPTION_NONE;
+}
+
 static exception_t decodeARMFrameInvocation(word_t invLabel, word_t length,
                                             cte_t *cte, cap_t cap, bool_t call, word_t *buffer)
 {
     switch (invLabel) {
+    case ARMPageDeriveSubframe:
+        return decodePageDeriveSubframe(length, cte, cap, buffer);
     case ARMPageMap: {
         vptr_t vaddr;
         paddr_t base;
