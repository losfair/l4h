+    word_t old = __atomic_fetch_and(entry, ~BIT(5), __ATOMIC_RELAXED);
     tcb_t *thread = NODE_STATE(ksCurThread);
     if (call) {
         word_t *ipcBuffer = lookupIPCBuffer(true, thread);
@@ -1025,6 +1038,50 @@ stale:
