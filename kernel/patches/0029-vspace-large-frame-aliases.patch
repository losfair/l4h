+        <method id="ARMPageDeriveSubframe" name="DeriveSubframe" manual_name="Derive Subframe">
+            <condition><config var="CONFIG_ARCH_AARCH64"/></condition>
+            <brief>Derive 4 KiB aliases of a RAM-backed 2 MiB frame.</brief>
+            <description>
+                Derives count consecutive aliases, starting at offset, into
+                consecutive slots of a destination CNode. The destination
+                CNode, window and empty-slot checks are those of
+                Untyped_Retype; nothing is derived unless every check passes.
+                Offset must be 4 KiB aligned, and offset + count * 4 KiB
+                must not exceed 2 MiB. Rights are intersected with the
+                source's rights. Memory is neither allocated nor cleared. The
+                results are unmapped and remain in the source Untyped's
+                derivation tree, so revoking that Untyped deletes both sizes
+                of aliases before memory reuse. Deleting the source leaves its
+                aliases alive. Derived aliases and ordinary copies retain
+                non-revocable frame-copy semantics: an alias does not gain
+                authority to revoke other aliases.
+            </description>
+            <param dir="in" name="root" type="seL4_CNode"
+                description="CPtr to the CNode at the root of the destination CSpace."/>
+            <param dir="in" name="node_index" type="seL4_Word"
+                description="CPtr to the destination CNode, resolved relative to the root parameter."/>
+            <param dir="in" name="node_depth" type="seL4_Word"
+                description="Number of bits of node_index to translate; zero uses the root CNode itself."/>
+            <param dir="in" name="node_offset" type="seL4_Word"
+                description="Slot of the destination CNode for the first alias."/>
+            <param dir="in" name="offset" type="seL4_Word" description="Byte offset in the large frame of the first alias."/>
+            <param dir="in" name="count" type="seL4_Word" description="Number of aliases to derive."/>
+            <param dir="in" name="rights" type="seL4_CapRights_t" description="Maximum derived rights."/>
+        </method>
         <method id="ARMPageTestAndClearAccessed" name="TestAndClearAccessed"
             manual_name="Test and Clear Accessed">
             <condition><and><config var="CONFIG_ARCH_AARCH64"/><not><config var="CONFIG_ARM_HYPERVISOR_SUPPORT"/></not></and></condition>
-            <brief>Test and clear the accessed bit of a mapped 4 KiB frame.</brief>
+            <brief>Test and clear the accessed bit of a mapped 4 KiB or 2 MiB frame.</brief>
             <description>
                 The mapping is located using the capability's ASID and address,
                 and must still refer to the same frame. Clearing is atomic and
                 does not invalidate the TLB: a cached translation can delay the
                 observation of a later access. Permissions and dirty state are
-                unchanged. Larger pages and non-native mappings are unsupported.
+                unchanged. Other sizes and non-native mappings are unsupported.
             </description>
             <param dir="out" name="accessed" type="seL4_Word"
                 description="One if the accessed bit was set, otherwise zero."/>
             <error name="seL4_IllegalOperation">
-                <description>The frame is not a mapped native 4 KiB page.</description>
+                <description>The frame is not a mapped native 4 KiB or 2 MiB page.</description>
             </error>
             <error name="seL4_InvalidCapability">
                 <description>The capability's mapping is stale.</description>
