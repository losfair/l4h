#!/bin/sh
set -eu
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mode=check
# Command-line arguments are whitespace-delimited words.
# shellcheck disable=SC2013
for a in $(cat /proc/cmdline); do
    case "$a" in mode=*) mode=${a#mode=} ;; esac
done
fail() { echo "CRYPTVM: FAIL: $*"; poweroff -f; }
if ! grep -q 'plain=1' /proc/cmdline; then
    [ "$(cat /sys/block/vda/queue/logical_block_size)" = 4096 ] || fail block-size
fi
cryptblk /dev/vda "$mode" || fail data
echo "CRYPTVM: ready"
# Keep the attachment live until dom0 explicitly destroys it.
while :; do sleep 10; done
