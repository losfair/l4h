#!/bin/sh
# Init of the guest tests/guest/init-gputest creates: its virtio-gpu
# driver from the module tree, then gpudraw at the size in gpusize=.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /lib/modules
mount -t erofs -o ro /dev/l4hkmod /lib/modules || echo "GPUVM: FAIL no module tree"
modprobe virtio_gpu || echo "GPUVM: FAIL modprobe virtio_gpu"
size=$(sed -n 's/.*gpusize=\([0-9]*x[0-9]*\).*/\1/p' /proc/cmdline)
exec /bin/gpudraw "$size" < /dev/console
