#!/bin/sh
# dom0 of tests/run-gputest.sh: a VM with a virtio-gpu draws, and its
# display, read through the control API, must show what it drew.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /tmp
fail() { echo "GPUTEST: FAIL $*"; poweroff -f; exit 1; }
slow=$(sed -n 's/.*L4H_TEST_SLOW=\([0-9]*\).*/\1/p' /proc/cmdline)
slow=${slow:-1}
size=800x600
w=${size%x*} h=${size#*x}

# What the host refuses: a display too small, an I/O pool that cannot
# hold its buffers.
l4hctl create small --initrd /bin/gpuvm.cpio.gz --gpu 32x32 2>/dev/null && fail "a 32x32 display"
l4hctl create pool --initrd /bin/gpuvm.cpio.gz --io-pool 4 --gpu $size 2>/dev/null && fail "a 4 MiB I/O pool"
free0=$(l4hctl info | sed -n 's/memory: \([0-9]*\) MiB free.*/\1/p')

id=$(l4hctl create gpu --initrd /bin/gpuvm.cpio.gz --mem 192 --gpu $size \
    --cmdline "console=hvc0 gpusize=$size") || fail "create"
echo "GPUTEST: created vm $id"
l4hctl screenshot "$id" /tmp/none.ppm 2>/dev/null && fail "a screenshot before the guest shows anything"
l4hctl console "$id" --until "GPUVM: showing 1" --timeout "$((90 * slow))" > /tmp/out || { cat /tmp/out; fail "no image 1"; }
grep "GPUVM: FAIL" /tmp/out && fail "guest"
# The last flush may still be on its way.
shot() {
    for i in 1 2 3 4 5; do
        l4hctl screenshot "$id" /tmp/s.ppm && /bin/gpucheck /tmp/s.ppm "$w" "$h" "$1" && return 0
        sleep 1
    done
    return 1
}
shot 1 || fail "image 1"
l4hctl send "$id" --wait "GPUVM: showing 2" --timeout "$((30 * slow))" flip > /dev/null || fail "flip"
shot 2 || fail "image 2"
l4hctl send "$id" --wait "GPUVM: off" --timeout "$((30 * slow))" off > /dev/null || fail "off"
l4hctl screenshot "$id" /tmp/s.ppm 2>/dev/null && fail "a screenshot of a display that is off"
l4hctl destroy "$id" || fail "destroy"
free=$(l4hctl info | sed -n 's/memory: \([0-9]*\) MiB free.*/\1/p')
[ "$free" = "$free0" ] || fail "memory leak: $free0 -> $free MiB"
echo "GPUTEST: PASS"
poweroff -f
