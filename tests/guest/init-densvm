#!/bin/sh
# Init of guests created by tests/guest/init-density: optionally burn CPU
# (HOG=n background loops), answer every console line with a pong.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
if [ "${WAKE:-0}" = 1 ]; then
    /bin/vmm-wake || { poweroff -f; exit 1; }
fi
i=0
while [ "$i" -lt "${HOG:-0}" ]; do
    (while :; do :; done) &
    i=$((i + 1))
done
echo "DENSVM: ready hog=${HOG:-0}"
while read line; do
    case "$line" in
    stat) echo "DENSVM: stat $(head -1 /proc/stat)" ;;
    *) echo "DENSVM: pong $line" ;;
    esac
done
