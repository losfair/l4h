#!/bin/sh
set -eu
fail() { echo "SIGNINGTEST: FAIL $*"; poweroff -f; exit 1; }
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /lib/modules /sys/kernel/security
mount -t erofs -o ro /dev/l4hkmod /lib/modules
mount -t securityfs securityfs /sys/kernel/security
grep -q '\[integrity\]' /sys/kernel/security/lockdown || fail 'lockdown is not enforcing'
# The build output is unsigned; only the installed module tree is signed.
if insmod /bin/tcp_bic.ko; then fail 'accepted an unsigned module'; fi
modprobe tcp_bic || fail 'rejected the signed shipped module'
test -d /sys/module/tcp_bic || fail 'signed module did not load'
echo 'SIGNINGTEST: PASS (unsigned rejected, shipped module accepted under lockdown)'
poweroff -f
