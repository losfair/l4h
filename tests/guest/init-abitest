#!/bin/sh
# dom0 init of tests/run-abitest.sh: expose the SDK and load the ABI probe.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
build=/lib/modules/$(uname -r)/build
mkdir -p "$build"
if mount -t erofs -o ro /dev/l4hsdk "$build" && [ -f "$build/Module.symvers" ]; then
    echo "ABITEST: SDK $(uname -r)"
else
    echo "ABITEST: FAIL SDK"
fi
insmod /bin/l4h_abitest.ko
poweroff -f
