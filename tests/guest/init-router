#!/bin/sh
# dom0 init for tests/run-router.sh: a Debian router VM NATs an internal
# switch to the uplink; a guest on the internal switch reaches the outside.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
fail() { echo "ROUTERTEST: FAIL: $*"; poweroff -f; }
sw=$(l4hctl switch-create) || fail "switch"
r=$(l4hctl create router --mem 512 --disk 0 --nic 0 --nic "$sw" \
    --cmdline "console=hvc0 root=/dev/vda rw l4h.role=router") || fail "create router"
l4hctl console "$r" --until "ROUTER: ready" --timeout 240 | grep "ROUTER:" || fail "router did not come up"
c=$(l4hctl create client --initrd /bin/netvm.cpio.gz --mem 96 --nic "$sw" \
    --cmdline "console=hvc0 IP0=192.168.77.2/24 GW=192.168.77.1 PING=10.0.2.2") || fail "create client"
l4hctl console "$c" --until "NETVM: done" --timeout 60 > /tmp/c || fail "client"
grep -q "NETVM: ping 10.0.2.2 ok" /tmp/c || { cat /tmp/c; fail "client cannot reach the outside through the router"; }
echo "ROUTERTEST: client reached 10.0.2.2 through the NAT router"
l4hctl switch 0
l4hctl switch "$sw"
l4hctl destroy "$c"
l4hctl destroy "$r"
echo "ROUTERTEST: PASS"
poweroff -f
