#!/bin/sh
# Init of the HVM guest tests/guest/init-hvmscale creates: an unmodified
# Linux on many vCPUs.  getpid on one process per CPU of each range
# (getpidscale: 1, 16, 32, ... and all), then smpbench (compute, getpid,
# page faults, fork, pipe and futex ping-pong) at 1, 2, 4, ... and all
# CPUs.  smpbench's warmup pass is printed too: its page faults are the
# guest's first touch of that memory (EPT faults on the host).
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mount -t tmpfs tmp /tmp
n=$(nproc)
echo "HVMSCALE: up, kernel $(uname -r), cpus $n online=$(cat /sys/devices/system/cpu/online)"
echo "HVMSCALE: cpu $(grep -m1 "model name" /proc/cpuinfo | cut -d: -f2)"
for v in /sys/devices/system/cpu/vulnerabilities/*; do echo "HVMSCALE: vuln ${v##*/}: $(cat "$v")"; done
echo "HVMSCALE: cmdline $(cat /proc/cmdline)"
echo "HVMSCALE: clock $(cat /sys/devices/system/clocksource/clocksource0/current_clocksource)"
ranges=0
k=16
while [ "$k" -lt "$n" ]; do
    ranges="$ranges 0-$((k - 1))"
    k=$((k * 2))
done
ranges="$ranges 0-$((n - 1))"
# Let the boot log drain first: console output slows the guest.
sleep 2
ok=1
# HVMEXIT=1: the VM exit round trip (CPUID) on CPUs 0, 1, the middle
# and the last, then cross-CPU ping-pong alone.
if [ -n "$HVMEXIT" ]; then
    /bin/exitlat 0 1 $((n / 2)) $((n - 1)) > /tmp/out 2>&1 || ok=
    sed 's/^/HVMSCALE: /' /tmp/out
    /bin/smpbench 2 > /tmp/out 2>&1 || ok=
    grep -E 'phase=measured metric=(pipe|futex)' /tmp/out | sed 's/^/HVMSCALE: /'
    if [ -n "$ok" ]; then echo 'HVMSCALE: guest PASS'; else echo 'HVMSCALE: guest FAIL exitlat'; fi
    echo 'HVMSCALE: guest done'
    poweroff -f
fi
# HVMFORK=1 (gce-bench HVM_ARGS): fork scaling alone, about 2 s per count.
if [ -n "$HVMFORK" ]; then
    k=1 counts=
    while [ "$k" -lt "$n" ]; do counts="$counts $k"; k=$((k * 2)); done
    [ "$n" -gt 16 ] && counts="$counts $((n * 3 / 4))"
    /bin/forkscale $counts $n > /tmp/out 2>&1 || ok=
    sed 's/^/HVMSCALE: /' /tmp/out
    if [ -n "$ok" ]; then echo 'HVMSCALE: guest PASS'; else echo 'HVMSCALE: guest FAIL forkscale'; fi
    echo 'HVMSCALE: guest done'
    poweroff -f
fi
for r in $ranges; do
    /bin/getpidscale "$r" > /tmp/out 2>&1 || ok=
    sed 's/^/HVMSCALE: /' /tmp/out
done
k=1
while :; do
    echo "HVMSCALE: smpbench workers=$k"
    /bin/smpbench "$k" > /tmp/out 2>&1 || ok=
    grep -E '^SMPBENCH: (phase=|FAIL)' /tmp/out | grep -vE 'phase=warmup metric=(compute|getpid|pipe|futex)' \
        | sed 's/^/HVMSCALE: /'
    [ "$k" -ge "$n" ] && break
    k=$((k * 2))
    [ "$k" -gt "$n" ] && k=$n
done
if [ -n "$ok" ]; then
    echo 'HVMSCALE: guest PASS'
else
    echo 'HVMSCALE: guest FAIL benchmark exit'
fi
echo 'HVMSCALE: guest done'
poweroff -f
