#!/bin/sh
# dom0 init for tests/run-uefitest.sh and tests/run-biostest.sh.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
echo "IMAGETEST: dom0 up"
if [ -b /dev/l4hsdk ] && mount -t erofs -o ro /dev/l4hsdk /mnt; then
    [ -f /mnt/Module.symvers ] && echo "IMAGETEST: SDK mounted"
    umount /mnt
fi
echo "IMAGETEST: cmdline $(cat /proc/cmdline)"
echo "IMAGETEST: version $(l4hctl version)"
l4hctl info
l4hctl disks
l4hctl nics
ip link set lo up
ip link set eth0 up
if udhcpc -i eth0 -n -q -t 5 -s /bin/udhcpc.script >/dev/null 2>&1 && ping -c 2 -W 2 10.0.2.2 >/dev/null; then
    echo "IMAGETEST: network ok"
fi
if grep -q imagetest=bios /proc/cmdline; then
    # The title bar of the dashboard: tests/dashboard-qemu.py looks at the
    # screen after each line.
    echo "IMAGETEST: title default"
    sleep 5
    l4hctl dashboard-title "biostest dashboard title" && echo "IMAGETEST: title set"
    sleep 5
    l4hctl dashboard-title && echo "IMAGETEST: title reset"
    sleep 5
fi
echo "IMAGETEST: done"
poweroff -f
