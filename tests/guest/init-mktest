#!/bin/sh
# dom0 init for tests/run-mktest.sh: one per partition, MKP the partition.
# With attest_nonce= (MK_ATTEST=1), dom0's report, the evidence, the VM's
# report and (with /bin/cred) the credential's secret go to the start of
# the partition's disk as a tar archive.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /tmp
P=${MKP:-0}
nonce=$(sed -n 's/.*attest_nonce=\([0-9a-f]*\).*/\1/p' /proc/cmdline)
say() { echo "MKTEST p$P: $*"; }
fail() { say "FAIL: $*"; sleep 100000; }
say start
l4hctl info || fail "l4hctl info"
l4hctl disks
ip link set lo up
ip link set eth0 up
udhcpc -i eth0 -n -q -t 5 -s /bin/udhcpc.script >/dev/null 2>&1 || fail "dhcp over the uplink"
ping -c 2 -W 2 10.0.2.2 >/dev/null || fail "ping the uplink gateway"
say "uplink ok: $(ip -4 addr show eth0 | sed -n 's/.*inet \([0-9.\/]*\).*/\1/p')"
# The link to partition MKPEER (link.pA-pB): dom0's other vNIC, on the
# switch with the link port.  Set it up now, so that the peer's pings
# find it while this side does the rest.
if [ -n "${MKPEER:-}" ]; then
    lif=$(ls /sys/class/net | grep '^eth' | grep -vx eth0 | head -1)
    [ -n "$lif" ] || fail "no vNIC for the link"
    ip link set "$lif" up
    ip addr add "192.168.100.$((10 + P))/24" dev "$lif" || fail "link address"
fi
if [ -n "$nonce" ]; then
    mkdir -p /tmp/att
    l4hctl attest report "$nonce" -o /tmp/att/dom0.report || fail "dom0 report"
    l4hctl attest evidence -o /tmp/att/evidence || fail "evidence"
    if [ -f /bin/cred ]; then
        l4hctl attest activate /bin/cred > /tmp/att/secret || fail "activate the credential"
    fi
fi
# A VM of its own, which only this partition's dom0 sees.
id=$(l4hctl create "vm-p$P" --initrd /bin/vm.cpio.gz --mem 96 \
    --cmdline "console=hvc0 MKP=$P${nonce:+ attest_nonce=$nonce}") || fail "create a VM"
l4hctl console "$id" --until "MKVM: done" --timeout 60 > /tmp/vm || fail "the VM did not finish"
[ "$(l4hctl list | grep -c vm-p)" = 1 ] || fail "dom0 sees another partition's VM"
say "vm ok"
if [ -n "${MKPEER:-}" ]; then
    # The peer's dom0 may still be booting: retry for a while.
    peer=192.168.100.$((10 + MKPEER))
    i=0
    until ping -c 1 -W 1 "$peer" >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -lt 90 ] || fail "ping p$MKPEER over the link"
    done
    say "link ok: $(ping -c 3 -W 2 "$peer" | grep 'packets transmitted')"
    if [ "$P" = 1 ]; then
        # Flood the link (busybox ping has no -f: pings that each send
        # again on a reply) while control traffic crosses, the heartbeats
        # and rtc-set below: frames have a channel of their own and must
        # not overwrite it.
        for j in 1 2 3 4 5 6 7 8; do
            ping -q -A -s 8000 -w 10 "$peer" > "/tmp/flood$j" 2>&1 &
        done
        flooding=1
    fi
fi
if [ -n "$MKIOMMU" ]; then
    # The host disk (dom0 took none) to VMs in turn: each attaches an
    # I/O pool to the controller's IOMMU domain and drains it at destroy,
    # every partition at once on the shared command queues. Quiet: the
    # consoles share one serial port a character at a time.
    l4hctl destroy "$id" || fail "destroy the VM"
    for round in 1 2; do
        d=$(l4hctl create "disk-p$P" --initrd /bin/vm.cpio.gz --mem 96 --disk 0 \
            --cmdline "console=hvc0 quiet MKP=$P MKDISK=$round") || fail "create a disk VM"
        l4hctl console "$d" --until "MKVM: done" --timeout 60 > /tmp/vm || fail "the disk VM did not finish"
        grep -q "MKVM: disk ok" /tmp/vm || fail "disk I/O through the IOMMU: $(grep MKVM /tmp/vm)"
        l4hctl destroy "$d" || fail "destroy the disk VM"
    done
    say "pool drained"
    l4hctl iommu | sed "s/^/MKTEST p$P: iommu /"
fi
if [ -n "$nonce" ]; then
    # Through the disk: on the serial port other cores' output can
    # interleave with a long line.
    sed -n 's/^MKVM: report \([0-9a-f]*\).*/\1/p' /tmp/vm > /tmp/att/vm.report.hex
    [ -s /tmp/att/vm.report.hex ] || fail "no report from the VM"
    tar -cf /dev/vda -C /tmp/att . && sync || fail "save the attestation"
    say "attestation saved"
fi
if [ "$P" != 0 ]; then
    if l4hctl host-reboot 2>/tmp/err; then fail "host-reboot accepted"; fi
    say "host-reboot refused: $(cat /tmp/err)"
    # The RTC is partition 0's: setting it goes there.
    l4hctl rtc-set || fail "rtc-set"
fi
if [ -n "${flooding:-}" ]; then
    wait
    sum() { cat /tmp/flood* | sed -n "s/^\([0-9]*\) packets transmitted, \([0-9]*\) packets received.*/\\$1/p" | awk '{s += $1} END {print s + 0}'; }
    tx=$(sum 1) rx=$(sum 2)
    [ "$rx" -gt 0 ] || fail "flood: no replies"
    say "flood ok: $rx of $tx pings of 8000 bytes answered"
fi
say done
if [ "$P" = 0 ]; then
    # Let the other partitions finish, then reset the machine.
    sleep "${MKWAIT:-30}"
    say "host-reboot"
    l4hctl host-reboot
    fail "host-reboot returned"
fi
sleep 100000
