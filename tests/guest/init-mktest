#!/bin/sh
# dom0 init for tests/run-mktest.sh: one per partition, MKP the partition.
# With attest_nonce= (MK_ATTEST=1), dom0's report, the evidence, the VM's
# report and (with /bin/cred) the credential's secret go to the start of
# the partition's disk as a tar archive.
# With MKSAVE=1 (MK_EFI=, a release build, whose host does not put dom0's
# console on the serial port), this partition's MKTEST lines go there
# instead, as mktest.log, once dom0 is done or fails.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /tmp
P=${MKP:-0}
nonce=$(sed -n 's/.*attest_nonce=\([0-9a-f]*\).*/\1/p' /proc/cmdline)
say() { echo "MKTEST p$P: $*"; [ -z "${MKSAVE:-}" ] || echo "MKTEST p$P: $*" >> /tmp/mktest.log; }
save() { [ -z "${MKSAVE:-}" ] || { tar -cf /dev/vda -C /tmp mktest.log && sync; }; }
fail() { say "FAIL: $*"; save; sleep 100000; }
say start
l4hctl info || fail "l4hctl info"
l4hctl disks
ip link set lo up
ip link set eth0 up
udhcpc -i eth0 -n -q -t 5 -s /bin/udhcpc.script >/dev/null 2>&1 || fail "dhcp over the uplink"
# MKDNS=: a resolver instead of DHCP's (GCE's metadata server answers on
# a VM's first NIC only).
[ -z "${MKDNS:-}" ] || echo "nameserver $MKDNS" > /etc/resolv.conf
# MKGW=: the gateway when DHCP names none (GCE leases one to a VM's first
# NIC only; on the others it is the subnet's first address).
if [ -n "${MKGW:-}" ] && ! ip route | grep -q '^default'; then
    ip route add "$MKGW" dev eth0
    ip route add default via "$MKGW" dev eth0
fi
# MKURL= (tests/gce-mktest.sh): a download through the uplink instead of
# QEMU's gateway.
if [ -n "${MKURL:-}" ]; then
    i=0
    until wget -q -T 15 -O /tmp/uplink "$MKURL"; do
        i=$((i + 1))
        if [ "$i" -ge 5 ]; then
            gw=$(ip route | sed -n 's/^default via \([0-9.]*\).*/\1/p')
            say "address $(ip -4 addr show eth0 | sed -n 's/.*inet \([0-9.\/]*\).*/\1/p'), gateway $gw, $(cat /etc/resolv.conf | tr '\n' ' ')"
            say "ping gateway: $(ping -c 2 -W 2 "$gw" 2>&1 | grep -a 'packets transmitted')"
            say "ping 8.8.8.8: $(ping -c 2 -W 2 8.8.8.8 2>&1 | grep -a 'packets transmitted')"
            say "nslookup: $(nslookup deb.debian.org 2>&1 | tr '\n' ' ' | cut -c1-200)"
            fail "download $MKURL over the uplink"
        fi
    done
    say "downloaded $(wc -c < /tmp/uplink) bytes over the uplink"
else
    ping -c 2 -W 2 10.0.2.2 >/dev/null || fail "ping the uplink gateway"
fi
say "uplink ok: $(ip -4 addr show eth0 | sed -n 's/.*inet \([0-9.\/]*\).*/\1/p')"
# The link to partition MKPEER (link.pA-pB): dom0's other vNIC, on the
# switch with the link port.  Set it up now, so that the peer's pings
# find it while this side does the rest.
if [ -n "${MKPEER:-}" ]; then
    lif=$(ls /sys/class/net | grep '^eth' | grep -vx eth0 | head -1)
    [ -n "$lif" ] || fail "no vNIC for the link"
    ip link set "$lif" up
    ip addr add "192.168.100.$((10 + P))/24" dev "$lif" || fail "link address"
fi
if [ -n "$nonce" ]; then
    mkdir -p /tmp/att
    l4hctl attest report "$nonce" -o /tmp/att/dom0.report || fail "dom0 report"
    l4hctl attest evidence -o /tmp/att/evidence || fail "evidence"
    if [ -f /bin/cred ]; then
        l4hctl attest activate /bin/cred > /tmp/att/secret || fail "activate the credential"
    fi
fi
# A VM of its own, which only this partition's dom0 sees.
id=$(l4hctl create "vm-p$P" --initrd /bin/vm.cpio.gz --mem 96 \
    --cmdline "console=hvc0 MKP=$P${nonce:+ attest_nonce=$nonce}") || fail "create a VM"
l4hctl console "$id" --until "MKVM: done" --timeout 60 > /tmp/vm || fail "the VM did not finish"
[ "$(l4hctl list | grep -c vm-p)" = 1 ] || fail "dom0 sees another partition's VM"
say "vm ok"
if [ -n "${MKPEER:-}" ]; then
    # The peer's dom0 may still be booting: retry for a while.
    peer=192.168.100.$((10 + MKPEER))
    i=0
    until ping -c 1 -W 1 "$peer" >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -lt 90 ] || fail "ping p$MKPEER over the link"
    done
    say "link ok: $(ping -c 3 -W 2 "$peer" | grep 'packets transmitted')"
    if [ -n "${MKSTRESS:-}" ]; then
        # MKSTRESS seconds of everything at once, both ways: floods of
        # big pings, HTTP downloads of the VM's initramfs (the same file
        # on both sides) checked against the local copy, and VMs made and
        # destroyed one after another.
        mkdir -p /tmp/www && cp /bin/vm.cpio.gz /tmp/www/blob
        httpd -p 8080 -h /tmp/www
        want=$(sha256sum < /bin/vm.cpio.gz)
        for j in 1 2 3 4 5 6 7 8; do
            ping -q -A -s 8000 -w "$MKSTRESS" "$peer" > "/tmp/flood$j" 2>&1 &
        done
        end=$(($(date +%s) + MKSTRESS))
        (n=0 bad=0 err=0
         while [ "$(date +%s)" -lt "$end" ]; do
            rm -f /tmp/got
            if ! wget -q -T 20 -O /tmp/got "http://$peer:8080/blob"; then
                err=$((err + 1))
            elif [ "$(sha256sum < /tmp/got)" = "$want" ]; then
                n=$((n + 1))
            else
                bad=$((bad + 1))
                say "corrupted download: $(wc -c < /tmp/got) of $(wc -c < /bin/vm.cpio.gz) bytes, $(cmp /tmp/got /bin/vm.cpio.gz 2>&1 | head -1)"
            fi
         done
         echo "$n $bad $err" > /tmp/xfer) &
        (n=0
         while [ "$(date +%s)" -lt "$end" ]; do
            v=$(l4hctl create "churn-p$P" --initrd /bin/vm.cpio.gz --mem 64 \
                --cmdline "console=hvc0 quiet MKP=$P") || break
            l4hctl console "$v" --until "MKVM: done" --timeout 60 > /dev/null || break
            l4hctl destroy "$v" || break
            n=$((n + 1))
         done
         [ "$(date +%s)" -ge "$end" ] && echo "$n" > /tmp/churn || echo "fail after $n" > /tmp/churn) &
        wait
        read n bad err < /tmp/xfer
        [ "$bad" = 0 ] || fail "stress: $bad of $((n + bad)) downloads over the link corrupted"
        [ "$n" -gt 0 ] || fail "stress: no download over the link ($err failed)"
        case $(cat /tmp/churn) in fail*) fail "stress: VM churn: $(cat /tmp/churn)" ;; esac
        tx=0 rx=0
        for f in /tmp/flood*; do
            set -- $(sed -n 's/^\([0-9]*\) packets transmitted, \([0-9]*\) packets received.*/\1 \2/p' "$f")
            tx=$((tx + ${1:-0})) rx=$((rx + ${2:-0}))
        done
        say "stress ok: $n downloads intact ($err failed), $rx of $tx pings answered, $(cat /tmp/churn) VMs"
    elif [ "$P" = 1 ]; then
        # Flood the link (busybox ping has no -f: pings that each send
        # again on a reply) while control traffic crosses, the heartbeats
        # and rtc-set below: frames have a channel of their own and must
        # not overwrite it.
        for j in 1 2 3 4 5 6 7 8; do
            ping -q -A -s 8000 -w 10 "$peer" > "/tmp/flood$j" 2>&1 &
        done
        flooding=1
    fi
fi
if [ -n "$MKIOMMU" ]; then
    # The host disk (dom0 took none) to VMs in turn: each attaches an
    # I/O pool to the controller's IOMMU domain and drains it at destroy,
    # every partition at once on the shared command queues. Quiet: the
    # consoles share one serial port a character at a time.
    l4hctl destroy "$id" || fail "destroy the VM"
    for round in 1 2; do
        d=$(l4hctl create "disk-p$P" --initrd /bin/vm.cpio.gz --mem 96 --disk 0 \
            --cmdline "console=hvc0 quiet MKP=$P MKDISK=$round") || fail "create a disk VM"
        l4hctl console "$d" --until "MKVM: done" --timeout 60 > /tmp/vm || fail "the disk VM did not finish"
        grep -q "MKVM: disk ok" /tmp/vm || fail "disk I/O through the IOMMU: $(grep MKVM /tmp/vm)"
        l4hctl destroy "$d" || fail "destroy the disk VM"
    done
    say "pool drained"
    l4hctl iommu | sed "s/^/MKTEST p$P: iommu /"
fi
if [ -n "$nonce" ]; then
    # With the other files of the attestation, on the disk.
    sed -n 's/^MKVM: report \([0-9a-f]*\).*/\1/p' /tmp/vm > /tmp/att/vm.report.hex
    [ -s /tmp/att/vm.report.hex ] || fail "no report from the VM"
    tar -cf /dev/vda -C /tmp/att . && sync || fail "save the attestation"
    say "attestation saved"
fi
if [ "$P" != 0 ]; then
    if l4hctl host-reboot 2>/tmp/err; then fail "host-reboot accepted"; fi
    say "host-reboot refused: $(cat /tmp/err)"
    # The RTC is partition 0's: setting it goes there.
    l4hctl rtc-set || fail "rtc-set"
fi
if [ -n "${flooding:-}" ]; then
    wait
    sum() { cat /tmp/flood* | sed -n "s/^\([0-9]*\) packets transmitted, \([0-9]*\) packets received.*/\\$1/p" | awk '{s += $1} END {print s + 0}'; }
    tx=$(sum 1) rx=$(sum 2)
    [ "$rx" -gt 0 ] || fail "flood: no replies"
    say "flood ok: $rx of $tx pings of 8000 bytes answered"
fi
say done
save || fail "save the log"
if [ "$P" = 0 ]; then
    # Let the other partitions finish, then reset the machine.
    sleep "${MKWAIT:-30}"
    say "host-reboot"
    l4hctl host-reboot
    fail "host-reboot returned"
fi
sleep 100000
