#!/bin/sh
# A/B initramfs, PCI inventory and a data window that follows disk size.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
fail() { echo "PLATFORMTEST: FAIL $*"; poweroff -f; }
slot=$(cat /bin/platform-slot)
echo "PLATFORMTEST: initrd $slot"
grep -q "platform_slot=$slot" /proc/cmdline || fail 'wrong l4h.conf'
l4hctl pci > /tmp/pci || fail 'PCI list'
grep -q 'owner blkd' /tmp/pci || fail 'PCI disk owner'
grep -q 'owner netd' /tmp/pci || fail 'PCI NIC owner'
grep -q 'owner memd' /tmp/pci || fail 'PCI balloon owner'
grep -q 'owner firmware' /tmp/pci || fail 'PCI unclaimed xHCI owner'
echo "PLATFORMTEST: PCI_JSON $(l4hctl pci --json)"
capacity=$(l4hctl disks | sed -n 's/^disk 0: .*sectors \([0-9]*\), attachments.*/\1/p')
[ -n "$capacity" ] || fail 'host capacity'
sectors=$(cat /sys/class/block/vda/size)
[ "$sectors" -eq "$(((capacity - 2048) / 8 * 8 - 786432))" ] || fail "window size $sectors of $capacity"
echo "PLATFORMTEST: geometry $capacity $sectors"
head -c 4096 /dev/zero | tr '\000' '\132' | dd of=/dev/vda bs=4096 count=1 2>/dev/null || fail 'first block'
head -c 4096 /dev/zero | tr '\000' '\153' | dd of=/dev/vda bs=4096 seek="$((sectors / 8 - 1))" count=1 2>/dev/null || fail 'last block'
if dd if=/dev/zero of=/dev/vda bs=4096 seek="$((sectors / 8))" count=1 2>/dev/null; then fail 'write past window'; fi
sync
echo "PLATFORMTEST: PASS $slot"
poweroff -f
