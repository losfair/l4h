#!/bin/sh
# Called by the Debian NAT router test, under confidentiality lockdown.
set -eu
trap 'echo "TPROXY: FAIL: router setup, traffic or counters"' 0
[ -e /sys/kernel/security/lockdown ] || mount -t securityfs securityfs /sys/kernel/security
grep -Fq '[confidentiality]' /sys/kernel/security/lockdown
[ -z "$(cat /proc/modules)" ]
# Disable loading before installing native proxy rules: expressions and their
# dependencies must already be built in, even if signed modules are available.
sysctl -q -w kernel.modules_disabled=1
zcat /proc/config.gz > /tmp/tproxy.config
for option in NFT_TPROXY NFT_SOCKET NF_TPROXY_IPV4 NF_TPROXY_IPV6 \
    NF_SOCKET_IPV4 NF_SOCKET_IPV6 NF_DEFRAG_IPV4 NF_DEFRAG_IPV6 \
    IP_MULTIPLE_TABLES IPV6_MULTIPLE_TABLES; do
    grep -qx "CONFIG_$option=y" /tmp/tproxy.config || {
        echo "TPROXY: FAIL: CONFIG_$option is not built in"
        exit 1
    }
done

# Install the issue's minimal inet-family acceptance probe before the data test.
nft -f - <<'NFT'
table inet l4h_tproxy_probe {
    chain prerouting {
        type filter hook prerouting priority mangle; policy accept;
        meta l4proto { tcp, udp } socket transparent 1 counter accept
        meta l4proto { tcp, udp } tproxy ip to 127.0.0.1:12345 meta mark set 0x1 accept
        meta l4proto { tcp, udp } tproxy ip6 to [::1]:12345 meta mark set 0x1 accept
    }
}
NFT
nft delete table inet l4h_tproxy_probe
echo "TPROXY: native inet rules installed under confidentiality lockdown, modules disabled"

ip -6 addr add fd77::1/64 dev eth1 nodad
ip rule add fwmark 1 lookup 100
ip route add local 0.0.0.0/0 dev lo table 100
ip -6 rule add fwmark 1 lookup 100
ip -6 route add local ::/0 dev lo table 100

nft add table inet l4h_tproxy
for family in 4 6; do
    for proto in tcp udp; do
        nft -f - <<NFT
add counter inet l4h_tproxy ${proto}${family}_socket
add counter inet l4h_tproxy ${proto}${family}_tproxy
NFT
    done
done
nft 'add chain inet l4h_tproxy prerouting { type filter hook prerouting priority mangle; policy accept; }'
for family in 4 6; do
    case "$family" in
        4) nfproto=ipv4; target='ip to 127.0.0.1:12345' ;;
        6) nfproto=ipv6; target='ip6 to [::1]:12345' ;;
    esac
    for proto in tcp udp; do
        nft -f - <<NFT
add rule inet l4h_tproxy prerouting iifname "eth1" meta nfproto $nfproto meta l4proto $proto socket transparent 1 counter name ${proto}${family}_socket meta mark set 1 accept
add rule inet l4h_tproxy prerouting iifname "eth1" meta nfproto $nfproto $proto dport 4242 tproxy $target counter name ${proto}${family}_tproxy meta mark set 1 accept
NFT
    done
done

l4h-tproxy server
for family in 4 6; do
    for proto in tcp udp; do
        for expression in socket tproxy; do
            name=${proto}${family}_$expression
            nft list counter inet l4h_tproxy "$name" > /tmp/tproxy.counter
            grep -Eq 'packets [1-9][0-9]* bytes' /tmp/tproxy.counter || {
                cat /tmp/tproxy.counter
                echo "TPROXY: FAIL: $name did not match"
                exit 1
            }
            echo "TPROXY: $name matched"
        done
    done
done
[ -z "$(cat /proc/modules)" ]
[ "$(cat /proc/sys/kernel/modules_disabled)" = 1 ]
nft delete table inet l4h_tproxy
trap - 0
echo "TPROXY: router PASS"
