#!/bin/sh
# dom0 init for tests/run-kexec-attesttest.sh: kexec_next=N kexecs with
# l4h/kexecN.conf; kexec_done attests.
fail() {
    echo "KEXECATTEST: FAIL $*"
    poweroff -f
    exit 1
}
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
next=
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        kexec_done) exec /bin/init-attest ;;
        kexec_next=*) next=${arg#kexec_next=} ;;
    esac
done
[ -n "$next" ] || fail "no kexec_next"
mkdir -p /boot/efi
mount -t vfat /dev/vda1 /boot/efi || fail "mount ESP"
l4hctl host-kexec --efi /boot/efi/l4h/next.efi \
    --initrd /boot/efi/l4h/dom0/initrd --conf /boot/efi/l4h/kexec$next.conf || fail "kexec $next"
fail "EXEC returned"
