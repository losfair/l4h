#!/bin/sh
# dom0 init for tests/run-hvmbench.sh: the same workload (init-vmcmp) in a
# PV guest, then in an HVM guest, one at a time, with the same memory,
# vCPUs, disk region and switch; a PV TCP sink on the switch.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /tmp
fail() { echo "HVMBENCH: FAIL: $*"; l4hctl list; poweroff -f; }
mem=${HB_MEM:-1024} vcpus=${HB_VCPUS:-1} kinds=$(echo "${HB_KINDS:-pv,hvm}" | tr , " ") reps=${HB_REPS:-1}
echo "HVMBENCH: start, guests ${mem} MiB, $vcpus vCPU"
sw=$(l4hctl switch-create) || fail "switch-create"
sink=$(l4hctl create sink --initrd /bin/benchvm.cpio.gz --mem 256 --nic "$sw" --cmdline "console=hvc0") || fail "sink"
l4hctl console "$sink" --until "BENCHVM: ready" --timeout 120 >/dev/null || fail "sink not ready"
for r in $(seq 1 "$reps"); do
for kind in $kinds; do
    case $kind in
    pv)  args="--initrd /bin/vmcmp.cpio.gz"; cmd="console=hvc0${HB_SPIN:+ spin}" ;;
    hvm) args="--hvm --kernel /bin/bzImage --initrd /bin/vmcmp.cpio.gz"; cmd="console=ttyS0${HB_SPIN:+ spin}" ;;
    esac
    t0=$(mstime)
    id=$(l4hctl create "$kind$r" $args --cmdline "$cmd" --mem "$mem" --vcpus "$vcpus" --disk 0 --nic "$sw") || fail "create $kind"
    l4hctl console "$id" --until "VMCMP: up" --timeout 120 > /tmp/up || { cat /tmp/up; fail "$kind did not boot"; }
    t1=$(mstime)
    l4hctl console "$id" --until "VMCMP: done" --timeout 600 > /tmp/out || { cat /tmp/out; fail "$kind did not finish"; }
    tr -d "\r" < /tmp/out | grep "VMCMP: \|BENCH:" | sed "s/^/HVMBENCH: [$kind] /"
    t2=$(mstime)
    echo "HVMBENCH: [$kind] BENCH: create to init          $((t1 - t0)) ms"
    echo "HVMBENCH: [$kind] workload took $((t2 - t1)) ms"
    l4hctl destroy "$id" || fail "destroy $kind"
done
done
l4hctl destroy "$sink"
echo "HVMBENCH: done"
poweroff -f
