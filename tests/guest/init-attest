#!/bin/sh
# dom0 init for tests/run-attesttest.sh: print a report on dom0 and on a
# guest it starts, the host evidence, and (second boot) the secret of the
# credential in /bin/cred; with /bin/bzImage, a report on an HVM guest that
# runs it.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t configfs none /sys/kernel/config
nonce=$(sed -n 's/.*attest_nonce=\([0-9a-f]*\).*/\1/p' /proc/cmdline)
echo "ATTEST: dom0 up"
# Seal console input before the report, as a measured initramfs does: the
# verifier requires it by default (input after the report is unattested).
l4hctl attest seal console-in >/dev/null || echo "ATTEST: seal failed"
if l4hctl attest report "$nonce" -o /tmp/report; then
    echo "ATTEST: dom0 report $(l4hctl attest report "$nonce")"
    echo "ATTEST: evidence $(l4hctl attest evidence)"
fi
# configfs-tsm gives the same report (it is deterministic) and evidence.
r=/sys/kernel/config/tsm/report/r0
if mkdir $r 2>/dev/null; then
    echo "ATTEST: tsm provider $(cat $r/provider)"
    i=0 data=
    while [ $i -lt ${#nonce} ]; do
        data="$data\\x$(echo "$nonce" | cut -c$((i + 1))-$((i + 2)))"
        i=$((i + 2))
    done
    printf "$data" > $r/inblob
    cat $r/outblob > /tmp/tsm-report
    cmp -s /tmp/report /tmp/tsm-report && echo "ATTEST: tsm report matches"
    l4hctl attest evidence -o /tmp/evidence
    cat $r/auxblob | cmp -s /tmp/evidence - && echo "ATTEST: tsm evidence matches"
    rmdir $r
fi
if [ -f /bin/cred ]; then
    echo "ATTEST: secret $(l4hctl attest activate /bin/cred)"
    # The first activation creates the EK and may take over a second,
    # refilling its allowance. Start the burst test with the EK cached
    # and a full allowance, then check refusal and recovery.
    sleep 2
    n=0
    while [ $n -lt 20 ] && l4hctl attest activate /bin/cred >/dev/null 2>/tmp/err; do
        n=$((n + 1))
    done
    echo "ATTEST: limited after $n: $(cat /tmp/err)"
    sleep 2
    l4hctl attest activate /bin/cred >/dev/null && echo "ATTEST: activated after a pause"
fi
if [ -f /bin/vm.cpio.gz ]; then
    # The host copies its console to the serial port.
    id=$(l4hctl create attestvm --initrd /bin/vm.cpio.gz --mem 64 \
        --cmdline "console=hvc0 quiet attest_nonce=$nonce") && \
        l4hctl console "$id" --until "ATTESTVM: done" --timeout 60 >/dev/null
    sleep 1
fi
if [ -f /bin/bzImage ]; then
    # An HVM guest (DESIGN.md §5.11): an unmodified Linux under
    # lockdown=confidentiality, whose userspace gets a report as any
    # guest's through the machine's attestation port.  What the host
    # needs to compute its launch digest goes to the serial port.
    hvm_cmdline="console=ttyS0 quiet lockdown=confidentiality ATTEST=$nonce"
    if id=$(l4hctl create attesthvm --hvm --kernel /bin/bzImage --initrd /bin/hvmvm.cpio.gz --mem 192 \
        --cmdline "$hvm_cmdline" 2>/tmp/err); then
        echo "ATTEST: hvm cmdline $hvm_cmdline"
        echo "ATTEST: hvm layout $(l4hctl hvm-layout /bin/bzImage --initrd /bin/hvmvm.cpio.gz --mem 192)"
        l4hctl console "$id" --until "HVMVM: ready" --timeout 120 > /tmp/hvm.out
        tr -d '\r' < /tmp/hvm.out | sed -n 's/^HVMVM: \(lockdown\|attest\|report\|no \)/ATTEST: hvm \1/p'
        l4hctl destroy "$id"
    else
        echo "ATTEST: no hvm: $(cat /tmp/err)"
    fi
fi
if [ -x /bin/flags-test ]; then
    /bin/flags-test dom0 || echo "FLAGS: FAIL"
fi
echo "ATTEST: done"
poweroff -f
