#!/bin/sh
slow=${L4H_TEST_SLOW:-1}
# dom0 init for tests/run-ctltest.sh: drive the control API with l4hctl.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /tmp
fail() { echo "CTLTEST: FAIL: $*"; poweroff -f; }
echo "CTLTEST: start"
version=$(l4hctl version) || fail "version"
[ "$version" = "$(cat /bin/host-version)" ] || fail "host version: $version"
echo "CTLTEST: version $version"
l4hctl info || fail "info"
l4hctl iommu | sed 's/^/CTLTEST: iommu /' || fail "iommu"
l4hctl disks
free0=""
for i in 1 2 3; do
    id=$(l4hctl create vm$i --initrd /bin/vm.cpio.gz --mem 128 --vcpus 2) || fail "create $i"
    echo "CTLTEST: created vm $id"
    l4hctl console "$id" --until "GUEST: ready" --timeout "$((60 * slow))" >/dev/null || fail "vm $id did not boot"
    l4hctl list
    l4hctl send "$id" "ping $i"
    l4hctl console "$id" --until "GUEST: got ping $i" --timeout "$((30 * slow))" >/dev/null || fail "console input"
    l4hctl destroy "$id" || fail "destroy"
    free=$(l4hctl info | sed -n 's/memory: \([0-9]*\) MiB free.*/\1/p')
    echo "CTLTEST: round $i ok, $free MiB free"
    if [ -n "$free0" ] && [ "$free" != "$free0" ]; then fail "memory leak: $free0 -> $free MiB"; fi
    free0=$free
done
# The largest I/O pool needs a 2 MiB VMM mapping CNode. Its CNodes are
# allocated at VM_CREATE and must survive loading, start, and reclaim.
id=$(l4hctl create largepool --initrd /bin/vm.cpio.gz --mem 128 --io-pool 256) || fail "create large I/O pool"
l4hctl console "$id" --until "GUEST: ready" --timeout "$((60 * slow))" >/dev/null || fail "large I/O pool boot"
l4hctl destroy "$id" || fail "destroy large I/O pool"
free=$(l4hctl info | sed -n 's/memory: \([0-9]*\) MiB free.*/\1/p')
[ "$free" = "$free0" ] || fail "large I/O pool memory leak: $free0 -> $free MiB"
echo "CTLTEST: large I/O pool started and reclaimed"
# Disk pass-through to a guest, twice: the second sees the first's write.
# The second attachment is volatile: offered no flush, the guest treats
# the disk as write-through and its writes still reach the disk.
for i in 1 2; do
    flags=; cache="write back"
    [ $i = 2 ] && { flags=,volatile; cache="write through"; }
    id=$(l4hctl create disk$i --initrd /bin/vm.cpio.gz --mem 128 --disk 0$flags) || fail "create disk$i"
    l4hctl console "$id" --until "GUEST: disk ok" --timeout "$((60 * slow))" > /tmp/out || fail "disk vm $i"
    grep -q "GUEST: disk count $((i - 1))" /tmp/out || { cat /tmp/out; fail "disk count"; }
    grep -q "GUEST: vda size .* cache $cache" /tmp/out || { cat /tmp/out; fail "disk $i cache"; }
    l4hctl disks > /tmp/disks && grep -q "owner vm $id" /tmp/disks || fail "disk owner"
    l4hctl destroy "$id" || fail "destroy disk$i"
done
# Clean shutdown on request.
id=$(l4hctl create shut --initrd /bin/vm.cpio.gz --mem 128) || fail "create shut"
l4hctl console "$id" --until "GUEST: ready" --timeout "$((60 * slow))" >/dev/null || fail "shut vm boot"
l4hctl shutdown "$id" || fail "shutdown request"
l4hctl console "$id" --until "GUEST: shutting down" --timeout "$((30 * slow))" >/dev/null || fail "guest ignored shutdown"
i=0
until l4hctl list | grep -q "shut .* stopped"; do
    i=$((i + 1)); [ $i -lt 100 ] || fail "guest did not stop"; sleep 0.1
done
echo "CTLTEST: clean shutdown ok"
l4hctl destroy "$id"
# A read-only window of the disk.
id=$(l4hctl create window --initrd /bin/vm.cpio.gz --mem 128 \
    --disk 0,ro,start=8192,sectors=16384) || fail "create window"
l4hctl console "$id" --until "GUEST: vda size" --timeout "$((60 * slow))" > /tmp/out || fail "window vm"
sleep 1
l4hctl console "$id" > /tmp/out
grep -q "GUEST: vda size 16384 ro 1" /tmp/out || { cat /tmp/out; fail "disk window"; }
l4hctl destroy "$id" || fail "destroy window"
# Windows not aligned to 4 KiB are refused (an NVMe disk with 4 KiB blocks
# would round them down, outside the window).
for w in start=8193 start=8192,sectors=16383; do
    if l4hctl create badwin --initrd /bin/vm.cpio.gz --mem 128 \
        --disk 0,ro,$w 2>/tmp/err; then
        fail "unaligned window $w accepted"
    fi
    grep -q "invalid argument" /tmp/err || { cat /tmp/err; fail "unaligned window $w"; }
done
l4hctl list | grep -q badwin && fail "refused VM left behind"
echo "CTLTEST: unaligned windows refused"
# Destroying a guest with disk I/O in flight (disk 1 virtio-blk, disk 2
# NVMe; both hold a pattern and QEMU throttles their reads): the disk
# must be quiesced before the guest's memory is reused, and work again
# when attached to the next guest.
for d in 1 2 1 2; do
    id=$(l4hctl create dmaload --initrd /bin/vm.cpio.gz --mem 128 --disk $d \
        --cmdline "console=hvc0 l4htest=dmaload") || fail "create dmaload $d"
    l4hctl console "$id" --until "GUEST: dma busy" --timeout "$((60 * slow))" >/dev/null || fail "dmaload $d"
    l4hctl destroy "$id" || fail "destroy dmaload $d"
    id=$(l4hctl create dmacheck --initrd /bin/vm.cpio.gz --mem 128 \
        --cmdline "console=hvc0 l4htest=dmacheck") || fail "create dmacheck"
    # Console reads can split the count from its prefix. Wait for the
    # following marker so /tmp/out contains the entire result.
    l4hctl console "$id" --until "GUEST: dma check done" --timeout "$((90 * slow))" > /tmp/out || fail "dmacheck"
    grep -q "GUEST: stale bytes 0" /tmp/out || { cat /tmp/out; fail "disk $d DMA into reused memory"; }
    l4hctl destroy "$id" || fail "destroy dmacheck"
    echo "CTLTEST: disk $d destroyed under I/O, no stale DMA"
done
/bin/flags-test dom0 no-tpm || fail "flags without TPM"
l4hctl disks
if [ "$(uname -m)" = aarch64 ]; then
    # The host reset API is x86-only. Check its error on AArch64, then
    # stop dom0 so the runner can finish normally.
    if l4hctl host-reboot >/tmp/reboot-error 2>&1; then
        fail "host reboot unexpectedly succeeded"
    fi
    grep -q 'not supported' /tmp/reboot-error || { cat /tmp/reboot-error; fail "host reboot error"; }
    echo "CTLTEST: host reboot not supported"
    echo "CTLTEST: PASS"
    poweroff -f
fi
echo "CTLTEST: PASS"
# Last: the host reboot, which QEMU (-no-reboot) ends the run on.
sync
echo "CTLTEST: host reboot"
l4hctl host-reboot
echo "CTLTEST: FAIL: the host did not reset"
poweroff -f
