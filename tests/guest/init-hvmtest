#!/bin/sh
slow=${L4H_TEST_SLOW:-1}
# dom0 init for tests/run-hvmtest.sh and run-hvmtest-arm64.sh: HVM guests
# (DESIGN.md §5.11), an unmodified Linux, through l4hctl.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /tmp
fail() { echo "HVMTEST: FAIL: $*"; l4hctl list; poweroff -f; }
free() { l4hctl info --free-bytes; }
number() { case "$1" in ''|*[!0-9]*) fail "free memory: '$1'";; esac; }
# All of it back within 10 s: root frees a destroyed guest's channels and
# port memory only once blkd and netd have removed it (its Zombie), after
# `destroy` has returned.
reclaim() {
    i=0
    while now=$(free); number "$now"; [ "$now" != "$free0" ]; do
        i=$((i + 1)); [ $i -lt $((50 * slow)) ] || fail "memory leak: $free0 -> $now bytes"; sleep 0.2
    done
}
# console ID PATTERN SECS: the console until PATTERN, into /tmp/out.
console() { l4hctl console "$1" --until "$2" --timeout "$(($3 * slow))" > /tmp/out || { cat /tmp/out; fail "vm $1: no '$2'"; }; }
expect() { grep -q "$1" /tmp/out || { cat /tmp/out; fail "$2"; }; }
# The guest's kernel, and the console of the machine it gets.
if [ -e /bin/Image ]; then kernel=/bin/Image; con=ttyAMA0; else kernel=/bin/bzImage; con=ttyS0; fi
echo "HVMTEST: start"
l4hctl info
# Without the CPU's virtualization (VT-x, AMD-V, EL2), HVM guests are
# refused (-ENODEV) and the test has nothing more to check.
if ! l4hctl create probe --hvm --kernel "$kernel" --mem 256 --cmdline "console=$con HVM=probe" > /tmp/id 2>/tmp/err; then
    cat /tmp/err
    grep -q "unsupported device" /tmp/err && { echo "HVMTEST: no hardware virtualization"; poweroff -f; }
    fail "probe create"
fi
l4hctl destroy "$(cat /tmp/id)" || fail "destroy probe"
# What HVM guests do not have.
if l4hctl create nogpu --hvm --kernel "$kernel" --mem 256 --gpu 64x64 2>/tmp/err; then fail "HVM guest with a GPU"; fi
grep -q "not supported by this kind of VM" /tmp/err || { cat /tmp/err; fail "GPU refusal"; }
l4hctl list | grep -q nogpu && fail "refused VM left behind"

# A PV peer for the network, on a switch of its own.
sw=$(l4hctl switch-create) || fail "switch-create"
peer=$(l4hctl create peer --initrd /bin/netvm.cpio.gz --mem 96 --nic "$sw" \
    --cmdline "console=hvc0 IP0=192.168.9.1/24") || fail "create peer"
console "$peer" "NETVM: done" 120
# Guest slot 2 is the first past a 2 MiB boundary of vmmgr's GUEST_PAGES: its
# page table stays for good once made, so it is made before the baseline.
warm=$(l4hctl create warm --hvm --kernel "$kernel" --mem 256 --cmdline "console=$con HVM=probe") || fail "warm create"
l4hctl destroy "$warm" || fail "destroy warm"
free0=$(free)
number "$free0"
echo "HVMTEST: $free0 bytes free"
# A marker in the disk's first 4 KiB (disk-write takes whole 4 KiB blocks).
printf 'HVMMARK-l4h-disk' > /tmp/mark
dd if=/dev/zero bs=1 count=$((4096 - 16)) >> /tmp/mark 2>/dev/null
[ "$(wc -c < /tmp/mark)" -eq 4096 ] || fail "marker size"
l4hctl disk-write 0 0 /tmp/mark || fail "disk-write"

# 1: two vCPUs, disk, network, console, the power button.
id=$(l4hctl create hvm1 --hvm --kernel "$kernel" --initrd /bin/hvmvm.cpio.gz --mem 256 --vcpus 2 \
    --disk 0 --nic "$sw" --cmdline "console=$con DISK=write IP0=192.168.9.2/24 PING=192.168.9.1 BURN=3") \
    || fail "create hvm1"
echo "HVMTEST: created vm $id"
l4hctl list | grep -q "hvm1 .* hvm" || { l4hctl list; fail "list does not show hvm"; }
if l4hctl mem "$id" 512 2>/tmp/err; then fail "memory hotplug of an HVM guest"; fi
console "$id" "HVMVM: ready" 900
cat /tmp/out | grep -E "HVMVM|Linux version|smpboot|virtio|ACPI: (MADT|FADT|MCFG)|clocksource|x2apic|APIC" | head -60
expect "HVMVM: up, .* cpus 2" "two vCPUs"
expect "HVMVM: burned 3 s on 2 cpus" "SMP load"
expect "HVMVM: vda .* marker HVMMARK-l4h-disk" "disk marker"
expect "HVMVM: disk write ok" "disk write"
expect "HVMVM: ping 192.168.9.1 ok" "network"
l4hctl send "$id" "hello hvm" || fail "send"
console "$id" "HVMVM: got hello hvm" 60
echo "HVMTEST: console ok"
l4hctl shutdown "$id" || fail "shutdown request"
console "$id" "HVMVM: power button" 120
i=0
until l4hctl list | grep -q "hvm1 .* stopped"; do
    i=$((i + 1)); [ $i -lt 600 ] || fail "hvm1 did not stop"; sleep 0.1
done
echo "HVMTEST: power button shutdown ok"
l4hctl destroy "$id" || fail "destroy hvm1"
reclaim
echo "HVMTEST: hvm1 reclaimed"

# 2: the disk keeps what hvm1 wrote; destroyed while it runs.
id=$(l4hctl create hvm2 --hvm --kernel "$kernel" --initrd /bin/hvmvm.cpio.gz --mem 192 --vcpus 1 \
    --disk 0 --cmdline "console=$con DISK=check") || fail "create hvm2"
console "$id" "HVMVM: ready" 900
expect "HVMVM: disk check ok" "disk persistence"
l4hctl destroy "$id" || fail "destroy hvm2"
reclaim
echo "HVMTEST: hvm2 destroyed running and reclaimed"

# 3: attestation (DESIGN.md §10.2).  The guest, with nothing of ours in
# its kernel and under lockdown=confidentiality, reaches the host's flags
# through its attestation port; what it seals holds for dom0.  Reports
# themselves need a TPM, which this host has not: tests/run-attesttest.sh.
nonce=$(cat /proc/sys/kernel/random/uuid /proc/sys/kernel/random/uuid /proc/sys/kernel/random/uuid \
    /proc/sys/kernel/random/uuid | tr -d '\n-')
id=$(l4hctl create hvm3 --hvm --kernel "$kernel" --initrd /bin/hvmvm.cpio.gz --mem 192 --vcpus 2 \
    --cmdline "console=$con lockdown=confidentiality ATTEST=$nonce") || fail "create hvm3"
console "$id" "HVMVM: ready" 900
grep "HVMVM: \(lockdown\|attest\|no report\|report\)" /tmp/out | cut -c1-200
expect "HVMVM: lockdown .*\[confidentiality\]" "lockdown=confidentiality"
expect "HVMVM: attest providers none" "attestation providers without a TPM"
expect "HVMVM: attest kernel bit: l4hctl: not permitted" "a kernel flag bit refused to userspace"
expect "HVMVM: attest act taint=.*200 seal=" "a userspace flag bit in the host's flags"
expect "HVMVM: attest seal taint=.* seal=0(console-in)" "console input sealed"
expect "HVMVM: no report: .*no TPM" "a report without a TPM"
# The host enforces the guest's seal: no input from dom0 any more, and
# the seal shows in the list.
if l4hctl send "$id" "sealed" 2>/tmp/err; then fail "input to a sealed HVM guest"; fi
grep -q "sealed by the guest" /tmp/err || { cat /tmp/err; fail "why input to a sealed HVM guest was refused"; }
l4hctl list | grep "hvm3 " | grep -q "console-in" || { l4hctl list; fail "list does not show hvm3's seal"; }
l4hctl destroy "$id" || fail "destroy hvm3"
reclaim
echo "HVMTEST: hvm3 used its attestation port under lockdown and reclaimed"
l4hctl destroy "$peer"
echo "HVMTEST: PASS"
poweroff -f
