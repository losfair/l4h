#!/bin/bash
# Runs only in the disposable native-Linux installer test VM.
set -euo pipefail
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
work=/opt/l4h-install-test
exec > >(tee -a "$work/result.log" /dev/console) 2>&1
trap 'echo "INSTALLVM: FAIL at line $LINENO"; sync; systemctl poweroff' ERR
cd "$work"
if [[ $(uname -r) == *-l4h ]]; then
    echo "INSTALLVM: dom0 kernel $(uname -r)"
    [[ $(cat phase) == installed ]]
    sha256sum --check native-files.sha256
    [[ $(cat marker) == native-linux ]]
    test -c /dev/l4hctl
    test -b /dev/l4hkmod
    test -d "/lib/modules/$(uname -r)"
    [[ $(findmnt -n -o FSTYPE -T /lib/modules) == erofs ]]
    [[ $(findmnt -n -o OPTIONS -T /lib/modules) == *ro* ]]
    l4hctl version
    l4hctl info
    l4hctl nics | tee host-nics.txt
    ip -br address
    switch=0
    while read -r name mac bdf; do
        [[ $(cat "/sys/class/net/$name/address") == "$mac" ]]
        case "$mac" in
            52:54:00:12:34:56) subnet=10.0.2 ;;
            52:54:00:12:34:57) subnet=10.0.3 ;;
            *) false ;;
        esac
        ip -4 -o address show dev "$name" | grep -F "inet $subnet.15/24"
        ping -I "$name" -c 2 -W 10 "$subnet.2"
        grep -F "pci $bdf, mac $mac, uplink of switch $switch" host-nics.txt
        l4hctl switch "$switch" | tee "switch-$switch.txt"
        # Each switch must contain exactly one dom0 port, with this MAC.
        awk -v mac="$mac" 'NR > 2 { count++; if ($2 != 0 || $3 != mac) exit 1 }
                           END { if (count != 1) exit 1 }' "switch-$switch.txt"
        echo "INSTALLVM: switch $switch, uplink $bdf, dom0 $name ($mac), DHCP and gateway passed"
        switch=$((switch + 1))
    done < native-nics
    [[ $switch == "$(cat nic-count)" ]]
    getent hosts deb.debian.org
    if ! systemctl is-system-running --wait; then
        systemctl --failed --no-pager
        false
    fi
    echo l4h-dom0 > marker
    echo dom0 > phase
    echo 'INSTALLVM: existing userspace, modules, network and persistent root passed'
    sync
    l4hctl host-reboot
elif [[ ! -f phase ]]; then
    echo "INSTALLVM: native kernel $(uname -r)"
    echo native-linux > marker
    if [[ -e swap-names ]]; then
        # Establish a native configuration whose names are the reverse of
        # dom0's initial eth0/eth1 enumeration, before taking any snapshots.
        systemctl stop systemd-networkd
        for net in /sys/class/net/*; do
            case "$(cat "$net/address")" in
                52:54:00:12:34:56) index=0 ;;
                52:54:00:12:34:57) index=1 ;;
                *) continue ;;
            esac
            ip link set "${net##*/}" down
            ip link set "${net##*/}" name "test-nic$index"
        done
        mkdir -p /etc/systemd/network
        for index in 0 1; do
            ip link set "test-nic$index" name "eth$((1 - index))"
            printf '[Match]\nMACAddress=52:54:00:12:34:%02x\n[Link]\nNamePolicy=\nName=eth%d\n' \
                "$((0x56 + index))" "$((1 - index))" > "/etc/systemd/network/10-test-$index.link"
        done
        printf '[Match]\nName=eth*\n[Network]\nDHCP=yes\n' > /etc/systemd/network/10-test.network
        systemctl start systemd-networkd
        for name in eth0 eth1; do
            for ((attempt=0; attempt<60; attempt++)); do
                if ip -4 -o address show dev "$name" | grep -q 'scope global'; then break; fi
                sleep 1
            done
            [[ $attempt -lt 60 ]]
        done
        echo 'INSTALLVM: native eth0/eth1 swap fixture configured'
    fi
    # Remember the native EFI payloads and distribution configuration.
    find /boot/efi/EFI -type f -print0 | sort -z | xargs -0 sha256sum > native-files.sha256
    sha256sum /etc/fstab /boot/grub/grub.cfg >> native-files.sha256
    for directory in /etc/systemd/network /etc/NetworkManager /etc/network; do
        if [[ -d $directory ]]; then
            find "$directory" -type f -exec sha256sum '{}' + >> native-files.sha256
        fi
    done
    : > native-nics.unsorted
    for net in /sys/class/net/*; do
        if [[ -e $net/device ]]; then
            bdf=$(basename "$(readlink -f "$net/device/..")")
            printf '%s %s %s\n' "${net##*/}" "$(cat "$net/address")" "${bdf#0000:}" >> native-nics.unsorted
        fi
    done
    sort -k3 native-nics.unsorted > native-nics
    [[ $(wc -l < native-nics) == "$(cat nic-count)" ]]
    # Local release fixtures exercise the unchanged bootstrap, checksum and
    # extraction paths before these artifacts have been published on GitHub.
    # /usr/sbin precedes /usr/bin; package installation cannot replace this shim.
    install -m 755 curl-fixture /usr/sbin/curl
    # Dependency bootstrap may run, but a corrupt release must never change
    # the ESP, firmware or GRUB. Also exercise the download cleanup on failure.
    if [[ -d /sys/firmware/efi ]]; then
        sha256sum /sys/firmware/efi/efivars/BootOrder-* > native-order.sha256
    else
        sha256sum /boot/grub/grubenv > native-order.sha256
    fi
    cp release/SHA256SUMS release/SHA256SUMS.good
    sed -i 's/^[0-9a-f]/x/' release/SHA256SUMS
    # shellcheck disable=SC2002
    if cat install.sh | bash -s -- --release v0-install-test; then
        echo 'INSTALLVM: invalid checksum was accepted'
        false
    fi
    sha256sum --check native-order.sha256
    sha256sum --check native-files.sha256
    [[ ! -e /boot/grub/custom.cfg && ! -e /boot/l4h ]]
    mv release/SHA256SUMS.good release/SHA256SUMS
    echo 'INSTALLVM: corrupt release rejected before boot changes'
    # Exercise curl | bash's unprivileged entry point and sudo re-execution.
    command -v sudo >/dev/null || apt-get install -y sudo
    useradd --no-create-home --shell /bin/bash l4h-install-test
    echo 'l4h-install-test ALL=(root) NOPASSWD: ALL' > /etc/sudoers.d/l4h-install-test
    chmod 440 /etc/sudoers.d/l4h-install-test
    sudo -u l4h-install-test bash -c 'cat install.sh | bash -s -- --release v0-install-test --memory 2048 --vcpus 2'
    # shellcheck disable=SC2002
    cat install.sh | bash -s -- --check --release v0-install-test --memory 2048 --vcpus 2
    sha256sum --check native-files.sha256
    if [[ ! -d /sys/firmware/efi ]]; then
        # BIOS: an L4H entry in custom.cfg, selected once through next_entry.
        grub-editenv /boot/grub/grubenv list | tee installed-boot.txt
        grep -qx 'next_entry=l4h' installed-boot.txt
        grep -q "^menuentry 'L4H' --id l4h" /boot/grub/custom.cfg
        test -s /boot/l4h/bios/kernel.elf
        test -s /boot/l4h/dom0/initrd
        echo installed > phase
        echo 'INSTALLVM: installed; rebooting through GRUB next_entry'
        sync
        systemctl reboot
        exit
    fi
    efibootmgr --verbose | tee installed-boot.txt
    python3 - <<'PY'
import json
from pathlib import Path
import re
state = json.loads(Path('/var/lib/l4h/install.json').read_text())
saved = json.loads(next(Path('/var/lib/l4h/backups').glob('*/boot.json')).read_text())
boot = Path('installed-boot.txt').read_text()
assert re.search(r'^BootOrder: (.+)$', boot, re.M)[1] == saved['order']
assert re.search(r'^BootNext: (.+)$', boot, re.M)[1] == state['entry']
Path('native-boot-order').write_text(saved['order'])
PY
    echo installed > phase
    echo 'INSTALLVM: installed; rebooting through BootNext'
    sync
    systemctl reboot
else
    echo "INSTALLVM: returned to native kernel $(uname -r)"
    [[ $(cat phase) == dom0 && $(cat marker) == l4h-dom0 ]]
    if [[ -d /sys/firmware/efi ]]; then
        efibootmgr | tee returned-boot.txt
        if grep -q '^BootNext:' returned-boot.txt; then false; fi
        [[ $(sed -n 's/^BootOrder: //p' returned-boot.txt) == "$(cat native-boot-order)" ]]
    else
        # GRUB consumed next_entry (saving it empty) before it booted L4H.
        grub-editenv /boot/grub/grubenv list | tee returned-boot.txt
        if grep -q '^next_entry=.' returned-boot.txt; then false; fi
    fi
    sha256sum --check native-files.sha256
    echo 'INSTALLVM: PASS (native -> L4H dom0 -> native)'
    sync
    systemctl poweroff
fi
