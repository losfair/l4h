#!/bin/sh
# dom0 init for tests/run-kexec-uefitest.sh.
fail() {
    echo "KEXECUEFI: FAIL $*"
    poweroff -f
    exit 1
}
network() {
    ip link set lo up
    ip link set eth0 up
    udhcpc -i eth0 -n -q -t 5 -s /bin/udhcpc.script >/dev/null 2>&1 || fail "DHCP"
    ping -c 2 -W 2 10.0.2.2 >/dev/null || fail "network"
    echo "KEXECUEFI: network ok"
}
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /boot/efi
mount -t vfat /dev/vda1 /boot/efi || fail "mount ESP"
case "$(cat /proc/cmdline)" in
    *kexec_done*)
        l4hctl version | grep -q kexec-test-2 || fail "new host_version"
        grep -q handoff-v1 /boot/efi/l4h/handoff.dat || fail "disk readback"
        network
        echo "KEXECUEFI: done"
        poweroff -f
        exit 0
        ;;
esac
echo "KEXECUEFI: first boot"
echo handoff-v1 > /boot/efi/l4h/handoff.dat || fail "disk write"
sync
network
l4hctl host-kexec --efi /boot/efi/l4h/next.efi \
    --initrd /boot/efi/l4h/dom0/initrd --conf /boot/efi/l4h/next.conf || fail "kexec command"
fail "EXEC returned"
