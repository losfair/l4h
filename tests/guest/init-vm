#!/bin/sh
# Init of guests created by tests/guest/init-ctltest: report, use the disk
# if there is one, answer one line of console input, power off.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
# busybox poweroff/reboot signal init (l4hctl shutdown).
trap 'echo "GUEST: shutting down"; poweroff -f' USR2 TERM
echo "GUEST: ready, $(nproc) cpus"
# Roles for the destroy-under-I/O test in init-ctltest.
case " $(cat /proc/cmdline) " in
*" l4htest=dmaload "*)
    # Keep the disk (a pattern, throttled by QEMU) busy with direct reads
    # into this guest's memory until the guest is destroyed.
    for i in $(seq 0 15); do
        dd if=/dev/vda of=/dev/null bs=1M iflag=direct skip=$((i * 2)) 2>/dev/null &
    done
    sleep 2
    echo "GUEST: dma busy"
    while :; do sleep 10; done ;;
*" l4htest=dmacheck "*)
    # Fill most of RAM with zeros and watch for disk data appearing in it:
    # DMA of the destroyed dmaload guest landing in reused memory.  All
    # that is available but 20 MiB, which the kernel's size does not
    # change; less than 32 MiB checks too little, and fails.
    fill=$(($(sed -n 's/^MemAvailable: *\([0-9]*\) kB/\1/p' /proc/meminfo) / 1024 - 20))
    echo "GUEST: dma check fill $fill MiB"
    mkdir -p /tmp/z && mount -t tmpfs -o size="$((fill > 32 ? fill : 32))m" tmp /tmp/z
    if [ "$fill" -lt 32 ] || ! dd if=/dev/zero of=/tmp/z/fill bs=1M count="$fill" 2>/dev/null; then
        echo "GUEST: stale bytes unchecked"
        echo "GUEST: dma check done"
        while :; do sleep 10; done
    fi
    echo "GUEST: dma check start"
    for i in $(seq 1 10); do
        sleep 2
        n=$(tr -d '\000' < /tmp/z/fill | wc -c)
        [ "$n" = 0 ] || break
    done
    echo "GUEST: stale bytes $n"
    echo "GUEST: dma check done"
    while :; do sleep 10; done ;;
esac
if [ -b /dev/vda ]; then
    echo "GUEST: vda size $(cat /sys/block/vda/size) ro $(cat /sys/block/vda/ro) cache $(cat /sys/block/vda/queue/write_cache)"
    mount -t ext4 /dev/vda /mnt || echo "GUEST: mount failed"
    n=$(cat /mnt/count 2>/dev/null || echo 0)
    echo "GUEST: disk count $n"
    echo $((n + 1)) > /mnt/count
    sync
    umount /mnt && echo "GUEST: disk ok"
fi
read line
echo "GUEST: got $line"
poweroff -f
