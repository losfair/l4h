# The HVM guest kernel of tests/run-hvmtest.sh: x86_64_defconfig and
# kvm_guest.config, then this.  Vanilla Linux: what a distribution kernel
# would have for a PC with virtio-pci disks and NICs.
CONFIG_SMP=y
CONFIG_X86_X2APIC=y
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=n
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_INPUT_EVDEV=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
# The attestation port (DESIGN.md §5.11) is a virtio-console port, which
# the guest's userspace uses under lockdown=confidentiality: both as a
# distribution kernel has them.
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# Not needed here: faster to build.
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_MODULES=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_BTF=n
