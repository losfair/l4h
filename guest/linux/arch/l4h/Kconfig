# ARCH=l4h: Linux as a paravirtualised guest of the l4h hypervisor (seL4).
# Derived from ARCH=um; the guest kernel runs as an seL4 user-level program
# and guest processes run in their own seL4 address spaces.
#
# We keep CONFIG_UML defined: generic code uses it to mean "not running on
# bare hardware" (no x86 FPU kernel APIs, no hardware AVX paths, etc.),
# which is equally true for l4h.

menu "l4h guest options"

config UML
	bool
	default y
	select ARCH_WANTS_DYNAMIC_TASK_STRUCT
	select ARCH_HAS_CACHE_LINE_SIZE
	select ARCH_HAS_CPU_FINALIZE_INIT
	select ARCH_HAS_STRNCPY_FROM_USER
	select ARCH_HAS_STRNLEN_USER
	select HAVE_ARCH_AUDITSYSCALL
	select HAVE_ARCH_SECCOMP_FILTER
	select HAVE_UID16
	select HAVE_DEBUG_KMEMLEAK
	select HAVE_DEBUG_BUGVERBOSE
	select HAVE_PAGE_SIZE_4KB
	# Device I/O goes through the host's I/O pool: dma-direct (device
	# addresses are guest-physical) with a restricted swiotlb pool.
	select SWIOTLB
	select DMA_RESTRICTED_POOL
	select GENERIC_IRQ_SHOW
	select GENERIC_CPU_DEVICES
	select TRACE_IRQFLAGS_SUPPORT
	select HAVE_ARCH_TRACEHOOK
	select HAVE_SYSCALL_TRACEPOINTS
	select THREAD_INFO_IN_TASK
	select HAVE_EXIT_THREAD
	select GENERIC_SCHED_CLOCK
	select SPARSE_IRQ
	select IRQ_DOMAIN
	select GENERIC_IRQ_IPI if SMP
	select GENERIC_SMP_IDLE_THREAD
	select ARCH_USE_QUEUED_SPINLOCKS
	select ARCH_USE_QUEUED_RWLOCKS
	# mmap below the stack, at a random offset, as on x86_64 and arm64.
	# Android's init stops unless it can set vm.mmap_rnd_bits to 32.
	select ARCH_WANT_DEFAULT_TOPDOWN_MMAP_LAYOUT
	select HAVE_ARCH_MMAP_RND_BITS
	# Software perf events, without a PMU: what BPF programs on
	# tracepoints are attached through (Android's bpfloader).
	select HAVE_PERF_EVENTS

config L4H
	def_bool y
	# Huge Linux PMDs are mirrored into ordinary 4 KiB seL4 mappings.
	select HAVE_ARCH_TRANSPARENT_HUGEPAGE
	# Object memory grows by isolating and migrating whole RAM blocks.
	select COMPACTION
	select MEMORY_ISOLATION
	# Memory hotplug in 128 MiB blocks, each with its memmap in its
	# first 2 MiB (DESIGN.md §17).
	select ARCH_ENABLE_MEMORY_HOTPLUG
	select ARCH_ENABLE_MEMORY_HOTREMOVE
	select ARCH_MHP_MEMMAP_ON_MEMORY_ENABLE

# Sparse memory with a virtually mapped memmap: hotplug needs SPARSEMEM,
# and a memmap in hotplugged memory needs the vmemmap.  128 MiB sections
# are the hotplug blocks.
config ARCH_SPARSEMEM_ENABLE
	def_bool y
	select SPARSEMEM_VMEMMAP_ENABLE

# The largest buddy order, and the pageblock, is a RAM block (2 MiB): a
# hotplug block's memmap (2 MiB) must be whole pageblocks to go in the
# block itself, and object blocks are order-9 pages (§15.3).
config ARCH_FORCE_MAX_ORDER
	int
	default 9

config MMU
	bool
	default y

# User space spans 47 bits on both ISAs (L4H_TASK_SIZE): x86_64's range.
config ARCH_MMAP_RND_BITS_MIN
	default 28

config ARCH_MMAP_RND_BITS_MAX
	default 32

# There is no device memory in a guest, only pages it shares with the
# host: ioremap() returns NULL (asm/io.h), as on UML.  Without NO_IOMEM,
# what needs none can be built, DRM and vkms among them.
config NO_IOMEM
	def_bool n

config ISA
	bool

config SBUS
	bool

config LOCKDEP_SUPPORT
	bool
	default y

config STACKTRACE_SUPPORT
	bool
	default y
	select STACKTRACE

config GENERIC_CALIBRATE_DELAY
	bool
	default y

config SMP
	bool "Symmetric multi-processing support"
	default y
	help
	  Support guests with more than one vCPU.

config NR_CPUS
	int "Maximum number of vCPUs" if SMP
	range 2 64 if SMP
	range 1 1 if !SMP
	default 64 if SMP
	default 1

source "kernel/Kconfig.hz"

source "arch/l4h/x86/Kconfig"
source "arch/l4h/arm64/Kconfig"

config KERNEL_STACK_ORDER
	int "Kernel stack size order"
	default 2
	range 2 10
	help
	  Kernel stacks are 1 << order pages.

config PGTABLE_LEVELS
	int
	default 4

config L4H_HVC_CONSOLE
	bool "l4h hypercall console (hvc0)"
	default y
	select HVC_DRIVER
	select TTY
	help
	  Console on the l4h hypercall channel. Say Y.

config L4H_VIRTIO
	bool "virtio-l4h transport"
	default y
	select VIRTIO
	help
	  Paravirtual transport for virtio devices provided by l4h-vmm.
	  Devices are confined to the host's I/O pool (restricted DMA) and
	  require VIRTIO_F_ACCESS_PLATFORM.

config L4H_CTL
	bool "l4h control channel (dom0)"
	default y
	depends on L4H_VIRTIO
	help
	  Expose the l4h host control API to dom0 userspace as /dev/l4hctl.

config L4H_ATTEST
	bool "Attestation by the l4h host"
	default y
	select TSM_REPORTS if VIRT_DRIVERS
	help
	  Reports about this guest signed by a host key that the host's TPM
	  attests, as configfs-tsm reports (with VIRT_DRIVERS) and through
	  /dev/l4h-attest.  Hosts without a TPM offer none.

config L4H_KMOD
	bool "The kernel's module tree from the l4h host"
	default y
	depends on BLOCK
	help
	  The read-only block device /dev/l4hkmod: an EROFS image of this
	  kernel's /lib/modules, with its modules and the tree to build
	  external modules against, which the host shares with every guest.

config L4H_MEMHP
	bool "Memory hotplug from the l4h host"
	default y
	depends on MEMORY_HOTREMOVE && MHP_MEMMAP_ON_MEMORY
	help
	  Plug and unplug 128 MiB of RAM at a time as the host's target for
	  this guest changes (l4hctl mem in dom0).

config L4H_RTC
	bool "l4h real-time clock"
	default y
	depends on RTC_CLASS
	help
	  /dev/rtc0, on the host's wall clock, with alarms, which the alarm
	  clocks (CLOCK_REALTIME_ALARM, CLOCK_BOOTTIME_ALARM) need beyond
	  timerfd.  Setting it lasts until the guest stops and changes no
	  other guest.

config L4H_RNG
	bool "l4h hardware random number generator"
	default y
	depends on HW_RANDOM=y
	help
	  /dev/hw_random on the CPU's random number generator (RDRAND on
	  x86_64), which Android's prng_seeder needs.

endmenu

config ARCH_SUSPEND_POSSIBLE
	def_bool n

config PARAVIRT
	def_bool y
	help
	  Steal time reported by the l4h host.

config PARAVIRT_TIME_ACCOUNTING
	bool "Paravirtual steal time accounting"
	default y
	select PARAVIRT
