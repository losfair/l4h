CONFIG_NFT_REDIR=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_ADVANCED_ROUTER=y
# Encrypted disks: dm-crypt, using AES-NI on x86_64 (arch/l4h/x86/fpu.c) and
# the ARMv8 Crypto Extensions, or bit-sliced NEON without them, on aarch64
# (arch/l4h/arm64/neon.c).
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_ZERO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_AES_ARM64_BS=y
# Verified read-only disks.
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
# Attestation reports from the host (arch/l4h/drivers/attest.c) at
# /sys/kernel/config/tsm/report.
CONFIG_VIRT_DRIVERS=y
CONFIG_CONFIGFS_FS=y
# CONFIG_VMGENID is not set
# What dom0 and the guests of l4h-sandbox need besides the above, so that
# the shipped kernel (tools/build-dom0.sh) serves both.
# Root filesystems: an EROFS system image under an overlay whose upper
# layer is ext4 on dm-crypt; dom0's image cache on XFS.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
# The module tree the host gives every guest (/dev/l4hkmod).
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
# Configuration partitions and cloud-init seed disks (e.g. NoCloud cidata).
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# A router VM's firewall, and tagged VLANs on its uplinks.
CONFIG_NFT_LIMIT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_VLAN_8021Q=y
# Docker: Debian's iptables is iptables-nft, which runs xt matches and
# targets through nft_compat, so the legacy x_tables tables stay off.
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_BRIDGE_NETFILTER=y
# K3s ServiceLB/hostPorts, ipset-backed policy and IPVS service proxying.
# Keep these built in so networking does not depend on loading modules.
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_IP_SET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_VS=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
# runc's session keyrings; `docker run --cpus`.
CONFIG_KEYS=y
CONFIG_CFS_BANDWIDTH=y
# NFS client: v3 with NLM locking, and v4.0-v4.2.
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
# Android guests (DESIGN.md §5.8).  What only Android uses is off until an
# Android guest asks for it on its command line, so other guests run as
# before: SELinux with lsm=selinux, PSI with psi=1, bootconfig with
# bootconfig; Binder devices exist only in a mounted binderfs, which has
# Android's three (init.rc links them to /dev).
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# libcutils' shared memory (patch 0010).
CONFIG_STAGING=y
CONFIG_ASHMEM=y
# BPF programs on tracepoints (patch 0011), which Android's bpfloader loads
# and system_server reads the maps of: software perf events and event
# tracing, with the GPU memory tracepoints.
CONFIG_PERF_EVENTS=y
# The host's PMU is not the guest's (asm/perf_event.h).
# CONFIG_ARM_PMU is not set
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_TRACE_GPU_MEM=y
# AF_VSOCK, with no transport to a host but loopback: Cuttlefish's HALs
# listen on vsock ports for their host, and stop if they cannot.
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_LOOPBACK=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_DAC=y
CONFIG_AUDIT=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=y
CONFIG_BOOT_CONFIG=y
# ART's default garbage collector; and zram swap for lmkd.
CONFIG_USERFAULTFD=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
# /dev/hw_random (arch/l4h/drivers/rng_l4h.c), for prng_seeder.
CONFIG_HW_RANDOM=y
# /dev/rtc0 with alarms (arch/l4h/drivers/rtc_l4h.c), for the alarm clocks.
# The system clock comes from the host at boot, to the nanosecond, so the
# RTC does not set it, and NTP does not write the RTC.
CONFIG_RTC_CLASS=y
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set
# Graphics buffers and fences, for gralloc and the compositor; evdev and
# uinput.  The display is vkms, which composes in software and has no
# output but its writeback connector.  It is a module: loaded, it adds a
# display to the guest.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SYNC_FILE=y
CONFIG_DRM=m
CONFIG_DRM_VKMS=m
# The host's display (l4h-vmm's virtio-gpu, DESIGN.md §8.6).
CONFIG_DRM_VIRTIO_GPU=m
# CONFIG_USB_SUPPORT is not set
# CONFIG_HWMON is not set
CONFIG_INPUT_EVDEV=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
# CONFIG_SERIO is not set
# CONFIG_HID_SUPPORT is not set
# Android's partitions: dynamic partitions (dm-linear), APEXes (loop and
# dm-verity), verity with error correction, file-based encryption,
# fs-verity, and quotas for storage accounting.  Android's init waits for
# the uevents of the dm devices it makes.
CONFIG_DM_UEVENT=y
CONFIG_DM_VERITY_FEC=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y
CONFIG_QFMT_V2=y
# Case-insensitive directories, which Android uses on /data.
CONFIG_UNICODE=y
# netd: policy routing, socket destruction, IPsec, and legacy iptables,
# which Android's iptables uses (Docker's iptables-nft does not).
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_STATISTICS=y
CONFIG_NET_KEY=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
