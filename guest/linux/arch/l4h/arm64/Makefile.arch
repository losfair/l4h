# SPDX-License-Identifier: GPL-2.0
ARCH_DIR := arch/l4h
HEADER_ARCH := arm64
KBUILD_DEFCONFIG := defconfig
SHELL := bash
SHARED_HEADERS := $(ARCH_DIR)/include/shared
ARCH_INCLUDE := -I$(srctree)/$(SHARED_HEADERS) -I$(srctree)/$(SHARED_HEADERS)/skas
ARCH_INCLUDE += -I$(srctree)/$(ARCH_DIR)/arm64/shared -I$(L4H_ABI_INCLUDE)
KBUILD_CPPFLAGS += -I$(srctree)/$(ARCH_DIR)/arm64
KBUILD_CPPFLAGS += -I$(srctree)/arch/arm64/include/uapi -I$(objtree)/arch/arm64/include/generated/uapi -I$(objtree)/arch/arm64/include/generated
# Kernel-mode NEON in C (lib/raid6), as arch/arm64/Makefile: such objects
# drop -mgeneral-regs-only and get <arm_neon.h> (asm/neon.h).
CC_FLAGS_FPU := -ffreestanding -isystem $(shell $(CC) -print-file-name=include)
CC_FLAGS_NO_FPU := -mgeneral-regs-only
KBUILD_CFLAGS += -mcmodel=large -fno-pic -fno-pie $(CC_FLAGS_NO_FPU) -mno-outline-atomics \
	-fno-builtin -D__arch_um__ -D__arch_l4h__ $(ARCH_INCLUDE) \
	-Dlongjmp=kernel_longjmp -Dsetjmp=kernel_setjmp
KBUILD_AFLAGS += $(ARCH_INCLUDE)
SEL4_CFLAGS := -O2 -g -std=gnu11 -ffreestanding -fno-common -fno-strict-aliasing \
	-fno-stack-protector -fno-pic -fno-pie -mcmodel=large -mgeneral-regs-only \
	-mno-outline-atomics -fno-asynchronous-unwind-tables -fno-delete-null-pointer-checks \
	-Wall -Wno-unused-function -nostdinc -isystem $(shell $(CC) -print-file-name=include) \
	-I$(L4H_SEL4_INCLUDE) -I$(L4H_ABI_INCLUDE) -I$(srctree)/$(SHARED_HEADERS) \
	-I$(srctree)/$(ARCH_DIR)/arm64/shared -I$(objtree)/include -D__L4H_OS__
core-y += $(ARCH_DIR)/arm64/
# NEON crypto (ARMv8 Crypto Extensions AES, ...), selected per algorithm.
core-$(CONFIG_CRYPTO) += arch/arm64/crypto/
# The arm64 BPF JIT, with arm64/bpf_jit.c.
core-$(CONFIG_BPF_JIT) += arch/arm64/net/
all: vmlinux
archheaders:
	$(Q)$(MAKE) -f $(srctree)/Makefile ARCH=arm64 asm-generic archheaders
archprepare:
	$(Q)$(MAKE) $(build)=$(ARCH_DIR)/arm64 include/generated/user_constants.h
export LDS_START := 0x60000000
export LDS_ELF_ARCH := aarch64
export LDS_ELF_FORMAT := elf64-littleaarch64
LDFLAGS_vmlinux := -z noexecstack -z max-page-size=4096 --no-warn-rwx-segments
