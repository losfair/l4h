+#ifdef CONFIG_L4H
+/*
+ * After FL4 ran the guest with the virtual timer in the CPU (and on its
+ * VPPI exits): the level of the timer's interrupt into the vgic, which
+ * maps no physical interrupt here (kvm_timer_enable()).
+ */
+void l4h_kvm_timer_sync(struct kvm_vcpu *vcpu, bool *level)
+{
+	struct arch_timer_context *vtimer = vcpu_vtimer(vcpu);
+
+	*level = kvm_timer_should_fire(vtimer);
+	if (vcpu_timer(vcpu)->enabled)
+		kvm_timer_update_irq(vcpu, *level, vtimer);
+}
+#endif
