rust: regenerate bindings when the kernel configuration changes

Bindgen exports the CONFIG_* constants from autoconf.h, but fixdep drops
that header and records only the configuration symbols referenced in its
C inputs. Switching drivers from modules to built-ins can therefore leave
old constants in bindings_generated.rs. Besides exposing stale values,
removing a constant shifts the generated Rust source lines and changes
kernel.o's debug information between incremental and clean builds.

Depend on the full configuration header for the binding generators.

--- a/rust/Makefile
+++ b/rust/Makefile
@@ -373,13 +373,13 @@
     sed -Ei 's/^pub struct hrtimer_restart\(/#[cfi_encoding="15hrtimer_restart"]\n&/' $@; \
     sed -Ei 's/^pub struct irqreturn\(/#[cfi_encoding="9irqreturn"]\n&/' $@
 $(obj)/bindings/bindings_generated.rs: $(src)/bindings/bindings_helper.h \
-    $(src)/bindgen_parameters FORCE
+    $(src)/bindgen_parameters include/generated/autoconf.h FORCE
 	$(call if_changed_dep,bindgen)
 
 $(obj)/uapi/uapi_generated.rs: private bindgen_target_flags = \
     $(shell grep -Ev '^#|^$$' $(src)/bindgen_parameters)
 $(obj)/uapi/uapi_generated.rs: $(src)/uapi/uapi_helper.h \
-    $(src)/bindgen_parameters FORCE
+    $(src)/bindgen_parameters include/generated/autoconf.h FORCE
 	$(call if_changed_dep,bindgen)
 
 # See `CFLAGS_REMOVE_helpers.o` above. In addition, Clang on C does not warn
@@ -394,7 +394,7 @@
     -I$(objtree)/$(obj) -Wno-missing-prototypes -Wno-missing-declarations
 $(obj)/bindings/bindings_helpers_generated.rs: private bindgen_target_extra = ; \
     sed -Ei 's/pub fn rust_helper_([a-zA-Z0-9_]*)/#[link_name="rust_helper_\1"]\n    pub fn \1/g' $@
-$(obj)/bindings/bindings_helpers_generated.rs: $(src)/helpers/helpers.c FORCE
+$(obj)/bindings/bindings_helpers_generated.rs: $(src)/helpers/helpers.c include/generated/autoconf.h FORCE
 	$(call if_changed_dep,bindgen)
 
 rust_exports = $(NM) -p --defined-only $(1) | awk '$$2~/(T|R|D|B)/ && $$3!~/__(pfx|cfi|odr_asan)/ { printf $(2),$$3 }'
