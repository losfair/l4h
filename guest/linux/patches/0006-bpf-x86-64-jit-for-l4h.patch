         obj-$(CONFIG_BPF_JIT) += bpf_jit_comp32.o
 else
-        obj-$(CONFIG_BPF_JIT) += bpf_jit_comp.o bpf_timed_may_goto.o
+        obj-$(CONFIG_BPF_JIT) += bpf_jit_comp.o
+ifndef CONFIG_L4H
+        obj-$(CONFIG_BPF_JIT) += bpf_timed_may_goto.o
+endif
 endif
